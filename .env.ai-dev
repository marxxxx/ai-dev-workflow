# Copy to .env.ai-dev (gitignored) and adjust; used via
#   docker compose --env-file .env.ai-dev -f compose.ai-dev.yml ...
# Absolute path of this repository on the host.
PROJECT_ROOT=D:\src\strobl.dev\ai-dev-workflow
# Local build, or published: marxx/ai-dev-workflow:node-latest
AGENT_IMAGE=marxx/ai-dev-workflow:latest
# Linux/macOS hosts only: output of `id -u` / `id -g`. Docker Desktop on Windows needs no change.
HOST_UID=1000
HOST_GID=1000
# Optional Context7 account key; leave empty for unauthenticated service limits.
CONTEXT7_API_KEY=
