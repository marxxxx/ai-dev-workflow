{
  "name": "@strobl_dev/adw",
  "version": "0.29.0",
  "description": "Single-source agent & skill definitions for Claude Code, Codex, and OpenCode, generated per project from a small config. Language-agnostic: usable in any repo (incl. C#/.NET) via npx; only requires Node to run the generator.",
  "type": "module",
  "bin": {
    "adw": "agent-src/generate.mjs",
    "ai-dev-workflow": "agent-src/generate.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "agent-src/skills",
    "agent-src/includes",
    "agent-src/container",
    "agent-src/generate.mjs",
    "agent-src/lib/constants.mjs",
    "agent-src/lib/serialize.mjs",
    "agent-src/lib/identity.mjs",
    "agent-src/lib/config.mjs",
    "agent-src/lib/tokens.mjs",
    "agent-src/lib/units.mjs",
    "agent-src/lib/ticketing.mjs",
    "agent-src/lib/renderers.mjs",
    "agent-src/lib/onboard.mjs",
    "agent-src/lib/cost.mjs",
    "agent-src/lib/pipeline.mjs",
    "agent-src/lib/upgrade.mjs",
    "agent-src/lib/container.mjs",
    "agent-src/lib/skills.mjs",
    "agent-src/config/ai-workflow.json",
    "agent-src/config/ai-project.template.json",
    "e2e/local/cli.mjs",
    "e2e/local/config.mjs",
    "e2e/local/store.mjs",
    "e2e/local/ticket-import.mjs",
    "e2e/local/sandbox.mjs",
    "e2e/local/contract.mjs",
    "e2e/local/session.mjs",
    "e2e/local/answerer.mjs",
    "e2e/local/acceptance.mjs",
    "e2e/local/record.mjs",
    "e2e/local/defaults.json",
    "e2e/lib/llm.mjs",
    "e2e/lib/claude.mjs",
    "e2e/lib/verifier.mjs",
    "e2e/lib/review.mjs",
    "e2e/lib/postverify.mjs",
    "e2e/lib/bundle.mjs",
    "e2e/lib/metrics.mjs",
    "e2e/lib/ccusage.mjs",
    "e2e/lib/compare.mjs",
    "e2e/lib/fingerprint.mjs",
    "e2e/lib/config.mjs",
    "e2e/lib/tasks.mjs",
    "e2e/lib/fsutil.mjs",
    "e2e/lib/secrets.mjs",
    "e2e/lib/summary.mjs",
    "e2e/lib/report.mjs",
    "e2e/lib/criteria.mjs",
    "e2e/lib/trial.mjs",
    "agent-src/config/skills.json",
    "agent-src/README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test agent-src/*.test.mjs agent-src/lib/*.test.mjs e2e/lib/*.test.mjs e2e/local/*.test.mjs e2e/tasks/_shared/tests/checks.test.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "claude-code",
    "codex",
    "opencode",
    "agents",
    "skills",
    "ai-workflow"
  ],
  "license": "Apache-2.0",
  "author": "Markus Strobl <markus@strobl.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marxxxx/ai-dev-workflow.git"
  },
  "homepage": "https://github.com/marxxxx/ai-dev-workflow#readme",
  "bugs": {
