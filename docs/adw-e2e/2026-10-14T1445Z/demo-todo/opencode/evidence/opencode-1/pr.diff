@@ -0,0 +1,37 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createStore, ValidationError } from '../src/store.mjs';
+
+test('add stores a valid dueDate', () => {
+  const store = createStore();
+  const todo = store.add({ title: 'A', dueDate: '2026-10-20' });
+  assert.equal(todo.dueDate, '2026-10-20');
+});
+
+test('add without dueDate defaults to null', () => {
+  const store = createStore();
+  const todo = store.add({ title: 'A' });
+  assert.equal(todo.dueDate, null);
+});
+
+test('add rejects invalid dueDate values', () => {
+  const store = createStore();
+  for (const dueDate of ['2026-02-30', '20.10.2026', '2026-10-20T10:00:00Z', '', 42, '2026-13-01', '2026-1-5']) {
+    assert.throws(() => store.add({ title: 'A', dueDate }), ValidationError, `dueDate=${JSON.stringify(dueDate)}`);
+  }
+});
+
+test('update sets and clears dueDate', () => {
+  const store = createStore();
+  store.add({ title: 'A' });
+  const updated = store.update(1, { dueDate: '2026-10-20' });
+  assert.equal(updated.dueDate, '2026-10-20');
+  const cleared = store.update(1, { dueDate: null });
+  assert.equal(cleared.dueDate, null);
+});
+
+test('update rejects invalid dueDate', () => {
+  const store = createStore();
+  store.add({ title: 'A' });
+  assert.throws(() => store.update(1, { dueDate: 'gestern' }), ValidationError);
+});
