 <body>
   <h1>Todos</h1>
+  <label><input type="checkbox" data-testid="overdue-filter"> nur überfällige</label>
   <ul data-testid="todo-list"></ul>
   <script type="module">
     const list = document.querySelector('[data-testid="todo-list"]');
+    const filter = document.querySelector('[data-testid="overdue-filter"]');
+    const todayUtc = new Date().toISOString().slice(0, 10);
+    const isOverdue = (todo) => !todo.done && todo.dueDate !== null && todo.dueDate < todayUtc;
+    const formatDue = (dueDate) => {
+      const [y, m, d] = dueDate.split('-');
+      return `${d}.${m}.${y}`;
+    };
     const todos = await (await fetch('/todos')).json();
-    for (const todo of todos) {
-      const li = document.createElement('li');
-      li.dataset.testid = 'todo-item';
-      const title = document.createElement('span');
-      title.dataset.testid = 'todo-title';
-      title.textContent = todo.title + (todo.done ? ' ✓' : '');
-      li.append(title);
-      list.append(li);
+    function render() {
+      list.replaceChildren();
+      for (const todo of todos) {
+        if (filter.checked && !isOverdue(todo)) continue;
+        const li = document.createElement('li');
+        li.dataset.testid = 'todo-item';
+        if (isOverdue(todo)) li.classList.add('overdue');
+        const title = document.createElement('span');
+        title.dataset.testid = 'todo-title';
+        title.textContent = todo.title + (todo.done ? ' ✓' : '');
+        li.append(title);
+        if (todo.dueDate !== null) {
+          const due = document.createElement('span');
+          due.dataset.testid = 'todo-due';
+          due.textContent = ` – fällig ${formatDue(todo.dueDate)}`;
+          li.append(due);
+          if (isOverdue(todo)) {
+            const label = document.createElement('span');
+            label.dataset.testid = 'todo-overdue';
+            label.className = 'overdue-label';
+            label.textContent = ' überfällig';
+            li.append(label);
+          }
+        }
+        list.append(li);
+      }
     }
+    filter.addEventListener('change', render);
+    render();
   </script>
 </body>
 </html>
