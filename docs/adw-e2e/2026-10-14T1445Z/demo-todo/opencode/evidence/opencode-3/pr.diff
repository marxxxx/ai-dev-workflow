+++ b/test/store.test.mjs
@@ -0,0 +1,51 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createStore, isOverdue, ValidationError } from '../src/store.mjs';
+
+test('add stores an optional dueDate', () => {
+  const store = createStore();
+  const withDate = store.add({ title: 'A', dueDate: '2026-10-20' });
+  assert.equal(withDate.dueDate, '2026-10-20');
+  const withoutDate = store.add({ title: 'B' });
+  assert.equal(withoutDate.dueDate, null);
+});
+
+test('add rejects invalid dueDate values', () => {
+  const store = createStore();
+  for (const dueDate of ['2026-02-30', '2026-13-01', '2026-00-10', '2026-10-00', '20261014', '14.10.2026', '2026-1-4', '2026/10/14', '', 42, true]) {
+    assert.throws(() => store.add({ title: 'A', dueDate }), ValidationError, String(dueDate));
+  }
+});
+
+test('add accepts the 29th of February in a leap year only', () => {
+  const store = createStore();
+  assert.equal(store.add({ title: 'A', dueDate: '2028-02-29' }).dueDate, '2028-02-29');
+  assert.throws(() => store.add({ title: 'B', dueDate: '2026-02-29' }), ValidationError);
+});
+
+test('update sets, changes and removes dueDate', () => {
+  const store = createStore();
+  const todo = store.add({ title: 'A' });
+  assert.equal(store.update(todo.id, { dueDate: '2026-10-20' }).dueDate, '2026-10-20');
+  assert.equal(store.update(todo.id, { dueDate: '2026-11-01' }).dueDate, '2026-11-01');
+  assert.equal(store.update(todo.id, { dueDate: null }).dueDate, null);
+});
+
+test('update rejects invalid dueDate values', () => {
+  const store = createStore();
+  const todo = store.add({ title: 'A', dueDate: '2026-10-20' });
+  for (const dueDate of ['2026-02-30', 'gestern', '2026-10-20T10:00:00Z', 0]) {
+    assert.throws(() => store.update(todo.id, { dueDate }), ValidationError, String(dueDate));
+  }
+  assert.equal(store.get(todo.id).dueDate, '2026-10-20');
+});
+
+test('isOverdue: only unfinished todos with a past dueDate', () => {
+  const today = new Date('2026-10-14T12:00:00Z');
+  const base = { id: 1, title: 'A', done: false, dueDate: null };
+  assert.equal(isOverdue({ ...base, dueDate: '2026-10-13' }, today), true);
+  assert.equal(isOverdue({ ...base, dueDate: '2026-10-14' }, today), false);
+  assert.equal(isOverdue({ ...base, dueDate: '2026-10-15' }, today), false);
+  assert.equal(isOverdue(base, today), false);
+  assert.equal(isOverdue({ ...base, done: true, dueDate: '2026-10-13' }, today), false);
+});
