+// Validates an optional dueDate: undefined -> null (unset), null -> null (removed),
+// otherwise a strict YYYY-MM-DD string naming a real calendar day.
+function parseDueDate(value) {
+  if (value === undefined || value === null) return null;
+  if (typeof value !== 'string') {
+    throw new ValidationError('dueDate must be a valid YYYY-MM-DD date');
+  }
+  const match = value.match(/^(\d{4})-(\d{2})-(\d{2})$/);
+  if (!match) throw new ValidationError('dueDate must be a valid YYYY-MM-DD date');
+  const [, year, month, day] = match.map(Number);
+  const date = new Date(Date.UTC(year, month - 1, day));
+  if (date.getUTCFullYear() !== year || date.getUTCMonth() !== month - 1 || date.getUTCDate() !== day) {
+    throw new ValidationError('dueDate must be a valid YYYY-MM-DD date');
+  }
+  return value;
+}
+
+// A todo is overdue when it is unfinished and its dueDate lies before today (UTC).
+export function isOverdue(todo, now = new Date()) {
+  if (todo.done || !todo.dueDate) return false;
+  const today = now.toISOString().slice(0, 10);
+  return todo.dueDate < today;
+}
+
 export class ValidationError extends Error {}
