@@ -0,0 +1,80 @@
+using System.Net.Http.Json;
+using Microsoft.AspNetCore.Mvc.Testing;
+
+namespace DemoTodo.Tests;
+
+// The page is prerendered, so the initial HTML already contains the rendered todos.
+public class TodoPageTests : IDisposable
+{
+    private readonly WebApplicationFactory<Program> _factory = new();
+    private readonly HttpClient _client;
+
+    public TodoPageTests() => _client = _factory.CreateClient();
+
+    public void Dispose() => _factory.Dispose();
+
+    private async Task<string> RenderPageWith(params object[] todos)
+    {
+        foreach (var todo in todos) await _client.PostAsJsonAsync("/todos", todo);
+        var res = await _client.GetAsync("/");
+        res.EnsureSuccessStatusCode();
+        return await res.Content.ReadAsStringAsync();
+    }
+
+    [Fact]
+    public async Task ShowsTheDueDateNextToTheTitle()
+    {
+        var html = await RenderPageWith(new { title = "A", dueDate = "2026-10-20" });
+        Assert.Contains("data-testid=\"todo-due-date\">20.10.2026<", html);
+    }
+
+    [Fact]
+    public async Task ShowsNoDueDateWhenNoneIsSet()
+    {
+        var html = await RenderPageWith(new { title = "A" });
+        Assert.DoesNotContain("todo-due-date", html);
+    }
+
+    [Fact]
+    public async Task MarksOverdueTodos()
+    {
+        var yesterday = DateTime.UtcNow.Date.AddDays(-1).ToString("yyyy-MM-dd");
+        var html = await RenderPageWith(
+            new { title = "overdue", dueDate = yesterday },
+            new { title = "future", dueDate = "2999-01-01" },
+            new { title = "no date" });
+        Assert.Contains("data-testid=\"todo-overdue\">überfällig<", html);
+        Assert.Equal(1, CountOccurrences(html, "todo-overdue"));
+    }
+
+    [Fact]
+    public async Task DoesNotMarkDoneTodosAsOverdue()
+    {
+        var yesterday = DateTime.UtcNow.Date.AddDays(-1).ToString("yyyy-MM-dd");
+        await _client.PostAsJsonAsync("/todos", new { title = "done overdue", dueDate = yesterday });
+        await _client.PatchAsJsonAsync("/todos/1", new { done = true });
+        var res = await _client.GetAsync("/");
+        var html = await res.Content.ReadAsStringAsync();
+        Assert.DoesNotContain("todo-overdue", html);
+    }
+
+    [Fact]
+    public async Task HasAnOverdueOnlyFilterControl()
+    {
+        var html = await RenderPageWith(new { title = "A" });
+        Assert.Contains("data-testid=\"overdue-only\"", html);
+        Assert.Contains("nur überfällige", html);
+    }
+
+    private static int CountOccurrences(string haystack, string needle)
+    {
+        var count = 0;
+        var index = 0;
+        while ((index = haystack.IndexOf(needle, index, StringComparison.Ordinal)) >= 0)
+        {
+            count++;
+            index += needle.Length;
+        }
+        return count;
+    }
+}
