@@ -64,4 +70,69 @@ app.Run();
 
 static IResult NotFound() => Results.NotFound(new { error = "not found" });
 
+static object ToDto(Todo todo) => new
+{
+    todo.Id,
+    todo.Title,
+    todo.Done,
+    todo.DueDate,
+    Overdue = TodoStore.IsOverdue(todo),
+};
+
+static NewTodo ParseNewTodo(JsonElement body)
+{
+    string? title = null;
+    DateTime? dueDate = null;
+    foreach (var prop in body.EnumerateObject())
+    {
+        switch (prop.Name)
+        {
+            case "title" when prop.Value.ValueKind == JsonValueKind.String:
+                title = prop.Value.GetString();
+                break;
+            case "dueDate" when prop.Value.ValueKind is JsonValueKind.String or JsonValueKind.Null:
+                dueDate = ParseDueDate(prop.Value);
+                break;
+        }
+    }
+    return new NewTodo(title, dueDate);
+}
+
+static DateTime? ParseDueDate(JsonElement value) => value.ValueKind switch
+{
+    JsonValueKind.Null => null,
+    JsonValueKind.String when DateTime.TryParseExact(
+        value.GetString(), "yyyy-MM-dd",
+        System.Globalization.CultureInfo.InvariantCulture,
+        System.Globalization.DateTimeStyles.None, out var parsed)
+        => DateTime.SpecifyKind(parsed.Date, DateTimeKind.Utc),
+    _ => throw new ValidationException("dueDate must be a date like \"2026-10-20\" or null"),
+};
+
+// PATCH bodies are parsed by hand so an explicit "dueDate": null (clear) is distinguishable from an absent key (keep).
+static TodoPatch ParsePatch(JsonElement body)
+{
+    string? title = null;
+    bool? done = null;
+    DateTime? dueDate = null;
+    var hasDueDate = false;
+    foreach (var prop in body.EnumerateObject())
+    {
+        switch (prop.Name)
+        {
+            case "title" when prop.Value.ValueKind == JsonValueKind.String:
+                title = prop.Value.GetString();
+                break;
+            case "done" when prop.Value.ValueKind is JsonValueKind.True or JsonValueKind.False:
+                done = prop.Value.GetBoolean();
+                break;
+            case "dueDate" when prop.Value.ValueKind is JsonValueKind.String or JsonValueKind.Null:
+                hasDueDate = true;
+                dueDate = ParseDueDate(prop.Value);
+                break;
+        }
+    }
+    return new TodoPatch(title, done, dueDate, hasDueDate);
+}
+
 public partial class Program;
