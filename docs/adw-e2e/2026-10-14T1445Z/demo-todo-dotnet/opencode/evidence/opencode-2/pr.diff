@@ -64,4 +69,32 @@ app.Run();
 
 static IResult NotFound() => Results.NotFound(new { error = "not found" });
 
+// A PATCH body distinguishes "field absent" (leave unchanged) from "dueDate: null" (clear the date).
+static TodoPatch ParsePatch(JsonElement body)
+{
+    string? title = null;
+    bool? done = null;
+    DateOnly? dueDate = null;
+    var dueDateSet = false;
+    if (body.TryGetProperty("title", out var titleEl) && titleEl.ValueKind == JsonValueKind.String)
+        title = titleEl.GetString();
+    if (body.TryGetProperty("done", out var doneEl) && doneEl.ValueKind is JsonValueKind.True or JsonValueKind.False)
+        done = doneEl.GetBoolean();
+    if (body.TryGetProperty("dueDate", out var dueEl))
+    {
+        dueDateSet = true;
+        if (dueEl.ValueKind == JsonValueKind.String)
+        {
+            if (!DateOnly.TryParseExact(dueEl.GetString(), "yyyy-MM-dd", out var parsed))
+                throw new ValidationException("dueDate must be a valid date in YYYY-MM-DD format");
+            dueDate = parsed;
+        }
+        else if (dueEl.ValueKind != JsonValueKind.Null)
+        {
+            throw new ValidationException("dueDate must be a valid date in YYYY-MM-DD format or null");
+        }
+    }
+    return new TodoPatch(title, done, dueDate, dueDateSet);
+}
+
 public partial class Program;
