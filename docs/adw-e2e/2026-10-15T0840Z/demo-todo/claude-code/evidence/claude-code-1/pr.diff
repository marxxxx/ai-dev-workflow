@@ -38,4 +48,18 @@ export function createStore() {
   };
 }
 
+// A due date is null or a real calendar date as YYYY-MM-DD.
+function checkDueDate(dueDate) {
+  if (dueDate === null) return;
+  const parts = typeof dueDate === 'string' && /^(\d{4})-(\d{2})-(\d{2})$/.exec(dueDate);
+  if (!parts) throw new ValidationError('dueDate must be a date as YYYY-MM-DD or null');
+  const [year, month, day] = parts.slice(1).map(Number);
+  const date = new Date(0);
+  date.setUTCFullYear(year, month - 1, day);
+  // Date rolls impossible days over (Feb 30 -> Mar 2), so a round trip exposes them.
+  if (date.getUTCFullYear() !== year || date.getUTCMonth() !== month - 1 || date.getUTCDate() !== day) {
+    throw new ValidationError('dueDate is not a valid calendar date');
+  }
+}
+
 export class ValidationError extends Error {}
