+// Accepts null or a real calendar date as YYYY-MM-DD.
+function checkDueDate(value) {
+  if (value === null) return null;
+  const valid =
+    typeof value === 'string' &&
+    /^\d{4}-\d{2}-\d{2}$/.test(value) &&
+    !Number.isNaN(Date.parse(value)) &&
+    new Date(value).toISOString().startsWith(value);
+  if (!valid) throw new ValidationError('dueDate must be a date as YYYY-MM-DD or null');
+  return value;
+}
