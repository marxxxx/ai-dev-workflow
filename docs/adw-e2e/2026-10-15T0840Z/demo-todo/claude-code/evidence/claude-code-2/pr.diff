+// A due date is null or a real calendar day as YYYY-MM-DD.
+function checkDueDate(dueDate) {
+  if (dueDate === null) return;
+  const valid =
+    typeof dueDate === 'string' &&
+    /^\d{4}-\d{2}-\d{2}$/.test(dueDate) &&
+    !Number.isNaN(Date.parse(dueDate)) &&
+    new Date(dueDate).toISOString().slice(0, 10) === dueDate;
+  if (!valid) throw new ValidationError('dueDate must be a date as YYYY-MM-DD or null');
+}
