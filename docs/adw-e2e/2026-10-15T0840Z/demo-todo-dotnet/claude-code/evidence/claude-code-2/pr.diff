diff --git a/tests/DemoTodo.Tests/FixedTimeProvider.cs b/tests/DemoTodo.Tests/FixedTimeProvider.cs
new file mode 100644
index 0000000..b1221e7
--- /dev/null
+++ b/tests/DemoTodo.Tests/FixedTimeProvider.cs
@@ -0,0 +1,13 @@
+namespace DemoTodo.Tests;
+
+// A clock frozen at the given instant, so "today" is deterministic in tests. Its local zone is
+// UTC+14, so code that wrongly uses local time instead of UTC sees a different date.
+public class FixedTimeProvider(DateTimeOffset now) : TimeProvider
+{
+    private static readonly TimeZoneInfo Utc14 =
+        TimeZoneInfo.CreateCustomTimeZone("UTC+14", TimeSpan.FromHours(14), "UTC+14", "UTC+14");
+
+    public override DateTimeOffset GetUtcNow() => now;
+
+    public override TimeZoneInfo LocalTimeZone => Utc14;
+}
