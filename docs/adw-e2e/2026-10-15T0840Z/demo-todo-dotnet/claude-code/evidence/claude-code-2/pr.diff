+
+    // 2026-10-15 late in the UTC day: in the clock's local zone it is already the 16th.
+    private static readonly FixedTimeProvider LateOnOctober15 = new(new DateTimeOffset(2026, 10, 15, 23, 30, 0, TimeSpan.Zero));
+
+    [Fact]
+    public void StoresAnOptionalDueDate()
+    {
+        var store = new TodoStore();
+        Assert.Null(store.Add(new NewTodo("A")).DueDate);
+        Assert.Equal(new DateOnly(2026, 10, 20), store.Add(new NewTodo("B", new DateOnly(2026, 10, 20))).DueDate);
+    }
+
+    [Fact]
+    public void PatchChangesClearsOrKeepsTheDueDate()
+    {
+        var store = new TodoStore();
+        var todo = store.Add(new NewTodo("A", new DateOnly(2026, 10, 20)));
+        Assert.Equal(new DateOnly(2026, 10, 20), store.Update(todo.Id, new TodoPatch(null, true))!.DueDate);
+        Assert.Equal(new DateOnly(2026, 11, 1), store.Update(todo.Id, new TodoPatch(null, null) { DueDate = new DateOnly(2026, 11, 1) })!.DueDate);
+        Assert.Null(store.Update(todo.Id, new TodoPatch(null, null) { DueDate = null })!.DueDate);
+    }
+
+    [Fact]
+    public void ATodoIsOverdueOnlyIfOpenAndDueBeforeTodayInUtc()
+    {
+        var store = new TodoStore(LateOnOctober15);
+        Assert.True(store.IsOverdue(new Todo(1, "A", false, new DateOnly(2026, 10, 14))));
+        Assert.False(store.IsOverdue(new Todo(2, "B", false, new DateOnly(2026, 10, 15))));
+        Assert.False(store.IsOverdue(new Todo(3, "C", true, new DateOnly(2026, 10, 14))));
+        Assert.False(store.IsOverdue(new Todo(4, "D", false)));
+    }
+
+    [Fact]
+    public void ListsOnlyOverdueTodosOnRequest()
+    {
+        var store = new TodoStore(LateOnOctober15);
+        var overdue = store.Add(new NewTodo("A", new DateOnly(2026, 10, 1)));
+        store.Add(new NewTodo("B", new DateOnly(2026, 10, 15)));
+        store.Add(new NewTodo("C"));
