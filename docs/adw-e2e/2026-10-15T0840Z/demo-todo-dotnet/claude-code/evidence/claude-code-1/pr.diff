+@* Keeps the spaces between title, due date and overdue marker. *@
+@preservewhitespace true
 
 <PageTitle>Todos</PageTitle>
 
 <h1>Todos</h1>
 
+<label>
+    <input type="checkbox" data-testid="overdue-filter" @bind="onlyOverdue" />
+    nur überfällige
+</label>
+
 <ul data-testid="todo-list">
