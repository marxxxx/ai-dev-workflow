@@ -0,0 +1,48 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createStore, ValidationError } from '../src/store.mjs';
+
+const today = () => new Date().toISOString().slice(0, 10);
+const shiftDays = (days) => {
+  const d = new Date();
+  d.setDate(d.getDate() + days);
+  return d.toISOString().slice(0, 10);
+};
+
+test('add stores a valid dueDate', () => {
+  const store = createStore();
+  const todo = store.add({ title: 'A', dueDate: '2026-10-12' });
+  assert.equal(todo.dueDate, '2026-10-12');
+});
+
+test('add defaults dueDate to null', () => {
+  const store = createStore();
+  assert.equal(store.add({ title: 'A' }).dueDate, null);
+  assert.equal(store.add({ title: 'A', dueDate: null }).dueDate, null);
+});
+
+test('add rejects invalid dueDate values', () => {
+  const store = createStore();
+  for (const dueDate of ['2026-02-30', '12.10.2026', '2026-10-12T10:00', '2026-13-01', 42, true]) {
+    assert.throws(() => store.add({ title: 'A', dueDate }), ValidationError, String(dueDate));
+  }
+});
+
+test('update sets and clears dueDate', () => {
+  const store = createStore();
+  store.add({ title: 'A' });
+  assert.equal(store.update(1, { dueDate: '2026-10-12' }).dueDate, '2026-10-12');
+  assert.equal(store.update(1, { dueDate: null }).dueDate, null);
+  assert.throws(() => store.update(1, { dueDate: '2026-02-30' }), ValidationError);
+});
+
+test('list({ overdue: true }) returns only todos due before today', () => {
+  const store = createStore();
+  store.add({ title: 'gestern', dueDate: shiftDays(-1) });
+  store.add({ title: 'heute', dueDate: today() });
+  store.add({ title: 'morgen', dueDate: shiftDays(1) });
+  store.add({ title: 'ohne datum' });
+  const overdue = store.list({ overdue: true });
+  assert.deepEqual(overdue.map((t) => t.title), ['gestern']);
+  assert.equal(store.list().length, 4);
+});
