@@ -1,4 +1,21 @@
 // In-memory todo store.
+const DATE_RE = /^\d{4}-\d{2}-\d{2}$/;
+
+function isValidDate(value) {
+  if (typeof value !== 'string' || !DATE_RE.test(value)) return false;
+  const [y, m, d] = value.split('-').map(Number);
+  const date = new Date(Date.UTC(y, m - 1, d));
+  return date.getUTCFullYear() === y && date.getUTCMonth() === m - 1 && date.getUTCDate() === d;
+}
+
+function validateDueDate(value) {
+  if (value === null) return null;
+  if (!isValidDate(value)) {
+    throw new ValidationError('dueDate must be a valid YYYY-MM-DD date or null');
+  }
+  return value;
+}
+
 export function createStore() {
   const todos = new Map();
   let nextId = 1;
@@ -9,11 +26,11 @@ export function createStore() {
     get(id) {
       return todos.get(id);
     },
-    add({ title }) {
+    add({ title, dueDate = null }) {
       if (typeof title !== 'string' || title.trim() === '') {
         throw new ValidationError('title is required');
       }
-      const todo = { id: nextId++, title: title.trim(), done: false };
+      const todo = { id: nextId++, title: title.trim(), done: false, dueDate: validateDueDate(dueDate) };
       todos.set(todo.id, todo);
       return todo;
     },
@@ -30,6 +47,9 @@ export function createStore() {
         if (typeof patch.done !== 'boolean') throw new ValidationError('done must be a boolean');
         todo.done = patch.done;
       }
+      if ('dueDate' in patch) {
+        todo.dueDate = validateDueDate(patch.dueDate);
+      }
       return todo;
     },
     remove(id) {
