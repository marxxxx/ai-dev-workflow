+function parseDueDate(dueDate) {
+  if (dueDate === null) return null;
+  if (typeof dueDate !== 'string' || !/^\d{4}-\d{2}-\d{2}$/.test(dueDate)) {
+    throw new ValidationError('dueDate must be a YYYY-MM-DD date');
+  }
+  const date = new Date(`${dueDate}T00:00:00Z`);
+  if (Number.isNaN(date.getTime()) || date.toISOString().slice(0, 10) !== dueDate) {
+    throw new ValidationError('dueDate must be a YYYY-MM-DD date');
+  }
+  return dueDate;
+}
+
+export function isOverdue(todo, todayUtc) {
+  return !todo.done && todo.dueDate !== null && todo.dueDate < todayUtc;
+}
+
 export class ValidationError extends Error {}
