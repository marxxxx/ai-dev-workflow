diff --git a/test/store.test.mjs b/test/store.test.mjs
new file mode 100644
index 0000000..4be46a9
--- /dev/null
+++ b/test/store.test.mjs
@@ -0,0 +1,50 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createStore, isOverdue, ValidationError } from '../src/store.mjs';
+
+test('add stores dueDate and defaults to null', () => {
+  const store = createStore();
+  const withDate = store.add({ title: 'A', dueDate: '2026-10-15' });
+  assert.equal(withDate.dueDate, '2026-10-15');
+  const withoutDate = store.add({ title: 'B' });
+  assert.equal(withoutDate.dueDate, null);
+});
+
+test('add rejects invalid dueDate', () => {
+  const store = createStore();
+  for (const dueDate of ['15.10.2026', '2026-13-01', '2026-02-30', '2026-1-5', 123, true]) {
+    assert.throws(() => store.add({ title: 'A', dueDate }), ValidationError, String(dueDate));
+  }
+});
+
+test('update sets and clears dueDate', () => {
+  const store = createStore();
+  const todo = store.add({ title: 'A' });
+  assert.equal(store.update(todo.id, { dueDate: '2026-10-20' }).dueDate, '2026-10-20');
+  assert.equal(store.update(todo.id, { dueDate: null }).dueDate, null);
+});
+
+test('update rejects invalid dueDate', () => {
+  const store = createStore();
+  const todo = store.add({ title: 'A' });
+  assert.throws(() => store.update(todo.id, { dueDate: 'not-a-date' }), ValidationError);
+});
+
+test('isOverdue: open todo with past date is overdue', () => {
+  const store = createStore();
+  const todo = store.add({ title: 'A', dueDate: '2026-10-10' });
+  assert.equal(isOverdue(todo, '2026-10-11'), true);
+});
+
+test('isOverdue: today, future, done, and missing dueDate are not overdue', () => {
+  const store = createStore();
+  const today = store.add({ title: 'A', dueDate: '2026-10-11' });
+  const future = store.add({ title: 'B', dueDate: '2026-10-12' });
+  const done = store.add({ title: 'C', dueDate: '2026-10-10' });
+  store.update(done.id, { done: true });
+  const noDate = store.add({ title: 'D' });
+  assert.equal(isOverdue(today, '2026-10-11'), false);
+  assert.equal(isOverdue(future, '2026-10-11'), false);
+  assert.equal(isOverdue(done, '2026-10-11'), false);
+  assert.equal(isOverdue(noDate, '2026-10-11'), false);
+});
