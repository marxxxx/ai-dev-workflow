+          const overdue = span('todo-overdue', 'überfällig');
+          overdue.style.color = 'red';
+          li.append(' ', overdue);
+          li.dataset.overdue = 'true';
+        }
+        list.append(li);
+      }
     }
+
+    filter.addEventListener('change', render);
+    await render();
   </script>
 </body>
 </html>
