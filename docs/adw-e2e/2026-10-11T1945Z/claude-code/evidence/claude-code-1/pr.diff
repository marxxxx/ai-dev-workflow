diff --git a/test/store.test.mjs b/test/store.test.mjs
new file mode 100644
index 0000000..cd70492
--- /dev/null
+++ b/test/store.test.mjs
@@ -0,0 +1,109 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createStore, isOverdue, ValidationError } from '../src/store.mjs';
+
+const clock = () => new Date('2026-10-11T12:00:00Z');
+const DUE_DATE_ERROR = 'dueDate must be a date in YYYY-MM-DD format or null';
+
+test('isOverdue compares the due date with today', () => {
+  const today = '2026-10-11';
+  assert.equal(isOverdue({ done: false, dueDate: '2026-10-10' }, today), true);
+  assert.equal(isOverdue({ done: false, dueDate: '2026-10-11' }, today), false);
+  assert.equal(isOverdue({ done: false, dueDate: '2026-10-12' }, today), false);
+  assert.equal(isOverdue({ done: true, dueDate: '2026-10-10' }, today), false);
+  assert.equal(isOverdue({ done: false, dueDate: null }, today), false);
+});
+
+test('a new todo has no due date and is not overdue', () => {
+  const store = createStore({ now: clock });
+  assert.deepEqual(store.add({ title: 'A' }), {
+    id: 1,
+    title: 'A',
+    done: false,
+    dueDate: null,
+    overdue: false,
+  });
+});
+
+test('a todo due yesterday is overdue', () => {
+  const store = createStore({ now: clock });
+  assert.equal(store.add({ title: 'A', dueDate: '2026-10-10' }).overdue, true);
+});
+
+for (const dueDate of [
+  '15.10.2026',
+  '2026-10-15T00:00:00Z',
+  '2026-02-30',
+  '2026-13-01',
+  '2027-02-29',
+  '',
+  20261015,
+  true,
+]) {
+  test(`rejects dueDate ${JSON.stringify(dueDate)} and stores nothing`, () => {
+    const store = createStore({ now: clock });
+    assert.throws(
+      () => store.add({ title: 'A', dueDate }),
+      (err) => err instanceof ValidationError && err.message === DUE_DATE_ERROR,
+    );
+    assert.deepEqual(store.list(), []);
+  });
+}
+
+test('accepts a leap day', () => {
+  const store = createStore({ now: clock });
+  assert.equal(store.add({ title: 'A', dueDate: '2028-02-29' }).dueDate, '2028-02-29');
+});
+
+test('update sets and clears the due date', () => {
+  const store = createStore({ now: clock });
+  store.add({ title: 'A' });
+  assert.equal(store.update(1, { dueDate: '2026-10-10' }).overdue, true);
+  assert.deepEqual(store.update(1, { dueDate: null }), {
+    id: 1,
+    title: 'A',
+    done: false,
+    dueDate: null,
+    overdue: false,
+  });
+});
+
+test('a done todo is not overdue', () => {
+  const store = createStore({ now: clock });
+  store.add({ title: 'A', dueDate: '2026-10-10' });
+  assert.equal(store.update(1, { done: true }).overdue, false);
+});
+
+test('update applies nothing when any field is invalid', () => {
+  const store = createStore({ now: clock });
+  store.add({ title: 'A' });
+  assert.throws(() => store.update(1, { done: true, dueDate: 'x' }), ValidationError);
+  assert.equal(store.get(1).done, false);
+  assert.throws(() => store.update(1, { title: 'B', dueDate: 'x' }), ValidationError);
+  assert.equal(store.get(1).title, 'A');
+});
+
+test('returned todos are copies', () => {
+  const store = createStore({ now: clock });
+  store.add({ title: 'A' });
+  const todo = store.get(1);
+  todo.title = 'X';
+  assert.equal(store.get(1).title, 'A');
+});
+
+test('today is the UTC date', () => {
+  const store = createStore({ now: () => new Date('2026-10-11T23:30:00Z') });
+  assert.equal(store.add({ title: 'A', dueDate: '2026-10-11' }).overdue, false);
+  assert.equal(store.add({ title: 'B', dueDate: '2026-10-10' }).overdue, true);
+});
+
+test('list filters by overdue', () => {
+  const store = createStore({ now: clock });
+  store.add({ title: 'A', dueDate: '2026-10-10' });
+  store.add({ title: 'B', dueDate: '2026-10-12' });
+  store.add({ title: 'C' });
+  const titles = (todos) => todos.map((t) => t.title);
+  assert.deepEqual(titles(store.list({ overdue: true })), ['A']);
+  assert.deepEqual(titles(store.list({ overdue: false })), ['B', 'C']);
+  assert.deepEqual(titles(store.list()), ['A', 'B', 'C']);
+});
