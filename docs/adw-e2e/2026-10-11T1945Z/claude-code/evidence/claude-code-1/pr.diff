 <head><meta charset="utf-8"><title>demo-todo</title></head>
 <body>
   <h1>Todos</h1>
+  <label><input type="checkbox" data-testid="filter-overdue"> nur überfällige</label>
   <ul data-testid="todo-list"></ul>
   <script type="module">
     const list = document.querySelector('[data-testid="todo-list"]');
-    const todos = await (await fetch('/todos')).json();
-    for (const todo of todos) {
-      const li = document.createElement('li');
-      li.dataset.testid = 'todo-item';
-      const title = document.createElement('span');
-      title.dataset.testid = 'todo-title';
-      title.textContent = todo.title + (todo.done ? ' ✓' : '');
-      li.append(title);
-      list.append(li);
+    const filter = document.querySelector('[data-testid="filter-overdue"]');
+
+    const span = (testid, text) => {
+      const el = document.createElement('span');
+      el.dataset.testid = testid;
+      el.textContent = text;
+      return el;
+    };
+
+    async function render() {
+      const onlyOverdue = filter.checked;
+      const todos = await (await fetch(onlyOverdue ? '/todos?overdue=true' : '/todos')).json();
+      // A newer toggle started its own render; drop this stale response.
+      if (filter.checked !== onlyOverdue) return;
+      list.replaceChildren();
+      for (const todo of todos) {
+        const li = document.createElement('li');
+        li.dataset.testid = 'todo-item';
+        li.append(span('todo-title', todo.title + (todo.done ? ' ✓' : '')));
+        if (todo.dueDate) li.append(' ', span('todo-due-date', todo.dueDate));
