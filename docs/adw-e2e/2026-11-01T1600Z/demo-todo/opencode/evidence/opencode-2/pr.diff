 // In-memory todo store.
+const DATE_RE = /^\d{4}-\d{2}-\d{2}$/;
+
+function normalizeDueDate(value) {
+  if (value === null) return null;
+  // Round-trip catches impossible calendar dates like 2026-02-30 or 2026-13-01.
+  const parsed = typeof value === 'string' && DATE_RE.test(value) ? new Date(`${value}T00:00:00Z`) : null;
+  if (!parsed || Number.isNaN(parsed.getTime()) || parsed.toISOString().slice(0, 10) !== value) {
+    throw new ValidationError("dueDate must be a YYYY-MM-DD calendar date (e.g. '2026-11-01') or null");
+  }
+  return value;
+}
+
