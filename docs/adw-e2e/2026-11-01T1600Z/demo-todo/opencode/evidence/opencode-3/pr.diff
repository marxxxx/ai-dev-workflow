       if (typeof title !== 'string' || title.trim() === '') {
         throw new ValidationError('title is required');
       }
-      const todo = { id: nextId++, title: title.trim(), done: false };
+      const todo = { id: nextId++, title: title.trim(), done: false, dueDate: normalizeDueDate(dueDate) };
       todos.set(todo.id, todo);
       return todo;
     },
@@ -30,6 +51,9 @@ export function createStore() {
         if (typeof patch.done !== 'boolean') throw new ValidationError('done must be a boolean');
         todo.done = patch.done;
       }
+      if ('dueDate' in patch) {
+        todo.dueDate = normalizeDueDate(patch.dueDate);
+      }
       return todo;
     },
     remove(id) {
@@ -39,3 +63,14 @@ export function createStore() {
 }
 
 export class ValidationError extends Error {}
+
+// Today's date as YYYY-MM-DD in UTC.
+export function todayUtc(now = new Date()) {
+  return now.toISOString().slice(0, 10);
+}
+
+// Overdue = not done, has a due date, and the date is before today (UTC).
+// ISO date strings compare correctly as strings.
+export function isOverdue(todo, today = todayUtc()) {
+  return !todo.done && todo.dueDate !== null && todo.dueDate < today;
+}
