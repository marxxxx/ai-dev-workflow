+        if (todo.overdue) {
+          const marker = document.createElement('span');
+          marker.dataset.testid = 'todo-overdue';
+          marker.textContent = ' überfällig';
+          li.append(marker);
+        }
+        list.append(li);
+      }
     }
+    toggle.addEventListener('click', () => {
+      onlyOverdue = !onlyOverdue;
+      render();
+    });
+    await render();
   </script>
