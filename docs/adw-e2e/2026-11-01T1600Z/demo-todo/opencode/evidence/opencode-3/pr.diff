@@ -1,4 +1,25 @@
 // In-memory todo store.
+const DATE_RE = /^(\d{4})-(\d{2})-(\d{2})$/;
+
+// Validates a YYYY-MM-DD string and rejects non-existent calendar dates (e.g. 2026-02-30).
+function parseDueDate(value) {
+  const match = typeof value === 'string' ? DATE_RE.exec(value) : null;
+  if (!match) throw new ValidationError('dueDate must be a YYYY-MM-DD calendar date');
+  const year = Number(match[1]);
+  const month = Number(match[2]);
+  const day = Number(match[3]);
+  const date = new Date(0);
+  date.setUTCFullYear(year, month - 1, day);
+  if (date.getUTCFullYear() !== year || date.getUTCMonth() !== month - 1 || date.getUTCDate() !== day) {
+    throw new ValidationError('dueDate must be a YYYY-MM-DD calendar date');
+  }
+  return value;
+}
+
+function normalizeDueDate(value) {
+  return value === undefined || value === null ? null : parseDueDate(value);
+}
+
 export function createStore() {
   const todos = new Map();
   let nextId = 1;
@@ -9,11 +30,11 @@ export function createStore() {
     get(id) {
       return todos.get(id);
     },
-    add({ title }) {
