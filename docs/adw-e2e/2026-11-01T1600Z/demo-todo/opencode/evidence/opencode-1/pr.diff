+    const res = await fetch(`${base}/todos`, json('POST', { title: 'Später', due: '2999-12-31' }));
+    assert.equal(res.status, 201);
+    assert.deepEqual(await res.json(), {
+      id: 1, title: 'Später', done: false, due: '2999-12-31', overdue: false,
+    });
+  }));
+
+test('create with past due date: overdue true', () =>
+  withServer(async (base) => {
+    const res = await fetch(`${base}/todos`, json('POST', { title: 'Alt', due: '2000-01-01' }));
+    assert.equal(res.status, 201);
+    assert.equal((await res.json()).overdue, true);
+  }));
+
+test('invalid due dates are rejected with 400', () =>
+  withServer(async (base) => {
+    for (const due of ['2026-02-30', '2027-02-29', '2026-1-1', 'tomorrow', 42]) {
+      const res = await fetch(`${base}/todos`, json('POST', { title: 'X', due }));
+      assert.equal(res.status, 400, `due=${JSON.stringify(due)} should be 400`);
+    }
+  }));
+
+test('leap day 2028-02-29 is accepted', () =>
+  withServer(async (base) => {
+    const res = await fetch(`${base}/todos`, json('POST', { title: 'Schaltjahr', due: '2028-02-29' }));
+    assert.equal(res.status, 201);
+  }));
+
+test('due today (UTC) is not overdue, due yesterday is', () =>
+  withServer(async (base) => {
+    const today = await fetch(`${base}/todos`, json('POST', { title: 'Heute', due: '2026-11-01' }));
+    assert.equal((await today.json()).overdue, false);
+    const yesterday = await fetch(`${base}/todos`, json('POST', { title: 'Gestern', due: '2026-10-31' }));
+    assert.equal((await yesterday.json()).overdue, true);
+  }, createApp(createStore(() => new Date('2026-11-01T12:00:00Z')))));
+
+test('a done todo with a past due date is not overdue', () =>
+  withServer(async (base) => {
+    await fetch(`${base}/todos`, json('POST', { title: 'Erledigt', due: '2000-01-01' }));
+    const res = await fetch(`${base}/todos/1`, json('PATCH', { done: true }));
+    const body = await res.json();
+    assert.equal(body.done, true);
+    assert.equal(body.overdue, false);
+  }));
+
+test('PATCH can change and remove the due date', () =>
+  withServer(async (base) => {
+    await fetch(`${base}/todos`, json('POST', { title: 'A', due: '2000-01-01' }));
+    const changed = await fetch(`${base}/todos/1`, json('PATCH', { due: '2999-12-31' }));
+    assert.equal((await changed.json()).overdue, false);
+    const removed = await fetch(`${base}/todos/1`, json('PATCH', { due: null }));
+    const body = await removed.json();
+    assert.equal(body.due, null);
+    assert.equal(body.overdue, false);
+  }));
+
+test('GET /todos?overdue=true returns only overdue todos', () =>
+  withServer(async (base) => {
+    await fetch(`${base}/todos`, json('POST', { title: 'Alt', due: '2000-01-01' }));
+    await fetch(`${base}/todos`, json('POST', { title: 'Später', due: '2999-12-31' }));
+    await fetch(`${base}/todos`, json('POST', { title: 'Ohne' }));
+    const res = await fetch(`${base}/todos?overdue=true`);
+    assert.equal(res.status, 200);
+    const list = await res.json();
+    assert.equal(list.length, 1);
+    assert.equal(list[0].title, 'Alt');
+    assert.equal(list[0].overdue, true);
+  }));
+
+test('GET /todos?overdue=false returns all todos', () =>
+  withServer(async (base) => {
+    await fetch(`${base}/todos`, json('POST', { title: 'Alt', due: '2000-01-01' }));
+    await fetch(`${base}/todos`, json('POST', { title: 'Später', due: '2999-12-31' }));
+    await fetch(`${base}/todos`, json('POST', { title: 'Ohne' }));
+    const res = await fetch(`${base}/todos?overdue=false`);
+    assert.equal(res.status, 200);
+    assert.equal((await res.json()).length, 3);
+  }));
+
+test('GET /todos?overdue=banana is a 400', () =>
+  withServer(async (base) => {
+    const res = await fetch(`${base}/todos?overdue=banana`);
+    assert.equal(res.status, 400);
+  }));
+
+test('list page ships the overdue UI elements', () =>
+  withServer(async (base) => {
+    const res = await fetch(`${base}/`);
+    assert.equal(res.status, 200);
+    const html = await res.text();
+    assert.match(html, /data-testid="overdue-only-toggle"/);
+    assert.match(html, /todo-due/);
+    assert.match(html, /todo-overdue/);
+  }));
