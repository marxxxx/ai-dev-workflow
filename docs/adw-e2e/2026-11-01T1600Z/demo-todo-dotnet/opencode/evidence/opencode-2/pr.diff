 using System.ComponentModel.DataAnnotations;
+using System.Text.Json;
+using System.Text.Json.Serialization;
 
 namespace DemoTodo;
 
-public record Todo(int Id, string Title, bool Done);
+public record Todo(int Id, string Title, bool Done, DateOnly? DueDate)
+{
+    // Overdue: not done, has a due date, and that date is before today (UTC). Never overdue without a date.
+    public bool Overdue => !Done && DueDate is { } due && due < DateOnly.FromDateTime(DateTime.UtcNow);
+}
+
+public record NewTodo(string? Title, DateOnly? DueDate = null);
+
+// Tri-state PATCH field for the due date: absent = keep, explicit JSON null = clear, value = set.
+public readonly record struct DueDatePatch(bool IsSet, DateOnly? Value);
+
+public sealed class DueDatePatchConverter : JsonConverter<DueDatePatch>
+{
+    public override DueDatePatch Read(ref Utf8JsonReader reader, Type typeToConvert, JsonSerializerOptions options)
+    {
+        if (reader.TokenType == JsonTokenType.Null) return new DueDatePatch(true, null);
+        return new DueDatePatch(true, JsonSerializer.Deserialize<DateOnly?>(ref reader, options));
+    }
 
-public record NewTodo(string? Title);
+    public override void Write(Utf8JsonWriter writer, DueDatePatch value, JsonSerializerOptions options)
+        => throw new NotSupportedException("DueDatePatch is request-only.");
+}
 
-public record TodoPatch(string? Title, bool? Done);
+public record TodoPatch(string? Title, bool? Done, [property: JsonConverter(typeof(DueDatePatchConverter))] DueDatePatch DueDate = default);
 
 // In-memory todo store, registered as a singleton: the API and the list page share it.
 public class TodoStore
@@ -15,9 +36,10 @@ public class TodoStore
     private readonly SortedDictionary<int, Todo> _todos = [];
     private int _nextId = 1;
 
-    public IReadOnlyList<Todo> List()
+    public IReadOnlyList<Todo> List(bool? overdue = null)
     {
-        lock (_lock) return [.. _todos.Values];
+        lock (_lock)
+            return [.. _todos.Values.Where(t => overdue is null || t.Overdue == overdue.Value)];
     }
 
     public Todo? Get(int id)
@@ -31,7 +53,7 @@ public class TodoStore
         if (string.IsNullOrEmpty(title)) throw new ValidationException("title is required");
         lock (_lock)
         {
-            var todo = new Todo(_nextId++, title, false);
+            var todo = new Todo(_nextId++, title, false, input.DueDate);
             _todos[todo.Id] = todo;
             return todo;
         }
@@ -44,7 +66,12 @@ public class TodoStore
         lock (_lock)
         {
             if (!_todos.TryGetValue(id, out var todo)) return null;
-            todo = todo with { Title = title ?? todo.Title, Done = patch.Done ?? todo.Done };
+            todo = todo with
+            {
+                Title = title ?? todo.Title,
+                Done = patch.Done ?? todo.Done,
+                DueDate = patch.DueDate.IsSet ? patch.DueDate.Value : todo.DueDate,
+            };
             _todos[id] = todo;
             return todo;
         }
