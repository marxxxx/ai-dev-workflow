 using System.ComponentModel.DataAnnotations;
+using System.Globalization;
+using System.Text.Json;
 
 namespace DemoTodo;
 
-public record Todo(int Id, string Title, bool Done);
+public record Todo(int Id, string Title, bool Done, DateOnly? DueDate)
+{
+    // Overdue: due date strictly before today (UTC) and not done; no due date is never overdue.
+    public bool Overdue => DueDate is { } d && d < DateOnly.FromDateTime(DateTime.UtcNow) && !Done;
+}
 
-public record NewTodo(string? Title);
+public record NewTodo(string? Title, string? DueDate);
 
-public record TodoPatch(string? Title, bool? Done);
+// Non-nullable on purpose: with JsonElement? STJ maps JSON null to C# null, so "absent"
+// (ValueKind.Undefined) and "explicit null" (ValueKind.Null, i.e. clear) stay distinguishable.
+public record TodoPatch(string? Title, bool? Done, JsonElement DueDate);
 
 // In-memory todo store, registered as a singleton: the API and the list page share it.
 public class TodoStore
@@ -31,12 +39,20 @@ public class TodoStore
         if (string.IsNullOrEmpty(title)) throw new ValidationException("title is required");
         lock (_lock)
         {
-            var todo = new Todo(_nextId++, title, false);
+            var todo = new Todo(_nextId++, title, false, ParseDueDate(input.DueDate));
             _todos[todo.Id] = todo;
             return todo;
         }
     }
 
+    private static DateOnly? ParseDueDate(string? s)
+    {
+        if (s is null) return null;
+        return DateOnly.TryParseExact(s, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var d)
+            ? d
+            : throw new ValidationException("dueDate must be a YYYY-MM-DD date");
+    }
+
     public Todo? Update(int id, TodoPatch patch)
     {
         var title = patch.Title?.Trim();
@@ -44,7 +60,14 @@ public class TodoStore
         lock (_lock)
         {
             if (!_todos.TryGetValue(id, out var todo)) return null;
-            todo = todo with { Title = title ?? todo.Title, Done = patch.Done ?? todo.Done };
+            var dueDate = patch.DueDate.ValueKind switch
+            {
+                JsonValueKind.Undefined => todo.DueDate, // field absent: unchanged
+                JsonValueKind.Null => null, // explicit null: clear
+                JsonValueKind.String => ParseDueDate(patch.DueDate.GetString()),
+                _ => throw new ValidationException("dueDate must be a YYYY-MM-DD string or null"),
+            };
+            todo = todo with { Title = title ?? todo.Title, Done = patch.Done ?? todo.Done, DueDate = dueDate };
             _todos[id] = todo;
             return todo;
         }
