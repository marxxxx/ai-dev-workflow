+test('creates a todo with a due date', () =>
+  withServer(async (base) => {
+    const created = await fetch(`${base}/todos`, json('POST', { title: 'Bericht', dueDate: '2026-11-01' }));
+    assert.equal(created.status, 201);
+    assert.deepEqual(await created.json(), { id: 1, title: 'Bericht', done: false, dueDate: '2026-11-01' });
+  }));
+
+test('creates a todo without a due date (dueDate defaults to null)', () =>
+  withServer(async (base) => {
+    const created = await fetch(`${base}/todos`, json('POST', { title: 'A' }));
+    assert.equal((await created.json()).dueDate, null);
+  }));
+
+test('rejects invalid due dates', () =>
+  withServer(async (base) => {
+    for (const dueDate of ['2026-13-01', '2026-02-30', '01.11.2026', '2026-11-01T10:00:00Z', 42]) {
+      const res = await fetch(`${base}/todos`, json('POST', { title: 'A', dueDate }));
+      assert.equal(res.status, 400, `dueDate=${JSON.stringify(dueDate)} should be rejected`);
+    }
+  }));
+
+test('updates and clears the due date via PATCH', () =>
+  withServer(async (base) => {
+    await fetch(`${base}/todos`, json('POST', { title: 'A' }));
+    const set = await fetch(`${base}/todos/1`, json('PATCH', { dueDate: '2026-12-24' }));
+    assert.equal((await set.json()).dueDate, '2026-12-24');
+    const cleared = await fetch(`${base}/todos/1`, json('PATCH', { dueDate: null }));
+    assert.equal((await cleared.json()).dueDate, null);
+    const invalid = await fetch(`${base}/todos/1`, json('PATCH', { dueDate: 'gestern' }));
+    assert.equal(invalid.status, 400);
+  }));
+
+test('GET /todos?overdue=true returns only overdue todos', () =>
+  withServer(async (base) => {
+    const today = new Date().toISOString().slice(0, 10);
+    const yesterday = new Date(Date.now() - 86400000).toISOString().slice(0, 10);
+    const tomorrow = new Date(Date.now() + 86400000).toISOString().slice(0, 10);
+    await fetch(`${base}/todos`, json('POST', { title: 'overdue', dueDate: yesterday }));
+    await fetch(`${base}/todos`, json('POST', { title: 'due today', dueDate: today }));
+    await fetch(`${base}/todos`, json('POST', { title: 'future', dueDate: tomorrow }));
+    await fetch(`${base}/todos`, json('POST', { title: 'no date' }));
+    await fetch(`${base}/todos`, json('POST', { title: 'done overdue', dueDate: yesterday }));
+    await fetch(`${base}/todos/5`, json('PATCH', { done: true }));
+    const res = await fetch(`${base}/todos?overdue=true`);
+    assert.equal(res.status, 200);
+    const list = await res.json();
+    assert.deepEqual(list.map((t) => t.title), ['overdue']);
+  }));
+
+test('GET /todos without params still returns all todos', () =>
+  withServer(async (base) => {
+    await fetch(`${base}/todos`, json('POST', { title: 'A', dueDate: '2020-01-01' }));
+    await fetch(`${base}/todos`, json('POST', { title: 'B' }));
+    const list = await (await fetch(`${base}/todos`)).json();
+    assert.equal(list.length, 2);
+  }));
+
 test('serves the list page', () =>
