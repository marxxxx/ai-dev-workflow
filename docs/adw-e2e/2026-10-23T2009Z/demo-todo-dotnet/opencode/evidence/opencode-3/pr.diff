diff --git a/src/DemoTodo/TodoStore.cs b/src/DemoTodo/TodoStore.cs
index c5509e1..fe3bf3c 100644
--- a/src/DemoTodo/TodoStore.cs
+++ b/src/DemoTodo/TodoStore.cs
@@ -1,12 +1,39 @@
 using System.ComponentModel.DataAnnotations;
+using System.Text.Json;
+using System.Text.Json.Serialization;
 
 namespace DemoTodo;
 
-public record Todo(int Id, string Title, bool Done);
+public record Todo(int Id, string Title, bool Done, DateOnly? DueDate = null);
 
-public record NewTodo(string? Title);
+public record NewTodo(string? Title, DateOnly? DueDate = null);
 
-public record TodoPatch(string? Title, bool? Done);
+public record TodoPatch(string? Title, bool? Done, DateOnly? DueDate = null, bool DueDateProvided = false);
+
+// Sets DueDateProvided when the JSON body contains a "dueDate" field (value or null),
+// so PATCH can distinguish "field absent" (keep) from "dueDate": null (clear).
+public class TodoPatchJsonConverter : JsonConverter<TodoPatch>
+{
+    public override TodoPatch? Read(ref Utf8JsonReader reader, Type typeToConvert, JsonSerializerOptions options)
+    {
+        using var doc = JsonDocument.ParseValue(ref reader);
+        var root = doc.RootElement;
+        string? title = root.TryGetProperty("title", out var t) && t.ValueKind == JsonValueKind.String ? t.GetString() : null;
+        bool? done = root.TryGetProperty("done", out var d) && (d.ValueKind == JsonValueKind.True || d.ValueKind == JsonValueKind.False)
+            ? d.GetBoolean()
+            : null;
+        DateOnly? dueDate = null;
+        var dueDateProvided = root.TryGetProperty("dueDate", out var dd);
+        if (dueDateProvided && dd.ValueKind == JsonValueKind.String)
+            dueDate = dd.Deserialize<DateOnly>(options);
+        return new TodoPatch(title, done, dueDate, dueDateProvided);
+    }
+
+    public override void Write(Utf8JsonWriter writer, TodoPatch value, JsonSerializerOptions options)
+    {
+        JsonSerializer.Serialize(writer, (object)value, options);
+    }
+}
 
