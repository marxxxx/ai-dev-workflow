diff --git a/src/DemoTodo/Program.cs b/src/DemoTodo/Program.cs
index fd7934d..3842144 100644
--- a/src/DemoTodo/Program.cs
+++ b/src/DemoTodo/Program.cs
@@ -55,8 +55,22 @@ todos.MapPost("", (NewTodo input, TodoStore store) =>
 });
 todos.MapGet("/{id:int}", (int id, TodoStore store) =>
     store.Get(id) is { } todo ? Results.Ok(todo) : NotFound());
-todos.MapPatch("/{id:int}", (int id, TodoPatch patch, TodoStore store) =>
-    store.Update(id, patch) is { } todo ? Results.Ok(todo) : NotFound());
+todos.MapPatch("/{id:int}", async (int id, HttpRequest request, TodoStore store) =>
+{
+    using var doc = await System.Text.Json.JsonDocument.ParseAsync(request.Body);
+    var root = doc.RootElement;
+    string? title = root.TryGetProperty("title", out var t) && t.ValueKind == System.Text.Json.JsonValueKind.String
+        ? t.GetString() : null;
+    bool? done = root.TryGetProperty("done", out var d) &&
+        (d.ValueKind == System.Text.Json.JsonValueKind.True || d.ValueKind == System.Text.Json.JsonValueKind.False)
+        ? d.GetBoolean() : null;
+    DateOnly? dueDate = null;
+    var dueDateSet = root.TryGetProperty("dueDate", out var dd);
+    if (dueDateSet && dd.ValueKind == System.Text.Json.JsonValueKind.String)
+        dueDate = DateOnly.Parse(dd.GetString()!, System.Globalization.CultureInfo.InvariantCulture);
+    var patch = new TodoPatch(title, done, dueDate, dueDateSet);
+    return store.Update(id, patch) is { } todo ? Results.Ok(todo) : NotFound();
+});
 todos.MapDelete("/{id:int}", (int id, TodoStore store) =>
     store.Remove(id) ? Results.NoContent() : NotFound());
 
