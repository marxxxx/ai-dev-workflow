+function isValidDate(value) {
+  if (typeof value !== 'string') return false;
+  const match = value.match(/^(\d{4})-(\d{2})-(\d{2})$/);
+  if (!match) return false;
+  const [, y, m, d] = match;
+  const date = new Date(Date.UTC(Number(y), Number(m) - 1, Number(d)));
+  return (
+    date.getUTCFullYear() === Number(y) &&
+    date.getUTCMonth() === Number(m) - 1 &&
+    date.getUTCDate() === Number(d)
+  );
+}
+
+function todayUtc() {
+  return new Date().toISOString().slice(0, 10);
+}
+
 // In-memory todo store.
 export function createStore() {
   const todos = new Map();
   let nextId = 1;
   return {
-    list() {
-      return [...todos.values()];
+    list({ overdueOnly = false } = {}) {
+      const all = [...todos.values()];
+      if (!overdueOnly) return all;
+      const today = todayUtc();
+      return all.filter((t) => !t.done && t.dueDate !== undefined && t.dueDate < today);
     },
     get(id) {
       return todos.get(id);
     },
-    add({ title }) {
+    add({ title, dueDate }) {
       if (typeof title !== 'string' || title.trim() === '') {
         throw new ValidationError('title is required');
       }
+      if (dueDate !== undefined && !isValidDate(dueDate)) {
+        throw new ValidationError('dueDate must be a valid YYYY-MM-DD date');
+      }
       const todo = { id: nextId++, title: title.trim(), done: false };
+      if (dueDate !== undefined) todo.dueDate = dueDate;
       todos.set(todo.id, todo);
       return todo;
     },
@@ -30,6 +54,15 @@ export function createStore() {
         if (typeof patch.done !== 'boolean') throw new ValidationError('done must be a boolean');
         todo.done = patch.done;
       }
+      if ('dueDate' in patch) {
