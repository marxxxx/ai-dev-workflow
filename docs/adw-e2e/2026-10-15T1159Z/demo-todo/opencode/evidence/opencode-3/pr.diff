+++ b/test/store.test.mjs
@@ -0,0 +1,55 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createStore, ValidationError } from '../src/store.mjs';
+
+test('add stores a valid dueDate', () => {
+  const store = createStore();
+  const todo = store.add({ title: 'A', dueDate: '2026-10-20' });
+  assert.equal(todo.dueDate, '2026-10-20');
+});
+
+test('add without dueDate leaves the field unset', () => {
+  const store = createStore();
+  const todo = store.add({ title: 'A' });
+  assert.equal('dueDate' in todo, false);
+});
+
+test('add rejects an impossible date like 2026-02-30', () => {
+  const store = createStore();
+  assert.throws(() => store.add({ title: 'A', dueDate: '2026-02-30' }), ValidationError);
+});
+
+test('add rejects a wrong format like 20.10.2026', () => {
+  const store = createStore();
+  assert.throws(() => store.add({ title: 'A', dueDate: '20.10.2026' }), ValidationError);
+});
+
+test('add rejects a datetime string', () => {
+  const store = createStore();
+  assert.throws(() => store.add({ title: 'A', dueDate: '2026-10-20T17:00:00Z' }), ValidationError);
+});
+
+test('add rejects a non-string dueDate', () => {
+  const store = createStore();
+  assert.throws(() => store.add({ title: 'A', dueDate: 20261020 }), ValidationError);
+});
+
+test('update changes the dueDate', () => {
+  const store = createStore();
+  store.add({ title: 'A', dueDate: '2026-10-20' });
+  const todo = store.update(1, { dueDate: '2026-11-01' });
+  assert.equal(todo.dueDate, '2026-11-01');
+});
+
+test('update with dueDate null removes the date', () => {
+  const store = createStore();
+  store.add({ title: 'A', dueDate: '2026-10-20' });
+  const todo = store.update(1, { dueDate: null });
+  assert.equal('dueDate' in todo, false);
+});
+
+test('update rejects an invalid dueDate', () => {
+  const store = createStore();
+  store.add({ title: 'A' });
+  assert.throws(() => store.update(1, { dueDate: '2026-13-01' }), ValidationError);
+});
