+    const overdueOnly = document.querySelector('[data-testid="overdue-only"]');
+    const todayUtc = new Date().toISOString().slice(0, 10);
+
+    function isOverdue(todo) {
+      return !todo.done && todo.dueDate !== undefined && todo.dueDate < todayUtc;
     }
+
+    function formatDate(iso) {
+      const [y, m, d] = iso.split('-');
+      return `${d}.${m}.${y}`;
+    }
+
+    function render(todos) {
+      list.replaceChildren();
+      for (const todo of todos) {
+        const li = document.createElement('li');
+        li.dataset.testid = 'todo-item';
+        const title = document.createElement('span');
+        title.dataset.testid = 'todo-title';
+        title.textContent = todo.title + (todo.done ? ' ✓' : '');
+        li.append(title);
+        if (todo.dueDate !== undefined) {
+          const due = document.createElement('span');
+          due.dataset.testid = 'todo-due-date';
+          due.textContent = ` fällig: ${formatDate(todo.dueDate)}`;
+          li.append(due);
+        }
+        if (isOverdue(todo)) {
+          const badge = document.createElement('span');
+          badge.dataset.testid = 'todo-overdue';
+          badge.textContent = ' überfällig';
+          li.append(badge);
+        }
+        list.append(li);
+      }
+    }
+
+    async function load() {
+      const todos = await (await fetch('/todos')).json();
+      render(overdueOnly.checked ? todos.filter(isOverdue) : todos);
+    }
+
+    overdueOnly.addEventListener('change', load);
+    await load();
   </script>
 </body>
 </html>
