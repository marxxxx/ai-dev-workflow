@@ -1,4 +1,22 @@
 // In-memory todo store.
+const DATE_RE = /^(\d{4})-(\d{2})-(\d{2})$/;
+
+function isValidDate(value) {
+  if (value === null) return true;
+  if (typeof value !== 'string') return false;
+  const match = DATE_RE.exec(value);
+  if (!match) return false;
+  const [, y, m, d] = match.map(Number);
+  const date = new Date(Date.UTC(y, m - 1, d));
+  return (
+    date.getUTCFullYear() === y && date.getUTCMonth() === m - 1 && date.getUTCDate() === d
+  );
+}
+
+function todayUtc() {
+  return new Date().toISOString().slice(0, 10);
+}
+
 export function createStore() {
   const todos = new Map();
   let nextId = 1;
@@ -9,11 +27,14 @@ export function createStore() {
     get(id) {
       return todos.get(id);
     },
-    add({ title }) {
+    add({ title, dueDate = null }) {
       if (typeof title !== 'string' || title.trim() === '') {
         throw new ValidationError('title is required');
       }
-      const todo = { id: nextId++, title: title.trim(), done: false };
+      if (!isValidDate(dueDate)) {
+        throw new ValidationError('dueDate must be a valid date in YYYY-MM-DD format or null');
+      }
+      const todo = { id: nextId++, title: title.trim(), done: false, dueDate };
       todos.set(todo.id, todo);
       return todo;
     },
@@ -30,11 +51,25 @@ export function createStore() {
         if (typeof patch.done !== 'boolean') throw new ValidationError('done must be a boolean');
         todo.done = patch.done;
       }
+      if ('dueDate' in patch) {
+        if (!isValidDate(patch.dueDate)) {
+          throw new ValidationError('dueDate must be a valid date in YYYY-MM-DD format or null');
+        }
+        todo.dueDate = patch.dueDate;
+      }
       return todo;
     },
     remove(id) {
       return todos.delete(id);
     },
+    isOverdue(id) {
+      const todo = todos.get(id);
+      if (!todo || todo.done || !todo.dueDate) return false;
+      return todo.dueDate < todayUtc();
+    },
+    listOverdue() {
+      return [...todos.values()].filter((todo) => !todo.done && todo.dueDate && todo.dueDate < todayUtc());
+    },
   };
 }
 
