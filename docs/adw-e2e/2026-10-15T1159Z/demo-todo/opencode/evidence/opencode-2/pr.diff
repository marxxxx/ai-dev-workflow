+
+test('creates a todo with a due date', () =>
+  withServer(async (base) => {
+    const res = await fetch(`${base}/todos`, json('POST', { title: 'A', dueDate: '2026-10-20' }));
+    assert.equal(res.status, 201);
+    assert.equal((await res.json()).dueDate, '2026-10-20');
+  }));
+
+test('rejects an invalid due date with 400', () =>
+  withServer(async (base) => {
+    for (const dueDate of ['20.10.2026', '2026-02-30', '2026-13-01', '2026-10-20T10:00:00Z']) {
+      const res = await fetch(`${base}/todos`, json('POST', { title: 'A', dueDate }));
+      assert.equal(res.status, 400, `expected 400 for ${dueDate}`);
+    }
+  }));
+
+test('updates and removes the due date via PATCH', () =>
+  withServer(async (base) => {
+    await fetch(`${base}/todos`, json('POST', { title: 'A' }));
+    const set = await fetch(`${base}/todos/1`, json('PATCH', { dueDate: '2026-10-20' }));
+    assert.equal((await set.json()).dueDate, '2026-10-20');
+    const removed = await fetch(`${base}/todos/1`, json('PATCH', { dueDate: null }));
+    assert.equal((await removed.json()).dueDate, null);
+    const invalid = await fetch(`${base}/todos/1`, json('PATCH', { dueDate: '2026-02-30' }));
+    assert.equal(invalid.status, 400);
+  }));
+
+test('GET /todos?overdue=true returns only overdue todos', () =>
+  withServer(async (base) => {
+    const yesterday = new Date(Date.now() - 86400000).toISOString().slice(0, 10);
+    const tomorrow = new Date(Date.now() + 86400000).toISOString().slice(0, 10);
+    await fetch(`${base}/todos`, json('POST', { title: 'overdue', dueDate: yesterday }));
+    await fetch(`${base}/todos`, json('POST', { title: 'future', dueDate: tomorrow }));
+    await fetch(`${base}/todos`, json('POST', { title: 'no date' }));
+    await fetch(`${base}/todos`, json('POST', { title: 'done overdue', dueDate: yesterday }));
+    await fetch(`${base}/todos/4`, json('PATCH', { done: true }));
+
+    const res = await fetch(`${base}/todos?overdue=true`);
+    assert.equal(res.status, 200);
+    const list = await res.json();
+    assert.deepEqual(list.map((t) => t.title), ['overdue']);
+
+    const all = await (await fetch(`${base}/todos`)).json();
+    assert.equal(all.length, 4);
+  }));
diff --git a/test/store.test.mjs b/test/store.test.mjs
new file mode 100644
index 0000000..5f2454f
--- /dev/null
+++ b/test/store.test.mjs
@@ -0,0 +1,96 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createStore, ValidationError } from '../src/store.mjs';
+
+test('adds a todo with a due date', () => {
+  const store = createStore();
+  const todo = store.add({ title: 'A', dueDate: '2026-10-20' });
+  assert.equal(todo.dueDate, '2026-10-20');
+  assert.equal(todo.done, false);
+});
+
+test('adds a todo without a due date', () => {
+  const store = createStore();
+  const todo = store.add({ title: 'A' });
+  assert.equal(todo.dueDate, null);
+});
+
+test('rejects a due date with the wrong format', () => {
+  const store = createStore();
+  assert.throws(() => store.add({ title: 'A', dueDate: '20.10.2026' }), ValidationError);
+  assert.throws(() => store.add({ title: 'A', dueDate: '2026-10-20T10:00:00Z' }), ValidationError);
+  assert.throws(() => store.add({ title: 'A', dueDate: '2026-13-01' }), ValidationError);
+});
+
+test('rejects a due date that is not a real calendar day', () => {
+  const store = createStore();
+  assert.throws(() => store.add({ title: 'A', dueDate: '2026-02-30' }), ValidationError);
+  assert.throws(() => store.add({ title: 'A', dueDate: '2026-02-29' }), ValidationError);
+});
+
+test('accepts 2028-02-29 (leap year)', () => {
+  const store = createStore();
+  const todo = store.add({ title: 'A', dueDate: '2028-02-29' });
+  assert.equal(todo.dueDate, '2028-02-29');
+});
+
+test('rejects a non-string due date', () => {
+  const store = createStore();
+  assert.throws(() => store.add({ title: 'A', dueDate: 20261020 }), ValidationError);
+});
+
+test('updates and removes the due date', () => {
+  const store = createStore();
+  store.add({ title: 'A' });
+  const updated = store.update(1, { dueDate: '2026-10-20' });
+  assert.equal(updated.dueDate, '2026-10-20');
+  const removed = store.update(1, { dueDate: null });
+  assert.equal(removed.dueDate, null);
+});
+
+test('rejects an invalid due date on update', () => {
+  const store = createStore();
+  store.add({ title: 'A' });
+  assert.throws(() => store.update(1, { dueDate: '2026-02-30' }), ValidationError);
+  assert.throws(() => store.update(1, { dueDate: 'not-a-date' }), ValidationError);
+});
+
+test('isOverdue: not done and due date before today (UTC)', () => {
+  const store = createStore();
+  const yesterday = new Date(Date.now() - 86400000).toISOString().slice(0, 10);
+  const today = new Date().toISOString().slice(0, 10);
+  const tomorrow = new Date(Date.now() + 86400000).toISOString().slice(0, 10);
+
+  const overdue = store.add({ title: 'A', dueDate: yesterday });
+  const dueToday = store.add({ title: 'B', dueDate: today });
+  const future = store.add({ title: 'C', dueDate: tomorrow });
+  const noDate = store.add({ title: 'D' });
+
+  assert.equal(store.isOverdue(overdue.id), true);
+  assert.equal(store.isOverdue(dueToday.id), false);
+  assert.equal(store.isOverdue(future.id), false);
+  assert.equal(store.isOverdue(noDate.id), false);
+});
+
+test('isOverdue: done todos are never overdue', () => {
+  const store = createStore();
+  const yesterday = new Date(Date.now() - 86400000).toISOString().slice(0, 10);
+  const todo = store.add({ title: 'A', dueDate: yesterday });
+  store.update(todo.id, { done: true });
+  assert.equal(store.isOverdue(todo.id), false);
+});
+
+test('listOverdue returns only overdue todos', () => {
+  const store = createStore();
+  const yesterday = new Date(Date.now() - 86400000).toISOString().slice(0, 10);
+  const tomorrow = new Date(Date.now() + 86400000).toISOString().slice(0, 10);
+
+  store.add({ title: 'overdue', dueDate: yesterday });
+  store.add({ title: 'future', dueDate: tomorrow });
+  store.add({ title: 'no date' });
+  const done = store.add({ title: 'done overdue', dueDate: yesterday });
+  store.update(done.id, { done: true });
+
+  const overdue = store.listOverdue();
+  assert.deepEqual(overdue.map((t) => t.title), ['overdue']);
+});
