 // In-memory todo store.
+const DATE_RE = /^\d{4}-\d{2}-\d{2}$/;
+
+function parseDueDate(value) {
+  if (typeof value !== 'string' || !DATE_RE.test(value)) {
+    throw new ValidationError('dueDate must be a date in YYYY-MM-DD format');
+  }
+  const [y, m, d] = value.split('-').map(Number);
+  const date = new Date(Date.UTC(y, m - 1, d));
+  if (date.getUTCFullYear() !== y || date.getUTCMonth() !== m - 1 || date.getUTCDate() !== d) {
+    throw new ValidationError('dueDate must be a valid calendar date');
+  }
+  return value;
+}
+
+export function isOverdue(todo, today = new Date().toISOString().slice(0, 10)) {
+  return !todo.done && todo.dueDate !== null && todo.dueDate < today;
+}
+
