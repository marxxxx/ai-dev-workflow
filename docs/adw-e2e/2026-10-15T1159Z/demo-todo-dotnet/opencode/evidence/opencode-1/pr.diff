+
+    [Fact]
+    public async Task CreatesATodoWithADueDate()
+    {
+        var created = await _client.PostAsJsonAsync("/todos", new { title = "A", dueDate = "2026-10-20" });
+        Assert.Equal(HttpStatusCode.Created, created.StatusCode);
+        var todo = await created.Content.ReadFromJsonAsync<Todo>();
+        Assert.Equal(new DateOnly(2026, 10, 20), todo!.DueDate);
+    }
+
+    [Fact]
+    public async Task CreatesATodoWithoutADueDate()
+    {
+        var created = await _client.PostAsJsonAsync("/todos", new { title = "A" });
+        var todo = await created.Content.ReadFromJsonAsync<Todo>();
+        Assert.Null(todo!.DueDate);
+    }
+
+    [Fact]
+    public async Task RejectsAnInvalidDueDate()
+    {
+        var res = await _client.PostAsJsonAsync("/todos", new { title = "A", dueDate = "2026-02-30" });
+        Assert.Equal(HttpStatusCode.BadRequest, res.StatusCode);
+        var body = await res.Content.ReadAsStringAsync();
+        Assert.Contains("error", body);
+    }
+
+    [Fact]
+    public async Task RejectsAMalformedDueDate()
+    {
+        var res = await _client.PostAsJsonAsync("/todos", new { title = "A", dueDate = "not-a-date" });
+        Assert.Equal(HttpStatusCode.BadRequest, res.StatusCode);
+    }
+
+    [Fact]
+    public async Task SetsChangesAndRemovesTheDueDate()
+    {
+        await _client.PostAsJsonAsync("/todos", new { title = "A" });
+        var set = await _client.PatchAsJsonAsync("/todos/1", new { dueDate = "2026-10-20" });
+        Assert.Equal(new DateOnly(2026, 10, 20), (await set.Content.ReadFromJsonAsync<Todo>())!.DueDate);
+        var changed = await _client.PatchAsJsonAsync("/todos/1", new { dueDate = "2026-11-01" });
+        Assert.Equal(new DateOnly(2026, 11, 1), (await changed.Content.ReadFromJsonAsync<Todo>())!.DueDate);
+        var removed = await _client.PatchAsJsonAsync("/todos/1", new { clearDueDate = true });
+        Assert.Null((await removed.Content.ReadFromJsonAsync<Todo>())!.DueDate);
+    }
+
+    [Fact]
+    public async Task RejectsAnInvalidDueDateOnPatch()
+    {
+        await _client.PostAsJsonAsync("/todos", new { title = "A" });
+        var res = await _client.PatchAsJsonAsync("/todos/1", new { dueDate = "2026-02-30" });
+        Assert.Equal(HttpStatusCode.BadRequest, res.StatusCode);
+    }
+
+    [Fact]
+    public async Task FiltersOverdueTodos()
+    {
+        var yesterday = DateOnly.FromDateTime(DateTime.UtcNow).AddDays(-1).ToString("yyyy-MM-dd");
+        var tomorrow = DateOnly.FromDateTime(DateTime.UtcNow).AddDays(1).ToString("yyyy-MM-dd");
+        await _client.PostAsJsonAsync("/todos", new { title = "overdue", dueDate = yesterday });
+        await _client.PostAsJsonAsync("/todos", new { title = "future", dueDate = tomorrow });
+        await _client.PostAsJsonAsync("/todos", new { title = "no date" });
+        var res = await _client.GetAsync("/todos?overdue=true");
+        Assert.Equal(HttpStatusCode.OK, res.StatusCode);
+        var todos = await res.Content.ReadFromJsonAsync<Todo[]>();
+        Assert.Equal(["overdue"], todos!.Select(t => t.Title).ToArray());
+    }
+
+    [Fact]
+    public async Task AnOverdueFilterExcludesDoneTodos()
+    {
+        var yesterday = DateOnly.FromDateTime(DateTime.UtcNow).AddDays(-1).ToString("yyyy-MM-dd");
+        await _client.PostAsJsonAsync("/todos", new { title = "done overdue", dueDate = yesterday });
+        await _client.PatchAsJsonAsync("/todos/1", new { done = true });
+        var res = await _client.GetAsync("/todos?overdue=true");
+        var todos = await res.Content.ReadFromJsonAsync<Todo[]>();
+        Assert.Empty(todos!);
+    }
+
+    [Fact]
+    public async Task ServesTheListPageWithDueDatesAndTheOverdueToggle()
+    {
+        await _client.PostAsJsonAsync("/todos", new { title = "A", dueDate = "2026-10-20" });
+        var res = await _client.GetAsync("/");
+        Assert.Equal(HttpStatusCode.OK, res.StatusCode);
+        var html = await res.Content.ReadAsStringAsync();
+        Assert.Contains("data-testid=\"todo-due-date\"", html);
+        Assert.Contains("2026-10-20", html);
+        Assert.Contains("data-testid=\"overdue-only-toggle\"", html);
+    }
 }
