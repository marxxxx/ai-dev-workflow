+
+    [Fact]
+    public async Task CreatesATodoWithADueDate()
+    {
+        var created = await _client.PostAsJsonAsync("/todos", new { title = "A", dueDate = "2026-10-20" });
+        Assert.Equal(HttpStatusCode.Created, created.StatusCode);
+        var todo = await created.Content.ReadFromJsonAsync<Todo>();
+        Assert.Equal(new DateOnly(2026, 10, 20), todo!.DueDate);
+    }
+
+    [Fact]
+    public async Task PatchesTheDueDate()
+    {
+        await _client.PostAsJsonAsync("/todos", new { title = "A" });
+        var set = await _client.PatchAsJsonAsync("/todos/1", new { dueDate = "2026-10-20" });
+        Assert.Equal(new DateOnly(2026, 10, 20), (await set.Content.ReadFromJsonAsync<Todo>())!.DueDate);
+        var cleared = await _client.PatchAsJsonAsync("/todos/1", new { clearDueDate = true });
+        Assert.Null((await cleared.Content.ReadFromJsonAsync<Todo>())!.DueDate);
+    }
+
+    [Fact]
+    public async Task RejectsAnInvalidDueDate()
+    {
+        var badFormat = await _client.PostAsJsonAsync("/todos", new { title = "A", dueDate = "20.10.2026" });
+        Assert.Equal(HttpStatusCode.BadRequest, badFormat.StatusCode);
+        var impossible = await _client.PostAsJsonAsync("/todos", new { title = "A", dueDate = "2026-02-30" });
+        Assert.Equal(HttpStatusCode.BadRequest, impossible.StatusCode);
+        await _client.PostAsJsonAsync("/todos", new { title = "A" });
+        var patchBad = await _client.PatchAsJsonAsync("/todos/1", new { dueDate = "morgen" });
+        Assert.Equal(HttpStatusCode.BadRequest, patchBad.StatusCode);
+    }
+
+    [Fact]
+    public async Task FiltersOverdueTodos()
+    {
+        var yesterday = DateOnly.FromDateTime(DateTime.UtcNow).AddDays(-1).ToString("yyyy-MM-dd");
+        var tomorrow = DateOnly.FromDateTime(DateTime.UtcNow).AddDays(1).ToString("yyyy-MM-dd");
+        await _client.PostAsJsonAsync("/todos", new { title = "overdue", dueDate = yesterday });
+        await _client.PostAsJsonAsync("/todos", new { title = "done overdue", dueDate = yesterday });
+        await _client.PatchAsJsonAsync("/todos/2", new { done = true });
+        await _client.PostAsJsonAsync("/todos", new { title = "future", dueDate = tomorrow });
+        await _client.PostAsJsonAsync("/todos", new { title = "no date" });
+        var res = await _client.GetAsync("/todos?overdue=true");
+        var todos = await res.Content.ReadFromJsonAsync<List<Todo>>();
+        Assert.Equal("overdue", Assert.Single(todos!).Title);
+    }
+
+    [Fact]
+    public async Task TheListPageShowsDueDatesAndOverdueMarkers()
+    {
+        var yesterday = DateOnly.FromDateTime(DateTime.UtcNow).AddDays(-1).ToString("yyyy-MM-dd");
+        await _client.PostAsJsonAsync("/todos", new { title = "Überfällig", dueDate = yesterday });
+        await _client.PostAsJsonAsync("/todos", new { title = "Normal" });
+        var html = await _client.GetStringAsync("/");
+        Assert.Contains("data-testid=\"todo-overdue\"", html);
+        Assert.Contains("überfällig", html);
+        Assert.Contains("data-testid=\"overdue-only-toggle\"", html);
+        var yesterdayDisplay = DateOnly.FromDateTime(DateTime.UtcNow).AddDays(-1).ToString("dd.MM.yyyy");
+        Assert.Contains(yesterdayDisplay, html);
+    }
 }
