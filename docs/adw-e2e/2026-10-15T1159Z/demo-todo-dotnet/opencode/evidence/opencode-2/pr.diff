@@ -6,11 +6,31 @@
 
 <h1>Todos</h1>
 
+<label>
+    <input type="checkbox" data-testid="overdue-only-toggle" @bind="_overdueOnly" />
+    nur überfällige
+</label>
+
 <ul data-testid="todo-list">
-    @foreach (var todo in Store.List())
+    @foreach (var todo in Store.List(overdueOnly: _overdueOnly))
     {
         <li data-testid="todo-item">
             <span data-testid="todo-title">@todo.Title@(todo.Done ? " ✓" : "")</span>
+            @if (todo.DueDate is { } dueDate)
+            {
+                <span data-testid="todo-due-date">(fällig: @dueDate.ToString("dd.MM.yyyy"))</span>
+            }
+            @if (IsOverdue(todo))
