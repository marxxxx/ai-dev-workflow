+            }
         </li>
     }
 </ul>
+
+@code {
+    private bool _overdueOnly;
+
+    private static bool IsOverdue(Todo todo) =>
+        !todo.Done && todo.DueDate is { } due && due < DateOnly.FromDateTime(DateTime.UtcNow);
+}
