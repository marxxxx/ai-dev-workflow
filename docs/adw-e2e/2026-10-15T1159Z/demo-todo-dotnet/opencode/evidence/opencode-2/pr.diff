+
+    [Fact]
+    public void AddsTodoWithDueDate()
+    {
+        var store = new TodoStore();
+        var todo = store.Add(new NewTodo("A", new DateOnly(2026, 10, 20)));
+        Assert.Equal(new Todo(1, "A", false, new DateOnly(2026, 10, 20)), todo);
+    }
+
+    [Fact]
+    public void UpdatesAndClearsTheDueDate()
+    {
+        var store = new TodoStore();
+        var todo = store.Add(new NewTodo("A"));
+        var withDate = store.Update(todo.Id, new TodoPatch(null, null, new DateOnly(2026, 10, 20)));
+        Assert.Equal(new DateOnly(2026, 10, 20), withDate!.DueDate);
+        var cleared = store.Update(todo.Id, new TodoPatch(null, null, null, ClearDueDate: true));
+        Assert.Null(cleared!.DueDate);
+    }
+
+    [Fact]
+    public void ListsOnlyOverdueTodosWhenFiltered()
+    {
+        var store = new TodoStore();
+        var yesterday = DateOnly.FromDateTime(DateTime.UtcNow).AddDays(-1);
+        var tomorrow = DateOnly.FromDateTime(DateTime.UtcNow).AddDays(1);
+        store.Add(new NewTodo("overdue", yesterday));
+        store.Add(new NewTodo("done overdue", yesterday, Done: true));
+        store.Add(new NewTodo("future", tomorrow));
+        store.Add(new NewTodo("no date"));
+        var overdue = store.List(overdueOnly: true);
+        Assert.Equal([new Todo(1, "overdue", false, yesterday)], overdue);
+    }
 }
