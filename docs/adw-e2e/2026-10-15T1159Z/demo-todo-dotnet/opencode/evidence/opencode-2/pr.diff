diff --git a/tests/DemoTodo.Tests/HomePageTests.cs b/tests/DemoTodo.Tests/HomePageTests.cs
new file mode 100644
index 0000000..e110c14
--- /dev/null
+++ b/tests/DemoTodo.Tests/HomePageTests.cs
@@ -0,0 +1,43 @@
+using System.Net.Http.Json;
+using Microsoft.AspNetCore.Mvc.Testing;
+
+namespace DemoTodo.Tests;
+
+// The page is prerendered, so the initial HTML already contains the todos.
+public class HomePageTests : IDisposable
+{
+    private readonly WebApplicationFactory<Program> _factory = new();
+    private readonly HttpClient _client;
+
+    public HomePageTests() => _client = _factory.CreateClient();
+
+    public void Dispose() => _factory.Dispose();
+
+    [Fact]
+    public async Task ShowsTheDueDateNextToTheTitle()
+    {
+        await _client.PostAsJsonAsync("/todos", new { title = "Milch kaufen", dueDate = "2026-10-20" });
+        var html = await (await _client.GetAsync("/")).Content.ReadAsStringAsync();
+        Assert.Contains("data-testid=\"todo-due-date\"", html);
+        Assert.Contains("20.10.2026", html);
+    }
+
+    [Fact]
+    public async Task MarksOverdueTodos()
+    {
+        var yesterday = DateOnly.FromDateTime(DateTime.UtcNow).AddDays(-1).ToString("yyyy-MM-dd");
+        await _client.PostAsJsonAsync("/todos", new { title = "Überfällig", dueDate = yesterday });
+        await _client.PostAsJsonAsync("/todos", new { title = "Nicht überfällig" });
+        var html = await (await _client.GetAsync("/")).Content.ReadAsStringAsync();
+        Assert.Contains("data-testid=\"todo-overdue\"", html);
+        Assert.Contains("überfällig", html);
+    }
+
+    [Fact]
+    public async Task HasAnOverdueOnlyToggle()
+    {
+        var html = await (await _client.GetAsync("/")).Content.ReadAsStringAsync();
+        Assert.Contains("data-testid=\"overdue-only-toggle\"", html);
+        Assert.Contains("nur überfällige", html);
+    }
+}
diff --git a/tests/DemoTodo.Tests/TodoApiTests.cs b/tests/DemoTodo.Tests/TodoApiTests.cs
index f20e459..8db1d61 100644
--- a/tests/DemoTodo.Tests/TodoApiTests.cs
+++ b/tests/DemoTodo.Tests/TodoApiTests.cs
@@ -62,4 +62,46 @@ public class TodoApiTests : IDisposable
         Assert.Contains("data-testid=\"todo-list\"", html);
         Assert.Contains("Milch kaufen", html);
     }
+
+    [Fact]
+    public async Task CreatesTodoWithDueDate()
+    {
+        var created = await _client.PostAsJsonAsync("/todos", new { title = "A", dueDate = "2026-10-20" });
+        Assert.Equal(HttpStatusCode.Created, created.StatusCode);
+        var todo = await created.Content.ReadFromJsonAsync<Todo>();
+        Assert.Equal(new DateOnly(2026, 10, 20), todo!.DueDate);
+    }
+
+    [Fact]
+    public async Task RejectsAnInvalidDueDate()
+    {
+        var res = await _client.PostAsJsonAsync("/todos", new { title = "A", dueDate = "2026-02-30" });
+        Assert.Equal(HttpStatusCode.BadRequest, res.StatusCode);
+        var res2 = await _client.PostAsJsonAsync("/todos", new { title = "A", dueDate = "20.10.2026" });
+        Assert.Equal(HttpStatusCode.BadRequest, res2.StatusCode);
+    }
+
+    [Fact]
+    public async Task UpdatesAndClearsTheDueDate()
+    {
+        await _client.PostAsJsonAsync("/todos", new { title = "A" });
+        var patched = await _client.PatchAsJsonAsync("/todos/1", new { dueDate = "2026-10-20" });
+        Assert.Equal(new DateOnly(2026, 10, 20), (await patched.Content.ReadFromJsonAsync<Todo>())!.DueDate);
+        var cleared = await _client.PatchAsJsonAsync("/todos/1", new { dueDate = (string?)null });
+        Assert.Null((await cleared.Content.ReadFromJsonAsync<Todo>())!.DueDate);
+    }
+
+    [Fact]
+    public async Task FiltersOverdueTodos()
+    {
+        var yesterday = DateOnly.FromDateTime(DateTime.UtcNow).AddDays(-1).ToString("yyyy-MM-dd");
+        var tomorrow = DateOnly.FromDateTime(DateTime.UtcNow).AddDays(1).ToString("yyyy-MM-dd");
+        await _client.PostAsJsonAsync("/todos", new { title = "overdue", dueDate = yesterday });
+        await _client.PostAsJsonAsync("/todos", new { title = "done overdue", dueDate = yesterday, done = true });
+        await _client.PostAsJsonAsync("/todos", new { title = "future", dueDate = tomorrow });
+        await _client.PostAsJsonAsync("/todos", new { title = "no date" });
+        var list = await _client.GetFromJsonAsync<List<Todo>>("/todos?overdue=true");
+        Assert.Single(list!);
+        Assert.Equal("overdue", list![0].Title);
+    }
 }
