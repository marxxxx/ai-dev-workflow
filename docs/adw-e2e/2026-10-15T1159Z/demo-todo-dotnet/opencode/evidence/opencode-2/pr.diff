+todos.MapPatch("/{id:int}", async (int id, HttpRequest request, TodoStore store) =>
+{
+    var json = await request.ReadFromJsonAsync<JsonElement>();
+    string? title = null;
+    bool? done = null;
+    DateOnly? dueDate = null;
+    var clearDueDate = false;
+    if (json.TryGetProperty("title", out var titleEl) && titleEl.ValueKind == JsonValueKind.String)
+        title = titleEl.GetString();
+    if (json.TryGetProperty("done", out var doneEl) && doneEl.ValueKind is JsonValueKind.True or JsonValueKind.False)
+        done = doneEl.GetBoolean();
+    if (json.TryGetProperty("dueDate", out var dueEl))
+    {
+        if (dueEl.ValueKind == JsonValueKind.Null) clearDueDate = true;
+        else if (dueEl.ValueKind == JsonValueKind.String)
+        {
+            if (!DateOnly.TryParseExact(dueEl.GetString(), "yyyy-MM-dd", out var parsed))
+                throw new ValidationException("dueDate must be a valid date in yyyy-MM-dd format");
+            dueDate = parsed;
+        }
+    }
+    var patch = new TodoPatch(title, done, dueDate, clearDueDate);
+    return store.Update(id, patch) is { } todo ? Results.Ok(todo) : NotFound();
+});
 todos.MapDelete("/{id:int}", (int id, TodoStore store) =>
     store.Remove(id) ? Results.NoContent() : NotFound());
 
