+++ b/test/store.test.mjs
@@ -0,0 +1,47 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createStore, ValidationError } from '../src/store.mjs';
+
+test('uses the UTC day and excludes today, future, done, and undated todos', (t) => {
+  t.mock.timers.enable({ apis: ['Date'], now: new Date('2026-10-21T00:30:00Z') });
+  const store = createStore();
+  const cases = [
+    { dueDate: '2026-10-20', overdue: true },
+    { dueDate: '2026-10-21', overdue: false },
+    { dueDate: '2026-10-22', overdue: false },
+    { dueDate: null, overdue: false },
+  ];
+  for (const { dueDate, overdue } of cases) {
+    const todo = store.add({ title: 'A', dueDate });
+    assert.equal(todo.overdue, overdue, String(dueDate));
+  }
+  assert.equal(store.update(1, { done: true }).overdue, false);
+  assert.equal(store.get(1).overdue, false);
+  assert.equal(store.list()[0].overdue, false);
+  assert.equal(store.update(1, { done: false }).overdue, true);
+});
+
+test('recalculates overdue on reads after UTC midnight without a write', (t) => {
+  t.mock.timers.enable({ apis: ['Date'], now: new Date('2026-10-21T23:59:59.999Z') });
+  const store = createStore();
+  const todo = store.add({ title: 'A', dueDate: '2026-10-21' });
+  assert.equal(todo.overdue, false);
+  t.mock.timers.tick(1);
+  assert.equal(store.get(todo.id).overdue, true);
+  assert.equal(store.list()[0].overdue, true);
+  assert.equal(store.update(todo.id, {}).overdue, true);
+});
+
+test('accepts real leap days and four-digit years', () => {
+  const store = createStore();
+  for (const dueDate of ['2000-02-29', '2024-02-29', '0001-01-01', '0099-12-31', '9999-12-31']) {
+    assert.equal(store.add({ title: 'A', dueDate }).dueDate, dueDate);
+  }
+});
+
+test('reports invalid calendar dates as ValidationError', () => {
+  const store = createStore();
+  assert.throws(() => store.add({ title: 'A', dueDate: '1900-02-29' }), ValidationError);
+  const todo = store.add({ title: 'A' });
+  assert.throws(() => store.update(todo.id, { dueDate: '2026-02-30' }), ValidationError);
+});
