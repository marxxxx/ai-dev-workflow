@@ -38,4 +45,19 @@ export function createStore() {
   };
 }
 
+function validateDueDate(dueDate) {
+  if (dueDate === null) return;
+  if (typeof dueDate === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(dueDate)) {
+    const date = new Date(`${dueDate}T00:00:00.000Z`);
+    if (!Number.isNaN(date.getTime()) && date.toISOString().slice(0, 10) === dueDate) return;
+  }
+  throw new ValidationError('dueDate must be a valid date in YYYY-MM-DD format or null');
+}
+
+function withOverdue(todo) {
+  if (!todo) return undefined;
+  const today = new Date().toISOString().slice(0, 10);
+  return { ...todo, overdue: !todo.done && todo.dueDate !== null && todo.dueDate < today };
+}
+
 export class ValidationError extends Error {}
