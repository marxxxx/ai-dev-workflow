+function snapshot(todo, today = new Date().toISOString().slice(0, 10)) {
+  if (!todo) return undefined;
+  return { ...todo, overdue: !todo.done && todo.dueDate !== null && todo.dueDate < today };
+}
+
+function validateDueDate(dueDate) {
+  if (dueDate === null) return;
+  if (typeof dueDate === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(dueDate)) {
+    const parsed = new Date(`${dueDate}T00:00:00.000Z`);
+    if (Number.isFinite(parsed.getTime()) && parsed.toISOString().slice(0, 10) === dueDate) return;
+  }
+  throw new ValidationError('dueDate must be a real date in YYYY-MM-DD format or null');
+}
