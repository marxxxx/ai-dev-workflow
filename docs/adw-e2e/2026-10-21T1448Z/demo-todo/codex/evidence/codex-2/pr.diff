+++ b/test/store.test.mjs
@@ -0,0 +1,64 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createStore, ValidationError } from '../src/store.mjs';
+
+test('uses the UTC date for overdue, excluding today, future and undated todos', (t) => {
+  t.mock.timers.enable({ apis: ['Date'], now: new Date('2026-10-21T00:30:00.000Z') });
+  const store = createStore();
+  const yesterday = store.add({ title: 'Yesterday', dueDate: '2026-10-20' });
+  assert.equal(yesterday.overdue, true);
+  assert.equal(store.add({ title: 'Today', dueDate: '2026-10-21' }).overdue, false);
+  assert.equal(store.add({ title: 'Tomorrow', dueDate: '2026-10-22' }).overdue, false);
+  assert.equal(store.add({ title: 'Null', dueDate: null }).overdue, false);
+  const undated = store.add({ title: 'Omitted' });
+  assert.equal(undated.dueDate, null);
+  assert.equal(undated.overdue, false);
+  assert.equal(store.update(yesterday.id, { done: true }).overdue, false);
+  assert.equal(store.update(yesterday.id, { done: false }).overdue, true);
+});
+
+test('recomputes overdue on reads at UTC midnight without writes', (t) => {
+  t.mock.timers.enable({ apis: ['Date'], now: new Date('2026-10-21T23:59:59.999Z') });
+  const store = createStore();
+  const todo = store.add({ title: 'Today', dueDate: '2026-10-21' });
+  assert.equal(store.get(todo.id).overdue, false);
+  assert.equal(store.list()[0].overdue, false);
+  t.mock.timers.setTime(new Date('2026-10-22T00:00:00.000Z').getTime());
+  assert.equal(store.get(todo.id).overdue, true);
+  assert.equal(store.list()[0].overdue, true);
+});
+
+test('validates real calendar dates on add and patch without changing existing fields', () => {
+  const store = createStore();
+  const original = store.add({ title: 'Original', dueDate: '2024-02-29' });
+  assert.equal(original.dueDate, '2024-02-29');
+  const before = { ...original };
+  for (const dueDate of [
+    '', '2026-2-01', '2026-02-30', '2025-02-29', '2026-04-31', '2026-00-01',
+    '2026-13-01', '2026-01-00', '2026-10-21T00:00:00Z', ' 2026-10-21', '2026-10-21\n',
+    42, false, {}, [], undefined,
+  ]) {
+    assert.throws(() => store.add({ title: 'Invalid', dueDate }), ValidationError, JSON.stringify(dueDate));
+    assert.throws(() => store.update(original.id, { title: 'Changed', done: true, dueDate }), ValidationError);
+    assert.deepEqual(store.get(original.id), before);
+  }
+});
+
+test('a rejected done or title patch leaves all fields unchanged', () => {
+  const store = createStore();
+  const todo = store.add({ title: 'Original', dueDate: '2024-02-29' });
+  const before = { ...todo };
