     assert.equal(res.status, 200);
     assert.match(await res.text(), /data-testid="todo-list"/);
   }));
+
+test('persists a due date through creation, reading and listing', () =>
+  withServer(async (base) => {
+    const res = await fetch(`${base}/todos`, json('POST', { title: 'A', dueDate: '2024-02-29' }));
+    assert.equal(res.status, 201);
+    const expected = { id: 1, title: 'A', done: false, dueDate: '2024-02-29' };
+    assert.deepEqual(await res.json(), expected);
+    assert.deepEqual(await (await fetch(`${base}/todos/1`)).json(), expected);
+    assert.deepEqual(await (await fetch(`${base}/todos`)).json(), [expected]);
+  }));
+
+test('updates, preserves and clears a due date', () =>
+  withServer(async (base) => {
+    await fetch(`${base}/todos`, json('POST', { title: 'A', dueDate: '2026-10-20' }));
+    const changed = await fetch(`${base}/todos/1`, json('PATCH', { dueDate: '2026-10-21' }));
+    assert.equal(changed.status, 200);
+    assert.equal((await changed.json()).dueDate, '2026-10-21');
+    const done = await fetch(`${base}/todos/1`, json('PATCH', { done: true }));
+    assert.equal((await done.json()).dueDate, '2026-10-21');
+    const cleared = await fetch(`${base}/todos/1`, json('PATCH', { dueDate: null }));
+    assert.equal(cleared.status, 200);
+    assert.deepEqual(await cleared.json(), { id: 1, title: 'A', done: true, dueDate: null });
+    assert.equal((await (await fetch(`${base}/todos/1`)).json()).dueDate, null);
+  }));
+
+test('accepts an explicitly absent due date', () =>
+  withServer(async (base) => {
+    const res = await fetch(`${base}/todos`, json('POST', { title: 'A', dueDate: null }));
+    assert.equal(res.status, 201);
+    assert.equal((await res.json()).dueDate, null);
+  }));
+
+for (const dueDate of [
+  '2026-02-29', '1900-02-29', '2026-04-31', '2026-13-01', '2026-00-01',
+  '2026-01-00', '2026-01-32', '2026-1-02', '2026-01-01T00:00:00Z',
+  '', ' 2026-01-01 ', 42, true, {}, [],
+]) {
+  test(`rejects invalid due date ${JSON.stringify(dueDate)} without changing stored data`, () =>
+    withServer(async (base) => {
+      const invalid = await fetch(`${base}/todos`, json('POST', { title: 'Invalid', dueDate }));
+      assert.equal(invalid.status, 400);
+      assert.equal(typeof (await invalid.json()).error, 'string');
+      assert.deepEqual(await (await fetch(`${base}/todos`)).json(), []);
+
+      await fetch(`${base}/todos`, json('POST', { title: 'Original', dueDate: '2026-10-21' }));
+      const patched = await fetch(`${base}/todos/1`, json('PATCH', { title: 'Changed', done: true, dueDate }));
+      assert.equal(patched.status, 400);
+      assert.deepEqual(await (await fetch(`${base}/todos/1`)).json(), {
+        id: 1, title: 'Original', done: false, dueDate: '2026-10-21',
+      });
+    }));
+}
+
+test('invalid done does not partially update a title or due date', () =>
+  withServer(async (base) => {
+    await fetch(`${base}/todos`, json('POST', { title: 'Original', dueDate: '2026-10-21' }));
+    const res = await fetch(`${base}/todos/1`, json('PATCH', {
+      title: 'Changed', dueDate: '2026-10-22', done: 'yes',
+    }));
+    assert.equal(res.status, 400);
+    assert.deepEqual(await (await fetch(`${base}/todos/1`)).json(), {
+      id: 1, title: 'Original', done: false, dueDate: '2026-10-21',
+    });
+  }));
+
+test('overdue filter respects the UTC day boundary and current completion and due date', async (t) => {
+  t.mock.timers.enable({ apis: ['Date'], now: Date.parse('2026-03-01T00:00:00.000Z') });
+  await withServer(async (base) => {
+    for (const todo of [
+      { title: 'Yesterday', dueDate: '2026-02-28' },
+      { title: 'Today', dueDate: '2026-03-01' },
+      { title: 'Tomorrow', dueDate: '2026-03-02' },
+      { title: 'Done', dueDate: '2026-02-28' },
+      { title: 'Undated' },
+      { title: 'Explicitly undated', dueDate: null },
+    ]) {
+      await fetch(`${base}/todos`, json('POST', todo));
+    }
+    await fetch(`${base}/todos/4`, json('PATCH', { done: true }));
+    const overdueTitles = async () => {
+      const res = await fetch(`${base}/todos?overdue=true`);
+      assert.equal(res.status, 200);
+      return (await res.json()).map((todo) => todo.title);
+    };
+    assert.deepEqual(await overdueTitles(), ['Yesterday']);
+    assert.equal((await (await fetch(`${base}/todos`)).json()).length, 6);
+    await fetch(`${base}/todos/1`, json('PATCH', { done: true }));
+    assert.deepEqual(await overdueTitles(), []);
+    await fetch(`${base}/todos/4`, json('PATCH', { done: false }));
+    assert.deepEqual(await overdueTitles(), ['Done']);
+    await fetch(`${base}/todos/4`, json('PATCH', { dueDate: null }));
+    assert.deepEqual(await overdueTitles(), []);
+  });
+});
+
+test('a due date becomes overdue only when the UTC day rolls over', async (t) => {
+  t.mock.timers.enable({ apis: ['Date'], now: Date.parse('2026-02-28T23:59:59.999Z') });
+  await withServer(async (base) => {
+    await fetch(`${base}/todos`, json('POST', { title: 'Today', dueDate: '2026-02-28' }));
+    assert.deepEqual(await (await fetch(`${base}/todos?overdue=true`)).json(), []);
+    t.mock.timers.tick(1);
+    const overdue = await (await fetch(`${base}/todos?overdue=true`)).json();
+    assert.deepEqual(overdue.map((todo) => todo.title), ['Today']);
+  });
+});
