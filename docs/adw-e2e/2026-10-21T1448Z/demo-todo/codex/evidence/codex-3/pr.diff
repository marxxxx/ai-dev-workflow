diff --git a/public/index.html b/public/index.html
index de8f94a..8b38155 100644
--- a/public/index.html
+++ b/public/index.html
@@ -3,19 +3,55 @@
 <head><meta charset="utf-8"><title>demo-todo</title></head>
 <body>
   <h1>Todos</h1>
+  <label><input type="checkbox" data-testid="overdue-filter" disabled> nur überfällige</label>
+  <p role="status" data-testid="todo-status"></p>
   <ul data-testid="todo-list"></ul>
   <script type="module">
     const list = document.querySelector('[data-testid="todo-list"]');
-    const todos = await (await fetch('/todos')).json();
-    for (const todo of todos) {
-      const li = document.createElement('li');
-      li.dataset.testid = 'todo-item';
-      const title = document.createElement('span');
-      title.dataset.testid = 'todo-title';
-      title.textContent = todo.title + (todo.done ? ' ✓' : '');
-      li.append(title);
-      list.append(li);
+    const filter = document.querySelector('[data-testid="overdue-filter"]');
+    const status = document.querySelector('[data-testid="todo-status"]');
+
+    async function loadTodos() {
+      filter.disabled = true;
+      list.replaceChildren();
+      status.textContent = 'Laden…';
+      try {
+        const response = await fetch(filter.checked ? '/todos?overdue=true' : '/todos');
+        if (!response.ok) throw new Error('Could not load todos');
+        const todos = await response.json();
+        const today = new Date().toISOString().slice(0, 10);
+        for (const todo of todos) {
+          const li = document.createElement('li');
+          li.dataset.testid = 'todo-item';
+          const title = document.createElement('span');
+          title.dataset.testid = 'todo-title';
+          title.textContent = todo.title + (todo.done ? ' ✓' : '');
+          li.append(title);
+          if (todo.dueDate) {
+            const date = document.createElement('time');
+            date.dataset.testid = 'todo-due-date';
+            date.dateTime = todo.dueDate;
+            date.textContent = ' · Fällig: ' + todo.dueDate;
+            li.append(date);
+            if (!todo.done && todo.dueDate < today) {
+              const overdue = document.createElement('strong');
+              overdue.dataset.testid = 'todo-overdue';
+              overdue.textContent = ' · überfällig';
+              li.append(overdue);
+            }
+          }
+          list.append(li);
+        }
+        status.textContent = todos.length ? '' : (filter.checked ? 'Keine überfälligen Todos.' : 'Keine Todos.');
+      } catch {
+        status.textContent = 'Todos konnten nicht geladen werden. Bitte erneut versuchen.';
+      } finally {
+        filter.disabled = false;
+      }
     }
+
+    filter.addEventListener('change', loadTodos);
+    await loadTodos();
   </script>
 </body>
 </html>
