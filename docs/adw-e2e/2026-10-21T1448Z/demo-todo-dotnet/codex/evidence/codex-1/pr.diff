+public record Todo(int Id, string Title, bool Done, DateOnly? DueDate = null)
+{
+    public bool IsOverdue => IsOverdueOn(DateOnly.FromDateTime(DateTime.UtcNow));
+
+    public bool IsOverdueOn(DateOnly today) => !Done && DueDate is { } date && date < today;
