+    [InlineData(0, true, false)]
+    [InlineData(1, true, false)]
+    public void ComputesOverdueRelativeToTodayInUtc(int dayOffset, bool done, bool expected)
+    {
+        var date = DateOnly.FromDateTime(DateTime.UtcNow).AddDays(dayOffset);
+        Assert.Equal(expected, new Todo(1, "A", done, date).IsOverdue);
+    }
+
+    [Theory]
+    [InlineData(false)]
+    [InlineData(true)]
+    public void AnUndatedTodoIsNeverOverdue(bool done)
+    {
+        Assert.False(new Todo(1, "A", done).IsOverdue);
+    }
+
+    [Fact]
+    public void UpdatesDatesOnlyWhenSupplied()
+    {
+        var store = new TodoStore();
+        var todo = store.Add(new NewTodo("A"));
+        var date = DateOnly.FromDateTime(DateTime.UtcNow).AddDays(-1);
+
+        Assert.Equal(date, store.Update(todo.Id, new TodoPatch(null, null) { DueDate = date })!.DueDate);
+        Assert.Equal(date, store.Update(todo.Id, new TodoPatch("B", null))!.DueDate);
+        var completed = store.Update(todo.Id, new TodoPatch(null, true))!;
+        Assert.Equal(date, completed.DueDate);
+        Assert.False(completed.IsOverdue);
+        Assert.True(store.Update(todo.Id, new TodoPatch(null, false))!.IsOverdue);
+
+        var replacement = date.AddDays(2);
+        Assert.Equal(replacement, store.Update(todo.Id, new TodoPatch(null, null) { DueDate = replacement })!.DueDate);
+        var cleared = store.Update(todo.Id, new TodoPatch(null, null) { DueDate = null })!;
+        Assert.Null(cleared.DueDate);
+        Assert.False(cleared.IsOverdue);
+    }
 }
