@@ -0,0 +1,69 @@
+using System.Net.Http.Json;
+using System.Net;
+using Microsoft.AspNetCore.Mvc.Testing;
+
+namespace DemoTodo.Tests;
+
+public class TodoPageTests : IDisposable
+{
+    private readonly WebApplicationFactory<Program> _factory = new();
+    private readonly HttpClient _client;
+
+    public TodoPageTests() => _client = _factory.CreateClient();
+
+    public void Dispose() => _factory.Dispose();
+
+    [Theory]
+    [InlineData(-1, false, true)]
+    [InlineData(0, false, false)]
+    [InlineData(1, false, false)]
+    [InlineData(-1, true, false)]
+    public async Task ShowsDatesAndMarksOnlyOverdueTodos(int dayOffset, bool done, bool expectedOverdue)
+    {
+        var date = DateOnly.FromDateTime(DateTime.UtcNow).AddDays(dayOffset).ToString("yyyy-MM-dd");
+        await _client.PostAsJsonAsync("/todos", new { title = "Dated todo", dueDate = date });
+        await _client.PatchAsJsonAsync("/todos/1", new { done });
+
+        var html = await _client.GetStringAsync("/");
+
+        Assert.Contains("data-testid=\"todo-item\"", html);
+        Assert.Contains("data-testid=\"todo-title\"", html);
+        Assert.Contains($"<time data-testid=\"todo-due-date\" datetime=\"{date}\">{date}</time>", html);
+        Assert.Equal(expectedOverdue, html.Contains("data-testid=\"todo-overdue\""));
+        if (expectedOverdue)
+            Assert.Contains("Überfällig", WebUtility.HtmlDecode(html));
+    }
+
+    [Fact]
+    public async Task UndatedTodosHaveNeitherDateNorOverdueMarker()
+    {
+        await _client.PostAsJsonAsync("/todos", new { title = "Undated todo" });
+
+        var html = await _client.GetStringAsync("/");
+
+        Assert.Contains("Undated todo", html);
+        Assert.DoesNotContain("data-testid=\"todo-due-date\"", html);
+        Assert.DoesNotContain("data-testid=\"todo-overdue\"", html);
+    }
+
+    [Fact]
+    public async Task CompletingReopeningAndClearingADateRefreshesTheOverdueMarker()
+    {
+        var date = DateOnly.FromDateTime(DateTime.UtcNow).AddDays(-1).ToString("yyyy-MM-dd");
+        await _client.PostAsJsonAsync("/todos", new { title = "Overdue todo", dueDate = date });
+        Assert.Contains("data-testid=\"todo-overdue\"", await _client.GetStringAsync("/"));
+
+        await _client.PatchAsJsonAsync("/todos/1", new { done = true });
+        var completed = await _client.GetStringAsync("/");
+        Assert.DoesNotContain("data-testid=\"todo-overdue\"", completed);
+        Assert.Contains("data-testid=\"todo-due-date\"", completed);
+
+        await _client.PatchAsJsonAsync("/todos/1", new { done = false });
+        Assert.Contains("data-testid=\"todo-overdue\"", await _client.GetStringAsync("/"));
+
+        await _client.PatchAsJsonAsync("/todos/1", new { dueDate = (string?)null });
+        var cleared = await _client.GetStringAsync("/");
+        Assert.DoesNotContain("data-testid=\"todo-due-date\"", cleared);
+        Assert.DoesNotContain("data-testid=\"todo-overdue\"", cleared);
+    }
+}
