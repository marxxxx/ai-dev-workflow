+using System.Globalization;
+using System.Net;
+using System.Net.Http.Json;
+using System.Text.RegularExpressions;
+using Microsoft.AspNetCore.Mvc.Testing;
+
+namespace DemoTodo.Tests;
+
+public class TodoDueDatePageTests
+{
+    [Theory]
+    [InlineData(-1, false, true)]
+    [InlineData(0, false, false)]
+    [InlineData(1, false, false)]
+    [InlineData(-1, true, false)]
+    [InlineData(null, false, false)]
+    public async Task ShowsTheDateAndMarksOnlyOverdueTodos(int? dayOffset, bool done, bool expectedOverdue)
+    {
+        using var factory = new WebApplicationFactory<Program>();
+        using var client = factory.CreateClient();
+        var dueDate = dayOffset is { } offset
+            ? DateOnly.FromDateTime(DateTime.UtcNow).AddDays(offset).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
+            : null;
+        await client.PostAsJsonAsync("/todos", new { title = "Milch kaufen", dueDate });
+        await client.PatchAsJsonAsync("/todos/1", new { done });
+
+        var html = WebUtility.HtmlDecode(await client.GetStringAsync("/"));
+        var row = Regex.Match(html, "<li[^>]*data-testid=\"todo-item\"[^>]*>.*?</li>", RegexOptions.Singleline).Value;
+        Assert.NotEmpty(row);
+        Assert.Contains("data-testid=\"todo-title\"", row);
+        Assert.Contains("Milch kaufen", row);
+        if (dueDate is not null)
+        {
+            Assert.Contains("data-testid=\"todo-due-date\"", row);
+            Assert.Contains($"datetime=\"{dueDate}\"", row);
+            Assert.Contains($">{dueDate}</time>", row);
+        }
+        else
+        {
+            Assert.DoesNotContain("data-testid=\"todo-due-date\"", row);
+        }
+
+        if (expectedOverdue)
+        {
+            Assert.Contains("data-testid=\"todo-overdue\"", row);
+            Assert.Contains("überfällig", row);
+        }
+        else
+        {
+            Assert.DoesNotContain("data-testid=\"todo-overdue\"", row);
+            Assert.DoesNotContain("überfällig", row);
+        }
+    }
+}
