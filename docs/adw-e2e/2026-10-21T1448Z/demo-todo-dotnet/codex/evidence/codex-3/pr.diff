+using System.ComponentModel.DataAnnotations;
+
+namespace DemoTodo.Tests;
+
+public class TodoDueDateStoreTests
+{
+    [Fact]
+    public void StoresADateWithoutATime()
+    {
+        var store = new TodoStore();
+        var todo = store.Add(new NewTodo("A", "2032-02-29"));
+        Assert.Equal(new DateOnly(2032, 2, 29), todo.DueDate);
+        Assert.Equal(todo, store.Get(todo.Id));
+        Assert.Equal(todo, Assert.Single(store.List()));
+    }
+
+    [Fact]
+    public void UpdatesPreserveOrExplicitlyRemoveTheDate()
+    {
+        var store = new TodoStore();
+        var todo = store.Add(new NewTodo("A", "2030-02-28"));
+        Assert.Equal(new DateOnly(2030, 2, 28), store.Update(todo.Id, new TodoPatch("B", true))!.DueDate);
+        Assert.Equal(new DateOnly(2032, 2, 29), store.Update(todo.Id,
+            new TodoPatch(null, null) { DueDate = "2032-02-29" })!.DueDate);
+        Assert.Null(store.Update(todo.Id, new TodoPatch(null, null) { DueDate = null })!.DueDate);
+    }
+
+    [Fact]
+    public void InvalidDatesThrowValidationExceptionsWithoutMutatingTheStore()
+    {
+        var store = new TodoStore();
+        Assert.Throws<ValidationException>(() => store.Add(new NewTodo("A", "2030-02-30")));
+        Assert.Empty(store.List());
+        var todo = store.Add(new NewTodo("A", "2030-02-28"));
+        Assert.Throws<ValidationException>(() => store.Update(todo.Id,
+            new TodoPatch("B", true) { DueDate = "2030-02-30" }));
+        Assert.Equal(todo, store.Get(todo.Id));
+    }
+}
