+using System.Globalization;
+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Microsoft.AspNetCore.Mvc.Testing;
+
+namespace DemoTodo.Tests;
+
+public class TodoOverdueFilterTests : IDisposable
+{
+    private readonly WebApplicationFactory<Program> _factory = new();
+    private readonly HttpClient _client;
+
+    public TodoOverdueFilterTests() => _client = _factory.CreateClient();
+
+    public void Dispose() => _factory.Dispose();
+
+    [Theory]
+    [InlineData("/todos?overdue=true", true)]
+    [InlineData("/todos?overdue=false", false)]
+    [InlineData("/todos", false)]
+    public async Task FiltersOnlyOpenTodosBeforeTodayUtc(string url, bool onlyOverdue)
+    {
+        var today = DateOnly.FromDateTime(DateTime.UtcNow);
+        foreach (var (title, offset) in new (string, int?)[]
+        {
+            ("Overdue A", -1), ("Today", 0), ("Future", 1),
+            ("Done", -1), ("Undated", null), ("Overdue B", -2)
+        })
+        {
+            var dueDate = offset is { } days
+                ? today.AddDays(days).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
+                : null;
+            var created = await _client.PostAsJsonAsync("/todos", new { title, dueDate });
+            Assert.Equal(HttpStatusCode.Created, created.StatusCode);
+        }
+        await _client.PatchAsJsonAsync("/todos/4", new { done = true });
+
+        var todos = await _client.GetFromJsonAsync<Todo[]>(url);
+        Assert.NotNull(todos);
+        Assert.Equal(onlyOverdue ? [1, 6] : new[] { 1, 2, 3, 4, 5, 6 }, todos.Select(todo => todo.Id));
+        var unfiltered = await _client.GetFromJsonAsync<Todo[]>("/todos");
+        Assert.NotNull(unfiltered);
+        Assert.Equal(6, unfiltered.Length);
+    }
+
+    [Fact]
+    public async Task ReturnsAnEmptyArrayWhenNothingIsOverdue()
+    {
+        await _client.PostAsJsonAsync("/todos", new { title = "Undated" });
+        var todos = await _client.GetFromJsonAsync<Todo[]>("/todos?overdue=true");
+        Assert.NotNull(todos);
+        Assert.Empty(todos);
+    }
+
+    [Fact]
+    public async Task RejectsAnInvalidOverdueFilter()
+    {
+        var response = await _client.GetAsync("/todos?overdue=invalid");
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        var error = await response.Content.ReadFromJsonAsync<JsonElement>();
+        Assert.False(string.IsNullOrEmpty(error.GetProperty("error").GetString()));
+    }
+
+    [Fact]
+    public async Task PageOffersTheOverdueCheckboxAndInitiallyShowsAllTodos()
+    {
+        await _client.PostAsJsonAsync("/todos", new { title = "Without a date" });
+        await _client.PostAsJsonAsync("/todos", new { title = "Overdue task", dueDate = "2000-01-01" });
+        var html = WebUtility.HtmlDecode(await _client.GetStringAsync("/"));
+        Assert.Contains("data-testid=\"todo-overdue-only\"", html);
+        Assert.Contains("type=\"checkbox\"", html);
+        Assert.Contains("nur überfällige", html);
+        Assert.Contains("Without a date", html);
+        Assert.Contains("Overdue task", html);
+    }
+}
