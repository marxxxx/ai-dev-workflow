@@ -0,0 +1,113 @@
+using System.Globalization;
+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Microsoft.AspNetCore.Mvc.Testing;
+
+namespace DemoTodo.Tests;
+
+public class TodoDueDateApiTests : IDisposable
+{
+    private readonly WebApplicationFactory<Program> _factory = new();
+    private readonly HttpClient _client;
+
+    public TodoDueDateApiTests() => _client = _factory.CreateClient();
+
+    public void Dispose() => _factory.Dispose();
+
+    [Fact]
+    public async Task CreatesAndReadsADateWithoutATime()
+    {
+        var response = await _client.PostAsJsonAsync("/todos", new { title = "A", dueDate = "2030-02-28" });
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        var created = await response.Content.ReadFromJsonAsync<JsonElement>();
+        Assert.Equal("2030-02-28", created.GetProperty("dueDate").GetString());
+
+        var single = await _client.GetFromJsonAsync<JsonElement>("/todos/1");
+        Assert.Equal("2030-02-28", single.GetProperty("dueDate").GetString());
+        var list = await _client.GetFromJsonAsync<JsonElement>("/todos");
+        Assert.Equal("2030-02-28", list[0].GetProperty("dueDate").GetString());
+    }
+
+    [Theory]
+    [InlineData("{\"title\":\"A\"}")]
+    [InlineData("{\"title\":\"A\",\"dueDate\":null}")]
+    public async Task CreatesUndatedTodos(string body)
+    {
+        var response = await _client.PostAsync("/todos", new StringContent(body, null, "application/json"));
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        var todo = await response.Content.ReadFromJsonAsync<JsonElement>();
+        Assert.Equal(JsonValueKind.Null, todo.GetProperty("dueDate").ValueKind);
+        Assert.False(todo.GetProperty("isOverdue").GetBoolean());
+    }
+
+    [Fact]
+    public async Task PatchesSetPreserveChangeAndRemoveTheDate()
+    {
+        await _client.PostAsJsonAsync("/todos", new { title = "A" });
+        foreach (var date in new[] { "2030-02-28", "2032-02-29" })
+        {
+            var response = await _client.PatchAsJsonAsync("/todos/1", new { dueDate = date });
+            Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+            var todo = await response.Content.ReadFromJsonAsync<JsonElement>();
+            Assert.Equal(date, todo.GetProperty("dueDate").GetString());
+        }
+
+        var preserved = await _client.PatchAsJsonAsync("/todos/1", new { title = "B", done = true });
+        var unchangedDate = await preserved.Content.ReadFromJsonAsync<JsonElement>();
+        Assert.Equal("2032-02-29", unchangedDate.GetProperty("dueDate").GetString());
+        Assert.Equal("B", unchangedDate.GetProperty("title").GetString());
+        Assert.True(unchangedDate.GetProperty("done").GetBoolean());
+
+        var cleared = await _client.PatchAsJsonAsync("/todos/1", new { dueDate = (string?)null });
+        var noDate = await cleared.Content.ReadFromJsonAsync<JsonElement>();
+        Assert.Equal(JsonValueKind.Null, noDate.GetProperty("dueDate").ValueKind);
+        var stored = await _client.GetFromJsonAsync<JsonElement>("/todos/1");
+        Assert.Equal(JsonValueKind.Null, stored.GetProperty("dueDate").ValueKind);
+    }
+
+    [Theory]
+    [InlineData(-1, false, true)]
+    [InlineData(0, false, false)]
+    [InlineData(1, false, false)]
+    [InlineData(-1, true, false)]
+    public async Task ReportsOverdueOnlyForOpenTodosBeforeTodayUtc(int dayOffset, bool done, bool expected)
+    {
+        var dueDate = DateOnly.FromDateTime(DateTime.UtcNow).AddDays(dayOffset).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
+        await _client.PostAsJsonAsync("/todos", new { title = "A", dueDate });
+        var response = await _client.PatchAsJsonAsync("/todos/1", new { done });
+        var todo = await response.Content.ReadFromJsonAsync<JsonElement>();
+        Assert.Equal(expected, todo.GetProperty("isOverdue").GetBoolean());
+        var single = await _client.GetFromJsonAsync<JsonElement>("/todos/1");
+        Assert.Equal(expected, single.GetProperty("isOverdue").GetBoolean());
+        var list = await _client.GetFromJsonAsync<JsonElement>("/todos");
+        Assert.Equal(expected, list[0].GetProperty("isOverdue").GetBoolean());
+    }
+
+    [Theory]
+    [InlineData("")]
+    [InlineData("2030-02-30")]
+    [InlineData("2030-2-01")]
+    [InlineData("28.02.2030")]
+    [InlineData("2030-02-28T12:00:00Z")]
+    [InlineData(" 2030-02-28 ")]
+    public async Task RejectsInvalidDatesWithoutChangingTheTodo(string dueDate)
+    {
+        var created = await _client.PostAsJsonAsync("/todos", new { title = "Invalid", dueDate });
+        Assert.Equal(HttpStatusCode.BadRequest, created.StatusCode);
+        var error = await created.Content.ReadFromJsonAsync<JsonElement>();
+        Assert.False(string.IsNullOrEmpty(error.GetProperty("error").GetString()));
+        var empty = await _client.GetFromJsonAsync<JsonElement>("/todos");
+        Assert.Equal(0, empty.GetArrayLength());
+
+        await _client.PostAsJsonAsync("/todos", new { title = "A", dueDate = "2030-02-28" });
+        var patched = await _client.PatchAsJsonAsync("/todos/1", new { title = "B", done = true, dueDate });
+        Assert.Equal(HttpStatusCode.BadRequest, patched.StatusCode);
+        var patchError = await patched.Content.ReadFromJsonAsync<JsonElement>();
+        Assert.False(string.IsNullOrEmpty(patchError.GetProperty("error").GetString()));
+        var stored = await _client.GetFromJsonAsync<JsonElement>("/todos/1");
+        Assert.Equal("A", stored.GetProperty("title").GetString());
+        Assert.False(stored.GetProperty("done").GetBoolean());
+        Assert.Equal("2030-02-28", stored.GetProperty("dueDate").GetString());
+    }
+}
