+// Accepts null or a real calendar date in YYYY-MM-DD form.
+function validateDueDate(value) {
+  if (value === null) return;
+  const time = typeof value === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(value)
+    ? Date.parse(`${value}T00:00:00Z`)
+    : NaN;
+  // Round-trip rejects dates JS rolls over, such as 2026-02-29 → 2026-03-01.
+  const valid = !Number.isNaN(time) && new Date(time).toISOString().slice(0, 10) === value;
+  if (!valid) throw new ValidationError('dueDate must be a YYYY-MM-DD date or null');
