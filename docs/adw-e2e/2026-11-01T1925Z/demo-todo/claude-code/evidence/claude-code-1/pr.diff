@@ -0,0 +1,63 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createStore, ValidationError } from '../src/store.mjs';
+
+const fixedStore = () => createStore({ today: () => '2026-11-01' });
+
+test('add defaults dueDate to null', () => {
+  assert.deepEqual(fixedStore().add({ title: 'A' }), {
+    id: 1,
+    title: 'A',
+    done: false,
+    dueDate: null,
+  });
+});
+
+test('add accepts a valid dueDate', () => {
+  assert.equal(fixedStore().add({ title: 'A', dueDate: '2028-02-29' }).dueDate, '2028-02-29');
+});
+
+test('rejects invalid dueDate', () => {
+  for (const value of ['morgen', '2026-02-29', '2026-13-01', '2026-1-5', 20261105, true]) {
+    const store = fixedStore();
+    assert.throws(() => store.add({ title: 'A', dueDate: value }), ValidationError, String(value));
+    store.add({ title: 'B' });
+    assert.throws(() => store.update(1, { dueDate: value }), ValidationError, String(value));
+  }
+});
+
+test('update sets and clears dueDate', () => {
+  const store = fixedStore();
+  store.add({ title: 'A' });
+  assert.deepEqual(store.update(1, { dueDate: '2026-10-01' }), {
+    id: 1,
+    title: 'A',
+    done: false,
+    dueDate: '2026-10-01',
+  });
+  assert.equal(store.update(1, { dueDate: null }).dueDate, null);
+});
+
+test('update with an invalid dueDate changes nothing', () => {
+  const store = fixedStore();
+  store.add({ title: 'A' });
+  assert.throws(
+    () => store.update(1, { title: 'B', done: true, dueDate: 'morgen' }),
+    ValidationError,
+  );
+  assert.deepEqual(store.get(1), { id: 1, title: 'A', done: false, dueDate: null });
+});
+
+test('list({ overdue: true }) returns only open todos due before today', () => {
+  const store = fixedStore();
+  store.add({ title: 'gestern', dueDate: '2026-10-31' });
+  store.add({ title: 'heute', dueDate: '2026-11-01' });
+  store.add({ title: 'erledigt', dueDate: '2026-10-01' });
+  store.update(3, { done: true });
+  store.add({ title: 'ohne' });
+  assert.deepEqual(
+    store.list({ overdue: true }).map((t) => t.title),
+    ['gestern'],
+  );
+  assert.equal(store.list().length, 4);
+});
