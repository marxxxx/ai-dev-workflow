+using System.Text.Json;
+
+namespace DemoTodo.Tests;
+
+public class OptionalTests
+{
+    private record Probe(Optional<DateOnly?> D);
+
+    private static Probe Read(string json) => JsonSerializer.Deserialize<Probe>(json, JsonSerializerOptions.Web)!;
+
+    [Fact]
+    public void AMissingFieldIsNotSet() => Assert.False(Read("{}").D.IsSet);
+
+    [Fact]
+    public void NullIsSetToNull() => Assert.Equal(new Optional<DateOnly?>(true, null), Read("""{"d":null}""").D);
+
+    [Fact]
+    public void AValueIsSet() =>
+        Assert.Equal(Optional<DateOnly?>.Of(new DateOnly(2026, 10, 20)), Read("""{"d":"2026-10-20"}""").D);
+
+    [Fact]
+    public void AnInvalidValueThrows() => Assert.ThrowsAny<JsonException>(() => Read("""{"d":"2026-02-30"}"""));
+}
