+++ b/tests/DemoTodo.Tests/OptionalTests.cs
@@ -0,0 +1,31 @@
+using System.Text.Json;
+
+namespace DemoTodo.Tests;
+
+// The PATCH body must tell a missing dueDate (keep) from an explicit null (clear).
+public class OptionalTests
+{
+    private static TodoPatch Parse(string json) => JsonSerializer.Deserialize<TodoPatch>(json, JsonSerializerOptions.Web)!;
+
+    [Fact]
+    public void AMissingFieldHasNoValue()
+    {
+        Assert.False(Parse("{}").DueDate.HasValue);
+    }
+
+    [Fact]
+    public void AnExplicitNullHasANullValue()
+    {
+        var dueDate = Parse("""{"dueDate":null}""").DueDate;
+        Assert.True(dueDate.HasValue);
+        Assert.Null(dueDate.Value);
+    }
+
+    [Fact]
+    public void AStringHasThatValue()
+    {
+        var dueDate = Parse("""{"dueDate":"2026-10-20"}""").DueDate;
+        Assert.True(dueDate.HasValue);
+        Assert.Equal("2026-10-20", dueDate.Value);
+    }
+}
