--- /dev/null
+++ b/tests/DemoTodo.Tests/FixedTimeProvider.cs
@@ -0,0 +1,10 @@
+namespace DemoTodo.Tests;
+
+// A clock frozen at one instant, so "today" is deterministic in tests.
+public class FixedTimeProvider(DateTimeOffset utcNow) : TimeProvider
+{
+    public static FixedTimeProvider On(int year, int month, int day) =>
+        new(new DateTimeOffset(year, month, day, 12, 0, 0, TimeSpan.Zero));
+
+    public override DateTimeOffset GetUtcNow() => utcNow;
+}
