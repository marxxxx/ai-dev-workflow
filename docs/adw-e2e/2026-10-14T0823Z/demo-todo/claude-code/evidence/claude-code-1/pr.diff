@@ -38,4 +50,14 @@ export function createStore() {
   };
 }
 
+// Accepts null or a real calendar date as YYYY-MM-DD.
+function validateDueDate(value) {
+  if (value === null) return null;
+  if (typeof value === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(value)) {
+    const [y, m, d] = value.split('-').map(Number);
+    if (new Date(Date.UTC(y, m - 1, d)).toISOString().slice(0, 10) === value) return value;
+  }
+  throw new ValidationError('dueDate must be a date in YYYY-MM-DD format or null');
+}
+
