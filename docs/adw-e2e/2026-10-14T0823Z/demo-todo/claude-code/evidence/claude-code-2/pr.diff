diff --git a/test/store.test.mjs b/test/store.test.mjs
new file mode 100644
index 0000000..537d902
--- /dev/null
+++ b/test/store.test.mjs
@@ -0,0 +1,138 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createStore, ValidationError } from '../src/store.mjs';
+
+const fixedStore = () => createStore({ today: () => '2026-10-14' });
+const DUE_DATE_ERROR = 'dueDate must be a valid date (YYYY-MM-DD) or null';
+
+test('add without dueDate', () => {
+  const store = fixedStore();
+  assert.deepEqual(store.add({ title: 'A' }), {
+    id: 1,
+    title: 'A',
+    done: false,
+    dueDate: null,
+    overdue: false,
+  });
+});
+
+test('add with dueDate null', () => {
+  assert.equal(fixedStore().add({ title: 'A', dueDate: null }).dueDate, null);
+});
+
+test('add with dueDate', () => {
+  const todo = fixedStore().add({ title: 'A', dueDate: '2026-10-20' });
+  assert.equal(todo.dueDate, '2026-10-20');
+  assert.equal(todo.overdue, false);
+});
+
+test('rejects invalid dueDates', () => {
+  const store = fixedStore();
+  const invalid = [
+    '14.10.2026',
+    '2026-02-30',
+    '2025-02-29',
+    '1900-02-29',
+    '2026-13-01',
+    '2026-00-10',
+    '2026-1-5',
+    '',
+    20261014,
+    true,
+    {},
+  ];
+  for (const dueDate of invalid) {
+    assert.throws(
+      () => store.add({ title: 'A', dueDate }),
+      (e) => e instanceof ValidationError && e.message === DUE_DATE_ERROR,
+      `expected ${JSON.stringify(dueDate)} to be rejected`,
+    );
+  }
+  assert.deepEqual(store.list(), []);
+});
+
+test('accepts leap days', () => {
+  const store = fixedStore();
+  assert.equal(store.add({ title: 'A', dueDate: '2028-02-29' }).dueDate, '2028-02-29');
+  assert.equal(store.add({ title: 'B', dueDate: '2000-02-29' }).dueDate, '2000-02-29');
+});
+
+test('update sets, changes and removes dueDate', () => {
+  const store = fixedStore();
+  const { id } = store.add({ title: 'A' });
+  assert.equal(store.update(id, { dueDate: '2026-10-01' }).dueDate, '2026-10-01');
+  assert.equal(store.update(id, { dueDate: '2026-11-01' }).dueDate, '2026-11-01');
+  assert.equal(store.update(id, { title: 'B' }).dueDate, '2026-11-01');
+  assert.equal(store.update(id, { dueDate: null }).dueDate, null);
+});
+
+test('update rejects invalid dueDate', () => {
+  const store = fixedStore();
+  const { id } = store.add({ title: 'A' });
+  assert.throws(() => store.update(id, { dueDate: '2026-02-30' }), ValidationError);
+});
+
+test('overdue rules', () => {
+  const store = fixedStore();
+  assert.equal(store.add({ title: 'yesterday', dueDate: '2026-10-13' }).overdue, true);
+  assert.equal(store.add({ title: 'today', dueDate: '2026-10-14' }).overdue, false);
+  assert.equal(store.add({ title: 'tomorrow', dueDate: '2026-10-15' }).overdue, false);
+  assert.equal(store.add({ title: 'none' }).overdue, false);
+  const { id } = store.add({ title: 'done', dueDate: '2026-10-13' });
+  assert.equal(store.update(id, { done: true }).overdue, false);
+});
+
+test('overdue follows done', () => {
+  const store = fixedStore();
+  const { id } = store.add({ title: 'A', dueDate: '2026-10-13' });
+  assert.equal(store.update(id, { done: true }).overdue, false);
+  assert.equal(store.update(id, { done: false }).overdue, true);
+});
+
+test('invalid patch changes nothing', () => {
+  const store = fixedStore();
+  const { id } = store.add({ title: 'Old', dueDate: '2026-10-20' });
+  assert.throws(() => store.update(id, { title: 'New', dueDate: 'x' }), ValidationError);
+  assert.throws(() => store.update(id, { title: 'New', done: 'yes' }), ValidationError);
+  assert.throws(() => store.update(id, { dueDate: null, done: 'yes' }), ValidationError);
+  assert.deepEqual(store.get(id), {
+    id,
+    title: 'Old',
+    done: false,
+    dueDate: '2026-10-20',
+    overdue: false,
+  });
+});
+
+test('returns copies', () => {
+  const store = fixedStore();
+  store.add({ title: 'A', dueDate: '2026-10-20' });
+  const todo = store.get(1);
+  todo.title = 'hack';
+  todo.dueDate = 'x';
+  store.list()[0].done = true;
+  assert.deepEqual(store.get(1), {
+    id: 1,
+    title: 'A',
+    done: false,
+    dueDate: '2026-10-20',
+    overdue: false,
+  });
+});
+
+test('list filter', () => {
+  const store = fixedStore();
+  store.add({ title: 'yesterday', dueDate: '2026-10-13' });
+  store.add({ title: 'tomorrow', dueDate: '2026-10-15' });
+  store.add({ title: 'none' });
+  const ids = (todos) => todos.map((t) => t.id);
+  assert.deepEqual(ids(store.list({ overdue: true })), [1]);
+  assert.deepEqual(ids(store.list({ overdue: false })), [2, 3]);
+  assert.deepEqual(ids(store.list()), [1, 2, 3]);
+});
+
+test('default clock', () => {
+  const store = createStore();
+  assert.equal(store.add({ title: 'past', dueDate: '2000-01-01' }).overdue, true);
+  assert.equal(store.add({ title: 'future', dueDate: '2999-01-01' }).overdue, false);
+});
