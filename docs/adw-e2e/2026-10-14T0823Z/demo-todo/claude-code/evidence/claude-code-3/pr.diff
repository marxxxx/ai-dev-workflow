diff --git a/test/store.test.mjs b/test/store.test.mjs
new file mode 100644
index 0000000..400b953
--- /dev/null
+++ b/test/store.test.mjs
@@ -0,0 +1,71 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createStore, ValidationError } from '../src/store.mjs';
+
+const store = () => createStore({ today: () => '2026-10-14' });
+
+test('dueDate defaults to null and overdue to false', () => {
+  assert.deepEqual(store().add({ title: 'A' }), {
+    id: 1,
+    title: 'A',
+    done: false,
+    dueDate: null,
+    overdue: false,
+  });
+});
+
+test('accepts valid dates incl. leap day', () => {
+  for (const d of ['2026-10-20', '2028-02-29']) {
+    assert.equal(store().add({ title: 'A', dueDate: d }).dueDate, d);
+  }
+});
+
+test('rejects invalid dates', () => {
+  const invalid = ['2026-02-30', '2026-13-01', '2026-1-5', '20.10.2026', '2026-10-20T10:00:00Z',
+    ' 2026-10-20', '', 20261020, true, {}];
+  for (const d of invalid) {
+    assert.throws(() => store().add({ title: 'A', dueDate: d }), ValidationError, String(d));
+    const s = store();
+    s.add({ title: 'A' });
+    assert.throws(() => s.update(1, { dueDate: d }), ValidationError, String(d));
+  }
+});
+
+test('overdue only when not done and before today (UTC)', () => {
+  const s = store();
+  assert.equal(s.add({ title: 'y', dueDate: '2026-10-13' }).overdue, true);
+  assert.equal(s.add({ title: 't', dueDate: '2026-10-14' }).overdue, false);
+  assert.equal(s.add({ title: 'm', dueDate: '2026-10-15' }).overdue, false);
+  assert.equal(s.add({ title: 'n' }).overdue, false);
+  assert.equal(s.update(1, { done: true }).overdue, false);
+});
+
+test('update sets, changes and removes dueDate; absent key keeps it', () => {
+  const s = store();
+  s.add({ title: 'A', dueDate: '2026-10-01' });
+  assert.equal(s.update(1, { title: 'B' }).dueDate, '2026-10-01');
+  assert.equal(s.update(1, { dueDate: '2026-11-01' }).dueDate, '2026-11-01');
+  assert.deepEqual(s.update(1, { dueDate: null }), {
+    id: 1,
+    title: 'B',
+    done: false,
+    dueDate: null,
+    overdue: false,
+  });
+});
+
+test('list filters by overdue', () => {
+  const s = store();
+  s.add({ title: 'y', dueDate: '2026-10-13' });
+  s.add({ title: 'n' });
+  assert.deepEqual(s.list({ overdue: true }).map((t) => t.title), ['y']);
+  assert.deepEqual(s.list({ overdue: false }).map((t) => t.title), ['n']);
+  assert.equal(s.list().length, 2);
+});
+
+test('returned todos are copies', () => {
+  const s = store();
+  s.add({ title: 'A' });
+  s.get(1).title = 'X';
+  assert.equal(s.get(1).title, 'A');
+});
