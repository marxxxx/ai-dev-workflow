+// Maps ?overdue=true|false to a boolean; absent means no filter.
+function overdueFilter(params) {
+  if (!params.has('overdue')) return undefined;
+  const value = params.get('overdue');
+  if (value === 'true') return true;
+  if (value === 'false') return false;
+  throw new ValidationError('overdue must be true or false');
