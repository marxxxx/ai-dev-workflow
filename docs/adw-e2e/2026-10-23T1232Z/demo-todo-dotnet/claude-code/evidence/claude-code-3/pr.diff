+namespace DemoTodo.Tests;
+
+// A clock frozen at one instant, so overdue checks do not depend on the real date.
+public class FixedTime(DateTimeOffset now) : TimeProvider
+{
+    public override DateTimeOffset GetUtcNow() => now;
+}
