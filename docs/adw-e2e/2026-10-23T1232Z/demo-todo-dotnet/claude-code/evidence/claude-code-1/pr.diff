+// A todo as the API returns it, with overdue computed for today.
+public record TodoView(int Id, string Title, bool Done, DateOnly? DueDate, bool Overdue)
+{
+    public static TodoView From(Todo todo, DateOnly today) =>
+        new(todo.Id, todo.Title, todo.Done, todo.DueDate, todo.IsOverdue(today));
