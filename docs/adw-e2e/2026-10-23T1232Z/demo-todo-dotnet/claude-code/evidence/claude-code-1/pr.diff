new file mode 100644
index 0000000..8579759
--- /dev/null
+++ b/tests/DemoTodo.Tests/FixedTimeProvider.cs
@@ -0,0 +1,10 @@
+namespace DemoTodo.Tests;
+
+// A clock stopped at one instant, so tests can pin "today".
+public sealed class FixedTimeProvider(DateTimeOffset now) : TimeProvider
+{
+    // Late in the UTC day: a store that used the local date instead would see tomorrow east of UTC.
+    public static readonly DateTimeOffset LateOn20261023 = DateTimeOffset.Parse("2026-10-23T23:30:00Z");
+
+    public override DateTimeOffset GetUtcNow() => now;
+}
