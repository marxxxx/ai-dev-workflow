@@ -0,0 +1,10 @@
+namespace DemoTodo.Tests;
+
+// A clock frozen at one instant, so "today" is fixed in tests.
+public class FixedTimeProvider(DateTimeOffset now) : TimeProvider
+{
+    // 01:00 at UTC+2 is still 2026-10-23 in UTC: today is the 23rd.
+    public static readonly FixedTimeProvider Oct23 = new(new(2026, 10, 24, 1, 0, 0, TimeSpan.FromHours(2)));
+
+    public override DateTimeOffset GetUtcNow() => now.ToUniversalTime();
+}
