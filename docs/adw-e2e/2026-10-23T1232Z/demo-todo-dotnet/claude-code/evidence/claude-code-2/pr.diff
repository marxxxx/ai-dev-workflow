@@ -0,0 +1,14 @@
+using System.Text.Json.Serialization;
+
+namespace DemoTodo;
+
+// A value that may be absent, as distinct from present-but-null: lets PATCH tell a missing field
+// (keep the current value) from an explicit null (clear it). `default` is absent.
+[JsonConverter(typeof(OptionalJsonConverterFactory))]
+public readonly struct Optional<T>(T value)
+{
+    public bool HasValue { get; } = true;
+    public T Value { get; } = value;
+
+    public static implicit operator Optional<T>(T value) => new(value);
+}
diff --git a/src/DemoTodo/OptionalJsonConverter.cs b/src/DemoTodo/OptionalJsonConverter.cs
new file mode 100644
