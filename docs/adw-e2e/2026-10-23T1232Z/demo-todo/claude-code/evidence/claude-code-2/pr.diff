@@ -3,19 +3,44 @@
 <head><meta charset="utf-8"><title>demo-todo</title></head>
 <body>
   <h1>Todos</h1>
+  <label><input type="checkbox" data-testid="filter-overdue"> nur überfällige</label>
   <ul data-testid="todo-list"></ul>
   <script type="module">
     const list = document.querySelector('[data-testid="todo-list"]');
-    const todos = await (await fetch('/todos')).json();
-    for (const todo of todos) {
-      const li = document.createElement('li');
-      li.dataset.testid = 'todo-item';
-      const title = document.createElement('span');
-      title.dataset.testid = 'todo-title';
-      title.textContent = todo.title + (todo.done ? ' ✓' : '');
-      li.append(title);
-      list.append(li);
+    const filter = document.querySelector('[data-testid="filter-overdue"]');
+    const getJson = async (path) => (await fetch(path)).json();
+
+    async function render() {
+      // The server owns the overdue rule; the page only marks what it reports.
+      const [todos, overdue] = await Promise.all([getJson('/todos'), getJson('/todos?overdue=true')]);
+      const overdueIds = new Set(overdue.map((todo) => todo.id));
+      list.replaceChildren();
+      for (const todo of filter.checked ? overdue : todos) {
+        const li = document.createElement('li');
+        li.dataset.testid = 'todo-item';
+        const title = document.createElement('span');
+        title.dataset.testid = 'todo-title';
+        title.textContent = todo.title + (todo.done ? ' ✓' : '');
+        li.append(title);
+        if (todo.dueDate) {
+          const [y, m, d] = todo.dueDate.split('-');
+          const due = document.createElement('span');
+          due.dataset.testid = 'todo-due';
+          due.textContent = ` · fällig ${d}.${m}.${y}`;
+          li.append(due);
+        }
+        if (overdueIds.has(todo.id)) {
+          const mark = document.createElement('span');
+          mark.dataset.testid = 'todo-overdue';
+          mark.textContent = ' überfällig';
+          li.append(mark);
+        }
+        list.append(li);
+      }
     }
+
+    filter.addEventListener('change', render);
+    await render();
   </script>
 </body>
 </html>
