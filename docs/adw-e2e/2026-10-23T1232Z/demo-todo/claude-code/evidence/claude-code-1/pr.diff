 <head><meta charset="utf-8"><title>demo-todo</title></head>
 <body>
   <h1>Todos</h1>
+  <label><input type="checkbox" data-testid="overdue-filter"> nur überfällige</label>
   <ul data-testid="todo-list"></ul>
   <script type="module">
     const list = document.querySelector('[data-testid="todo-list"]');
-    const todos = await (await fetch('/todos')).json();
-    for (const todo of todos) {
-      const li = document.createElement('li');
-      li.dataset.testid = 'todo-item';
-      const title = document.createElement('span');
-      title.dataset.testid = 'todo-title';
-      title.textContent = todo.title + (todo.done ? ' ✓' : '');
-      li.append(title);
-      list.append(li);
+    const filter = document.querySelector('[data-testid="overdue-filter"]');
+    // YYYY-MM-DD → TT.MM.JJJJ, without Date to avoid time-zone shifts.
+    const formatDate = (iso) => iso.split('-').reverse().join('.');
+
+    async function render() {
+      const todos = await (await fetch(filter.checked ? '/todos?overdue=true' : '/todos')).json();
+      list.replaceChildren();
+      for (const todo of todos) {
+        const li = document.createElement('li');
+        li.dataset.testid = 'todo-item';
+        const title = document.createElement('span');
+        title.dataset.testid = 'todo-title';
+        title.textContent = todo.title + (todo.done ? ' ✓' : '');
+        li.append(title);
+        if (todo.dueDate) {
+          const due = document.createElement('span');
+          due.dataset.testid = 'todo-due-date';
+          due.textContent = ' ' + formatDate(todo.dueDate);
+          li.append(due);
+        }
+        if (todo.overdue) {
+          const overdue = document.createElement('strong');
+          overdue.dataset.testid = 'todo-overdue';
+          overdue.style.color = '#b00020';
+          overdue.textContent = ' überfällig';
+          li.append(overdue);
+        }
+        list.append(li);
+      }
     }
+
+    filter.addEventListener('change', render);
+    await render();
   </script>
 </body>
 </html>
