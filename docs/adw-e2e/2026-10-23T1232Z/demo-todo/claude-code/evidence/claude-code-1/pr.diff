+// `?overdue=true|false` filters the list; absent means all todos.
+function parseOverdue(params) {
+  if (!params.has('overdue')) return undefined;
+  const value = params.get('overdue');
+  if (value === 'true') return true;
+  if (value === 'false') return false;
+  throw new ValidationError('overdue must be true or false');
+}
+
 async function readJson(req) {
   let raw = '';
   for await (const chunk of req) raw += chunk;
-  return raw ? JSON.parse(raw) : {};
+  const body = raw ? JSON.parse(raw) : {};
+  if (typeof body !== 'object' || body === null || Array.isArray(body)) {
+    throw new ValidationError('body must be a JSON object');
+  }
+  return body;
 }
