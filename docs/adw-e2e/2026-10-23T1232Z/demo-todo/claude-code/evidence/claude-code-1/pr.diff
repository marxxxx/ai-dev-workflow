+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createStore, ValidationError } from '../src/store.mjs';
+
+const at = (iso) => createStore({ now: () => new Date(iso) });
+
+test('defaults dueDate to null', () => {
+  assert.deepEqual(at('2026-10-23T12:00:00Z').add({ title: 'A' }), {
+    id: 1,
+    title: 'A',
+    done: false,
+    dueDate: null,
+    overdue: false,
+  });
+});
+
+test('validates dueDate', () => {
+  const s = at('2026-10-23T12:00:00Z');
+  for (const bad of ['2026-02-30', '2027-02-29', '2026-10-23T10:00', '2026-1-5', '', 'morgen', 20261023]) {
+    assert.throws(() => s.add({ title: 'A', dueDate: bad }), ValidationError, String(bad));
+  }
+  assert.equal(s.add({ title: 'A', dueDate: '2028-02-29' }).dueDate, '2028-02-29');
+  const t = s.add({ title: 'B' });
+  assert.throws(() => s.update(t.id, { dueDate: '2026-13-01' }), ValidationError);
+});
+
+test('sets, changes and removes dueDate via update', () => {
+  const s = at('2026-10-23T12:00:00Z');
+  const t = s.add({ title: 'A', dueDate: '2026-10-30' });
+  assert.equal(s.update(t.id, { dueDate: '2026-11-01' }).dueDate, '2026-11-01');
+  assert.equal(s.update(t.id, { dueDate: null }).dueDate, null);
+  assert.equal(s.update(t.id, { overdue: true }).overdue, false); // ignored
+});
+
+test('computes overdue', () => {
+  const s = at('2026-10-23T12:00:00Z');
+  const past = s.add({ title: 'gestern', dueDate: '2026-10-22' });
+  assert.equal(past.overdue, true);
+  assert.equal(s.add({ title: 'heute', dueDate: '2026-10-23' }).overdue, false);
+  assert.equal(s.add({ title: 'morgen', dueDate: '2026-10-24' }).overdue, false);
+  assert.equal(s.add({ title: 'ohne' }).overdue, false);
+  assert.equal(s.update(past.id, { done: true }).overdue, false);
+});
+
+test('uses the UTC date for today', () => {
+  const s = at('2026-10-23T23:30:00Z');
+  assert.equal(s.add({ title: 'A', dueDate: '2026-10-23' }).overdue, false);
+  assert.equal(s.add({ title: 'B', dueDate: '2026-10-22' }).overdue, true);
+});
+
+test('filters list by overdue', () => {
+  const s = at('2026-10-23T12:00:00Z');
+  s.add({ title: 'alt', dueDate: '2026-10-01' });
+  s.add({ title: 'neu', dueDate: '2026-11-01' });
+  s.add({ title: 'ohne' });
+  assert.deepEqual(s.list({ overdue: true }).map((t) => t.title), ['alt']);
+  assert.deepEqual(s.list({ overdue: false }).map((t) => t.title), ['neu', 'ohne']);
+  assert.equal(s.list().length, 3);
+});
