diff --git a/test/store.test.mjs b/test/store.test.mjs
new file mode 100644
index 0000000..a93af44
--- /dev/null
+++ b/test/store.test.mjs
@@ -0,0 +1,93 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createStore, ValidationError } from '../src/store.mjs';
+
+// Late UTC on the 23rd: a local-time "today" east of UTC would already be the 24th.
+const now = () => new Date('2026-10-23T23:30:00Z');
+
+test('a todo without dueDate has dueDate null and is not overdue', () => {
+  const store = createStore({ now });
+  assert.deepEqual(store.add({ title: 'A' }), {
+    id: 1,
+    title: 'A',
+    done: false,
+    dueDate: null,
+    overdue: false,
+  });
+});
+
+test('overdue only when dueDate is before today in UTC', () => {
+  const store = createStore({ now });
+  assert.equal(store.add({ title: 'past', dueDate: '2026-10-22' }).overdue, true);
+  assert.equal(store.add({ title: 'today', dueDate: '2026-10-23' }).overdue, false);
+  assert.equal(store.add({ title: 'future', dueDate: '2026-10-24' }).overdue, false);
+});
+
+test('done todos are never overdue', () => {
+  const store = createStore({ now });
+  const todo = store.add({ title: 'A', dueDate: '2026-10-01' });
+  assert.equal(todo.overdue, true);
+  assert.equal(store.update(todo.id, { done: true }).overdue, false);
+  assert.equal(store.get(todo.id).overdue, false);
+});
+
+test('overdue is computed on read as time passes', () => {
+  let t = new Date('2026-10-23T12:00:00Z');
+  const store = createStore({ now: () => t });
+  store.add({ title: 'A', dueDate: '2026-10-23' });
+  assert.equal(store.get(1).overdue, false);
+  t = new Date('2026-10-24T00:00:00Z');
+  assert.equal(store.get(1).overdue, true);
+});
+
+test('dueDate null removes the due date', () => {
+  const store = createStore({ now });
+  store.add({ title: 'A', dueDate: '2026-10-01' });
+  const todo = store.update(1, { dueDate: null });
+  assert.equal(todo.dueDate, null);
+  assert.equal(todo.overdue, false);
+});
+
+test('rejects invalid dueDate values', () => {
+  const store = createStore({ now });
+  store.add({ title: 'A' });
+  for (const dueDate of ['2026-02-29', '2026-1-5', '2026-13-01', '20261005', 'morgen', 20261023, true]) {
+    assert.throws(() => store.add({ title: 'B', dueDate }), ValidationError, String(dueDate));
+    assert.throws(() => store.update(1, { dueDate }), ValidationError, String(dueDate));
+  }
+  assert.equal(store.add({ title: 'leap', dueDate: '2024-02-29' }).dueDate, '2024-02-29');
+});
+
+test('overdue cannot be written', () => {
+  const store = createStore({ now });
+  assert.throws(() => store.add({ title: 'A', overdue: true }), ValidationError);
+  store.add({ title: 'A' });
+  assert.throws(() => store.update(1, { overdue: false }), ValidationError);
+});
+
+test('an invalid patch changes nothing', () => {
+  const store = createStore({ now });
+  store.add({ title: 'A' });
+  assert.throws(() => store.update(1, { title: 'B', dueDate: 'x' }), ValidationError);
+  assert.equal(store.get(1).title, 'A');
+});
+
+test('list filters by overdue', () => {
+  const store = createStore({ now });
+  store.add({ title: 'past', dueDate: '2026-10-01' });
+  store.add({ title: 'today', dueDate: '2026-10-23' });
+  store.add({ title: 'none' });
+  const done = store.add({ title: 'done past', dueDate: '2026-10-01' });
+  store.update(done.id, { done: true });
+  const ids = (todos) => todos.map((todo) => todo.id);
+  assert.deepEqual(ids(store.list({ overdue: true })), [1]);
+  assert.deepEqual(ids(store.list({ overdue: false })), [2, 3, 4]);
+  assert.deepEqual(ids(store.list()), [1, 2, 3, 4]);
+});
+
+test('returned todos are copies', () => {
+  const store = createStore({ now });
+  store.add({ title: 'A' });
+  store.get(1).title = 'X';
+  assert.equal(store.get(1).title, 'A');
+});
