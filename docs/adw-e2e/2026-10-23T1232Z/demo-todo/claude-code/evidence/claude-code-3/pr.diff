+// Accepts a real calendar date as "YYYY-MM-DD"; null or absent means no due date.
+function parseDueDate(value) {
+  if (value === undefined || value === null) return null;
+  if (
+    typeof value !== 'string' ||
+    !/^\d{4}-\d{2}-\d{2}$/.test(value) ||
+    Number.isNaN(Date.parse(`${value}T00:00:00Z`)) ||
+    new Date(`${value}T00:00:00Z`).toISOString().slice(0, 10) !== value
+  ) {
+    throw new ValidationError('dueDate must be a YYYY-MM-DD date or null');
+  }
+  return value;
+}
+
+function rejectOverdue(input) {
+  if ('overdue' in input) throw new ValidationError('overdue is read-only');
+}
