+    private static bool IsOverdue(Todo todo) =>
+        TodoStore.IsOverdue(todo, DateOnly.FromDateTime(DateTime.UtcNow));
+
+    private IEnumerable<Todo> VisibleTodos() =>
+        _overdueOnly
+            ? Store.ListOverdue(DateOnly.FromDateTime(DateTime.UtcNow))
+            : Store.List();
+}
