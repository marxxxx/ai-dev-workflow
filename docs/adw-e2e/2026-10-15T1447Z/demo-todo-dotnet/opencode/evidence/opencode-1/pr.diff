+</button>
+
 <ul data-testid="todo-list">
-    @foreach (var todo in Store.List())
+    @foreach (var todo in Store.List(OverdueOnly))
     {
         <li data-testid="todo-item">
             <span data-testid="todo-title">@todo.Title@(todo.Done ? " ✓" : "")</span>
+            @if (todo.DueDate is { } due)
+            {
+                <span data-testid="todo-due"> – fällig @due.ToString("yyyy-MM-dd")</span>
+                @if (todo.IsOverdue(DateOnly.FromDateTime(DateTime.UtcNow)))
+                {
+                    <span data-testid="todo-overdue"> – überfällig</span>
+                }
+            }
         </li>
     }
 </ul>
+
+@code {
+    private bool OverdueOnly { get; set; }
+
+    private void ToggleOverdueOnly() => OverdueOnly = !OverdueOnly;
+}
