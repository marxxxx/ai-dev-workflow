+function isValidDate(str) {
+  if (typeof str !== 'string' || !/^\d{4}-\d{2}-\d{2}$/.test(str)) return false;
+  const [y, m, d] = str.split('-').map(Number);
+  const date = new Date(Date.UTC(y, m - 1, d));
+  return (
+    date.getUTCFullYear() === y && date.getUTCMonth() === m - 1 && date.getUTCDate() === d
+  );
+}
+
+function applyDueDate(todo, dueDate) {
+  if (dueDate === null) {
+    todo.dueDate = null;
+  } else if (typeof dueDate === 'string') {
+    if (!isValidDate(dueDate)) {
+      throw new ValidationError('dueDate must be an ISO date (YYYY-MM-DD) or null');
+    }
+    todo.dueDate = dueDate;
+  } else {
+    throw new ValidationError('dueDate must be an ISO date (YYYY-MM-DD) or null');
+  }
+}
+
 // In-memory todo store.
 export function createStore() {
   const todos = new Map();
   let nextId = 1;
   return {
-    list() {
-      return [...todos.values()];
+    list({ overdue = false } = {}) {
+      const all = [...todos.values()];
+      if (!overdue) return all;
+      const today = new Date().toISOString().slice(0, 10);
+      return all.filter((t) => !t.done && t.dueDate !== null && t.dueDate < today);
     },
     get(id) {
       return todos.get(id);
     },
-    add({ title }) {
+    add({ title, dueDate }) {
       if (typeof title !== 'string' || title.trim() === '') {
         throw new ValidationError('title is required');
       }
-      const todo = { id: nextId++, title: title.trim(), done: false };
+      const todo = { id: nextId++, title: title.trim(), done: false, dueDate: null };
+      if (dueDate !== undefined) applyDueDate(todo, dueDate);
       todos.set(todo.id, todo);
       return todo;
     },
@@ -30,6 +56,9 @@ export function createStore() {
         if (typeof patch.done !== 'boolean') throw new ValidationError('done must be a boolean');
         todo.done = patch.done;
       }
+      if ('dueDate' in patch) {
+        applyDueDate(todo, patch.dueDate);
+      }
       return todo;
     },
