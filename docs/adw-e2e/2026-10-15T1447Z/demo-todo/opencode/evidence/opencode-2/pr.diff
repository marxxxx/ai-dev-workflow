 <head><meta charset="utf-8"><title>demo-todo</title></head>
 <body>
   <h1>Todos</h1>
+  <button data-testid="overdue-filter" aria-pressed="false">nur überfällige</button>
   <ul data-testid="todo-list"></ul>
   <script type="module">
     const list = document.querySelector('[data-testid="todo-list"]');
-    const todos = await (await fetch('/todos')).json();
-    for (const todo of todos) {
-      const li = document.createElement('li');
-      li.dataset.testid = 'todo-item';
-      const title = document.createElement('span');
-      title.dataset.testid = 'todo-title';
-      title.textContent = todo.title + (todo.done ? ' ✓' : '');
-      li.append(title);
-      list.append(li);
+    const filterBtn = document.querySelector('[data-testid="overdue-filter"]');
+    let overdueOnly = false;
+
+    const todayIso = () => new Date().toISOString().slice(0, 10);
+    const isOverdue = (todo) => !todo.done && todo.dueDate !== null && todo.dueDate < todayIso();
+    const formatDate = (iso) => `${iso.slice(8)}.${iso.slice(5, 7)}.${iso.slice(0, 4)}`;
+
+    function render(todos) {
+      list.replaceChildren();
+      for (const todo of todos) {
+        const li = document.createElement('li');
+        li.dataset.testid = 'todo-item';
+        const title = document.createElement('span');
+        title.dataset.testid = 'todo-title';
+        title.textContent = todo.title + (todo.done ? ' ✓' : '');
+        li.append(title);
+        if (todo.dueDate !== null) {
+          const due = document.createElement('span');
+          due.dataset.testid = 'todo-due-date';
+          due.textContent = ` (fällig: ${formatDate(todo.dueDate)})`;
+          li.append(due);
+        }
+        if (isOverdue(todo)) {
+          const marker = document.createElement('span');
+          marker.dataset.testid = 'todo-overdue';
+          marker.textContent = ' überfällig';
+          li.append(marker);
+        }
+        list.append(li);
+      }
     }
+
+    async function load() {
+      const todos = await (await fetch(overdueOnly ? '/todos?overdue=true' : '/todos')).json();
+      render(todos);
+    }
+
+    filterBtn.addEventListener('click', async () => {
+      overdueOnly = !overdueOnly;
+      filterBtn.setAttribute('aria-pressed', String(overdueOnly));
+      await load();
+    });
+
+    await load();
   </script>
 </body>
 </html>
