+      }
     }
+    async function load() {
+      const url = filter.checked ? '/todos?overdue=true' : '/todos';
+      render(await (await fetch(url)).json());
+    }
+    filter.addEventListener('change', load);
+    await load();
   </script>
 </body>
 </html>
