diff --git a/test/store.test.mjs b/test/store.test.mjs
new file mode 100644
index 0000000..a0af839
--- /dev/null
+++ b/test/store.test.mjs
@@ -0,0 +1,46 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createStore, ValidationError } from '../src/store.mjs';
+
+test('add stores a valid dueDate', () => {
+  const store = createStore();
+  const todo = store.add({ title: 'A', dueDate: '2026-10-20' });
+  assert.equal(todo.dueDate, '2026-10-20');
+});
+
+test('add defaults dueDate to null', () => {
+  const store = createStore();
+  assert.equal(store.add({ title: 'A' }).dueDate, null);
+});
+
+test('add rejects invalid dueDate values', () => {
+  const store = createStore();
+  for (const dueDate of ['2026-02-30', '2026-13-01', '2026-1-5', '20.10.2026', '2026/10/20', 'tomorrow', 42, true, {}]) {
+    assert.throws(() => store.add({ title: 'A', dueDate }), ValidationError, `dueDate=${JSON.stringify(dueDate)}`);
+  }
+});
+
+test('add accepts leap day 2028-02-29', () => {
+  const store = createStore();
+  assert.equal(store.add({ title: 'A', dueDate: '2028-02-29' }).dueDate, '2028-02-29');
+});
+
+test('add rejects non-leap 2026-02-29', () => {
+  const store = createStore();
+  assert.throws(() => store.add({ title: 'A', dueDate: '2026-02-29' }), ValidationError);
+});
+
+test('update sets, changes and clears dueDate', () => {
+  const store = createStore();
+  store.add({ title: 'A' });
+  assert.equal(store.update(1, { dueDate: '2026-10-20' }).dueDate, '2026-10-20');
+  assert.equal(store.update(1, { dueDate: '2026-11-01' }).dueDate, '2026-11-01');
+  assert.equal(store.update(1, { dueDate: null }).dueDate, null);
+});
+
+test('update rejects invalid dueDate', () => {
+  const store = createStore();
+  store.add({ title: 'A' });
+  assert.throws(() => store.update(1, { dueDate: '2026-02-30' }), ValidationError);
+  assert.throws(() => store.update(1, { dueDate: 'nope' }), ValidationError);
+});
