+function applyDueDate(todo, dueDate) {
+  if (dueDate === null) {
+    todo.dueDate = null;
+    return;
+  }
+  if (!isValidDueDate(dueDate)) {
+    throw new ValidationError('dueDate must be a YYYY-MM-DD date or null');
+  }
+  todo.dueDate = dueDate;
+}
+
+export function isValidDueDate(value) {
+  if (typeof value !== 'string' || !/^\d{4}-\d{2}-\d{2}$/.test(value)) return false;
+  const date = new Date(`${value}T00:00:00Z`);
+  return !Number.isNaN(date.getTime()) && date.toISOString().slice(0, 10) === value;
+}
+
+export function isOverdue(todo, todayUtc = new Date().toISOString().slice(0, 10)) {
+  return !todo.done && todo.dueDate != null && todo.dueDate < todayUtc;
+}
+
 export class ValidationError extends Error {}
