+  d.setUTCDate(d.getUTCDate() + days);
+  return d.toISOString().slice(0, 10);
+};
+
+test('filters overdue todos', () =>
+  withServer(async (base) => {
+    await fetch(`${base}/todos`, json('POST', { title: 'past', dueDate: shiftDays(-1) }));
+    await fetch(`${base}/todos`, json('POST', { title: 'today', dueDate: shiftDays(0) }));
+    await fetch(`${base}/todos`, json('POST', { title: 'future', dueDate: shiftDays(1) }));
+    await fetch(`${base}/todos`, json('POST', { title: 'done past', dueDate: shiftDays(-1) }));
+    await fetch(`${base}/todos/4`, json('PATCH', { done: true }));
+    await fetch(`${base}/todos`, json('POST', { title: 'no date' }));
+    const res = await fetch(`${base}/todos?overdue=true`);
+    const list = await res.json();
+    assert.deepEqual(list.map((t) => t.title), ['past']);
+  }));
+
+test('a todo due today is not overdue', () =>
+  withServer(async (base) => {
+    await fetch(`${base}/todos`, json('POST', { title: 'today', dueDate: shiftDays(0) }));
+    const list = await (await fetch(`${base}/todos?overdue=true`)).json();
+    assert.deepEqual(list, []);
+  }));
+
+test('a done todo with a past due date is not overdue', () =>
+  withServer(async (base) => {
+    await fetch(`${base}/todos`, json('POST', { title: 'done past', dueDate: shiftDays(-1) }));
+    await fetch(`${base}/todos/1`, json('PATCH', { done: true }));
+    const list = await (await fetch(`${base}/todos?overdue=true`)).json();
+    assert.deepEqual(list, []);
+  }));
+
+test('GET /todos without filter returns all todos', () =>
+  withServer(async (base) => {
+    await fetch(`${base}/todos`, json('POST', { title: 'past', dueDate: shiftDays(-1) }));
+    await fetch(`${base}/todos`, json('POST', { title: 'no date' }));
+    const list = await (await fetch(`${base}/todos`)).json();
+    assert.equal(list.length, 2);
+    assert.equal(list[0].dueDate, shiftDays(-1));
+    assert.equal(list[1].dueDate, null);
+  }));
