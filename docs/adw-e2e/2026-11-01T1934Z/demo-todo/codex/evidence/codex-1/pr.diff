+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createStore, ValidationError } from '../src/store.mjs';
+
+const fixedStore = () => createStore({ now: () => new Date('2026-11-01T12:00:00Z') });
+
+test('defaults an omitted or null due date to null', () => {
+  const store = fixedStore();
+  assert.deepEqual(store.add({ title: ' A ' }), {
+    id: 1, title: 'A', done: false, dueDate: null, overdue: false,
+  });
+  assert.deepEqual(store.add({ title: 'B', dueDate: null }), {
+    id: 2, title: 'B', done: false, dueDate: null, overdue: false,
+  });
+});
+
+test('sets, preserves, changes and removes a due date', () => {
+  const store = fixedStore();
+  assert.equal(store.add({ title: 'A', dueDate: '2026-10-31' }).overdue, true);
+  assert.equal(store.update(1, { title: 'B' }).dueDate, '2026-10-31');
+  assert.equal(store.update(1, { dueDate: '2026-11-02' }).overdue, false);
+  assert.equal(store.get(1).dueDate, '2026-11-02');
+  assert.equal(store.update(1, { dueDate: null }).dueDate, null);
+  assert.equal(store.get(1).overdue, false);
+  assert.equal(store.update(1, { dueDate: '2026-10-30' }).overdue, true);
+});
+
+for (const date of ['0001-01-01', '0099-12-31', '2000-02-29', '2024-02-29', '9999-12-31']) {
+  test(`accepts the real calendar date ${date}`, () => {
+    const store = fixedStore();
+    assert.equal(store.add({ title: 'A', dueDate: date }).dueDate, date);
+    assert.equal(store.update(1, { dueDate: date }).dueDate, date);
+  });
+}
+
+const invalidDates = [
+  '0000-01-01', '1900-02-29', '2026-02-29', '2026-02-30', '2026-13-01',
+  '2026-00-01', '2026-11-00', '2026-04-31', '2026-1-01', '2026-11-1',
+  '2026-11-01T00:00:00Z', ' 2026-11-01', '2026-11-01\n', '', 42, false, {}, [],
+];
+for (const date of invalidDates) {
+  test(`rejects invalid due date ${JSON.stringify(date)} without changing stored data`, () => {
+    const store = fixedStore();
+    assert.throws(() => store.add({ title: 'Invalid', dueDate: date }), ValidationError);
+    assert.deepEqual(store.list(), []);
+    const original = store.add({ title: 'A', dueDate: '2026-10-31' });
+    assert.equal(original.id, 1);
+    assert.throws(() => store.update(1, { title: 'Changed', done: true, dueDate: date }), ValidationError);
+    assert.deepEqual(store.get(1), original);
+  });
+}
+
+test('validates all patch fields before modifying a todo', () => {
+  const store = fixedStore();
+  const original = store.add({ title: 'A', dueDate: '2026-10-31' });
+  for (const patch of [
+    { title: 'Changed', dueDate: null, done: 'yes' },
+    { title: ' ', dueDate: '2026-11-02', done: true },
+  ]) {
+    assert.throws(() => store.update(1, patch), ValidationError);
+    assert.deepEqual(store.get(1), original);
+  }
+});
+
+test('filters only unfinished past-due todos while preserving insertion order', () => {
+  const store = fixedStore();
+  for (const [title, dueDate] of [
+    ['Past A', '2026-10-31'], ['Today', '2026-11-01'], ['Future', '2026-11-02'],
+    ['No date', null], ['Done', '2026-10-30'], ['Past B', '2026-10-29'],
+  ]) store.add({ title, dueDate });
+  store.update(5, { done: true });
+  assert.deepEqual(store.list().map(t => t.overdue), [true, false, false, false, false, true]);
+  assert.deepEqual(store.list({ overdueOnly: true }).map(t => t.id), [1, 6]);
+  assert.deepEqual(store.list({ overdueOnly: false }).map(t => t.id), [1, 2, 3, 4, 5, 6]);
+  store.update(1, { done: true });
+  store.update(6, { dueDate: null });
+  assert.deepEqual(store.list({ overdueOnly: true }), []);
+});
+
+test('recomputes overdue at UTC midnight without any writes', () => {
+  let instant = new Date('2026-11-01T23:59:59Z');
+  const store = createStore({ now: () => instant });
+  const todo = store.add({ title: 'A', dueDate: '2026-11-01' });
+  assert.equal(todo.overdue, false);
+  assert.deepEqual(store.list({ overdueOnly: true }), []);
+  instant = new Date('2026-11-02T00:00:00Z');
+  assert.equal(store.get(1).overdue, true);
+  assert.deepEqual(store.list({ overdueOnly: true }).map(t => t.id), [1]);
+  assert.equal(store.update(1, { done: true }).overdue, false);
+  assert.equal(store.update(1, { done: false }).overdue, true);
+});
+
+test('uses the UTC date when the local date in a supplied instant differs', () => {
+  const store = createStore({ now: () => new Date('2026-11-01T23:30:00-02:00') });
+  assert.equal(store.add({ title: 'A', dueDate: '2026-11-01' }).overdue, true);
+  assert.equal(store.add({ title: 'B', dueDate: '2026-11-02' }).overdue, false);
+});
+
+test('retains missing-id and deletion behavior', () => {
+  const store = fixedStore();
+  assert.equal(store.get(99), undefined);
+  assert.equal(store.update(99, { dueDate: 'invalid' }), undefined);
+  store.add({ title: 'A', dueDate: '2026-10-31' });
+  assert.equal(store.remove(1), true);
+  assert.equal(store.remove(1), false);
+  assert.deepEqual(store.list(), []);
+});
