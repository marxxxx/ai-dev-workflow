+++ b/test/ui.test.mjs
@@ -0,0 +1,181 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { runInNewContext } from 'node:vm';
+
+// Minimal DOM boundary for executing the real inline script without dependencies.
+class Element {
+  children = [];
+  dataset = {};
+  checked = false;
+  hidden = false;
+  listeners = {};
+  ownText = '';
+  constructor(tagName) { this.tagName = tagName; }
+  set textContent(value) { this.ownText = value; this.children = []; }
+  get textContent() { return this.ownText + this.children.map(c => typeof c === 'string' ? c : c.textContent).join(''); }
+  append(...children) { this.children.push(...children); }
+  replaceChildren(...children) { this.ownText = ''; this.children = [...children]; }
+  addEventListener(name, callback) { this.listeners[name] = callback; }
+  find(testid) {
+    if (this.dataset.testid === testid) return this;
+    return this.children.filter(c => typeof c !== 'string').map(c => c.find(testid)).find(Boolean);
+  }
+}
+
+async function openPage() {
+  const html = await readFile(new URL('../public/index.html', import.meta.url), 'utf8');
+  const elements = new Map();
+  for (const [markup, tag, testid] of html.matchAll(/<(\w+)\b[^>]*data-testid="([^"]+)"[^>]*>/g)) {
+    const element = new Element(tag);
+    element.dataset.testid = testid;
+    element.hidden = /\bhidden\b/.test(markup);
+    elements.set(testid, element);
+  }
+  const requests = [];
+  const ready = runInNewContext(`(async () => {${html.match(/<script type="module">([\s\S]*?)<\/script>/)[1]}})()`, {
+    document: {
+      querySelector: selector => elements.get(selector.match(/data-testid="([^"]+)"/)[1]) ?? null,
+      createElement: tag => new Element(tag),
+    },
+    fetch: url => {
+      const deferred = Promise.withResolvers();
+      requests.push({ url, ...deferred });
+      return deferred.promise;
+    },
+  });
+  return {
+    ready, requests, list: elements.get('todo-list'), filter: elements.get('overdue-filter'),
+    error: elements.get('todo-error'),
+    reply(index, data, ok = true) { requests[index].resolve({ ok, json: async () => data }); },
+    change(checked) {
+      const filter = elements.get('overdue-filter');
+      assert.ok(filter, 'the overdue filter is available');
+      filter.checked = checked;
+      assert.equal(typeof filter.listeners.change, 'function', 'checkbox changes reload the list');
+      return filter.listeners.change();
+    },
+  };
+}
+
+const past = { id: 1, title: '<b>Past</b>', done: false, dueDate: '2026-10-31', overdue: true };
+const today = { id: 2, title: 'Today', done: false, dueDate: '2026-11-01', overdue: false };
+const undated = { id: 3, title: 'Undated', done: false, dueDate: null, overdue: false };
+const done = { id: 4, title: 'Done', done: true, dueDate: '2026-10-30', overdue: false };
+
+test('renders API dates beside titles and marks only overdue todos as text', async () => {
+  const ui = await openPage();
+  ui.reply(0, [past, today, undated, done]);
+  await ui.ready;
+  assert.equal(ui.list.children.length, 4);
+  const [a, b, c, d] = ui.list.children;
+  assert.equal(a.find('todo-title').textContent, '<b>Past</b>');
+  assert.equal(a.find('todo-title').children.length, 0, 'title is plain text');
+  assert.equal(a.find('todo-due-date')?.textContent.trim(), '2026-10-31');
+  assert.equal(a.find('todo-overdue')?.textContent.trim(), 'überfällig');
+  assert.ok(a.children.indexOf(a.find('todo-due-date')) > a.children.indexOf(a.find('todo-title')));
+  assert.equal(b.find('todo-due-date')?.textContent.trim(), '2026-11-01');
+  assert.equal(b.find('todo-overdue'), undefined);
+  assert.equal(c.find('todo-due-date'), undefined);
+  assert.equal(c.find('todo-overdue'), undefined);
+  assert.equal(d.find('todo-title').textContent, 'Done ✓');
+  assert.equal(d.find('todo-overdue'), undefined);
+});
+
+test('checkbox loads the server filter, replaces results and recovers from empty results', async () => {
+  const ui = await openPage();
+  ui.reply(0, [past, today]);
+  await ui.ready;
+  assert.equal(ui.requests[0].url, '/todos');
+  assert.ok(ui.filter);
+  assert.equal(ui.filter.checked, false);
+  let changed = ui.change(true);
+  assert.equal(ui.requests[1].url, '/todos?overdue=true');
+  ui.reply(1, [past]);
+  await changed;
+  assert.equal(ui.list.children.length, 1);
+  assert.equal(ui.list.children[0].find('todo-title').textContent, '<b>Past</b>');
+  changed = ui.change(false);
+  assert.equal(ui.requests[2].url, '/todos');
+  ui.reply(2, [today]);
+  await changed;
+  assert.equal(ui.list.children.length, 1);
+  assert.equal(ui.list.children[0].find('todo-title').textContent, 'Today');
+  changed = ui.change(true);
+  ui.reply(3, []);
+  await changed;
+  assert.equal(ui.list.children.length, 0);
+  changed = ui.change(false);
+  ui.reply(4, [today]);
+  await changed;
+  assert.equal(ui.list.children.length, 1);
+});
+
+test('a slow filter response cannot overwrite the last checkbox selection', async () => {
+  const ui = await openPage();
+  ui.reply(0, [past, today]);
+  await ui.ready;
+  const slow = ui.change(true);
+  const latest = ui.change(false);
+  ui.reply(2, [past, today]);
+  await latest;
+  ui.reply(1, [past]);
+  await slow;
+  assert.equal(ui.filter.checked, false);
+  assert.equal(ui.list.children.length, 2);
+});
+
+test('a slow initial response cannot overwrite a newer filtered list', async () => {
+  const ui = await openPage();
+  const latest = ui.change(true);
+  ui.reply(1, [past]);
+  await latest;
+  ui.reply(0, [past, today]);
+  await ui.ready;
+  assert.equal(ui.filter.checked, true);
+  assert.equal(ui.list.children.length, 1);
+});
+
+for (const failure of ['network', 'http']) {
+  test(`a failed ${failure} filter request clears stale rows and allows recovery`, async () => {
+    const ui = await openPage();
+    ui.reply(0, [past, today]);
+    await ui.ready;
+    const changed = ui.change(true);
+    if (failure === 'network') ui.requests[1].reject(new Error('Offline'));
+    else ui.reply(1, [], false);
+    await assert.doesNotReject(changed);
+    assert.equal(ui.filter.checked, true);
+    assert.equal(ui.list.children.length, 0, 'old unfiltered rows are cleared');
+    assert.equal(ui.error?.hidden, false, 'failure is visible');
+    assert.ok(ui.error.textContent.length > 0);
+    const recovered = ui.change(false);
+    ui.reply(2, [past, today]);
+    await recovered;
+    assert.equal(ui.list.children.length, 2);
+    assert.equal(ui.error.hidden, true);
+  });
+}
+
+test('a failed unfilter request cannot silently retain an incomplete list', async () => {
+  const ui = await openPage();
+  ui.reply(0, [past, today]); await ui.ready;
+  const filtered = ui.change(true); ui.reply(1, [past]); await filtered;
+  const changed = ui.change(false); ui.requests[2].reject(new Error('Offline'));
+  await assert.doesNotReject(changed);
+  assert.equal(ui.filter.checked, false);
+  assert.equal(ui.list.children.length, 0);
+  assert.equal(ui.error?.hidden, false);
+});
+
+test('a stale request failure cannot clear newer results or show an outdated error', async () => {
+  const ui = await openPage();
+  ui.reply(0, [past, today]); await ui.ready;
+  const slow = ui.change(true);
+  const latest = ui.change(false);
+  ui.reply(2, [past, today]); await latest;
+  ui.requests[1].reject(new Error('Old offline response'));
+  await assert.doesNotReject(slow);
+  assert.equal(ui.list.children.length, 2);
+  assert.equal(ui.error?.hidden, true);
+});
