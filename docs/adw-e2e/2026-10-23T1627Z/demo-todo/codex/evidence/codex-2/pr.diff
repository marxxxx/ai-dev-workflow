+function validateDueDate(value) {
+  if (value === null) return;
+  const invalid = () => { throw new ValidationError('dueDate must be a valid YYYY-MM-DD date or null'); };
+  if (typeof value !== 'string' || value.length !== 10 || !/^\d{4}-\d{2}-\d{2}$/.test(value)) {
