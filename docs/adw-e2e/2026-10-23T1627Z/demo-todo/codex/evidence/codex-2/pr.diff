+      [{ overdue: true }, {}],
+    ]) {
+      const updated = await fetch(`${base}/todos/1`, json('PATCH', patch));
+      assert.equal(updated.status, 200);
+      Object.assign(expected, changes);
+      assert.deepEqual(await updated.json(), expected);
+      assert.deepEqual(await (await fetch(`${base}/todos/1`)).json(), expected);
+    }
+    const undated = await fetch(`${base}/todos`, json('POST', { title: 'B', dueDate: null }));
+    assert.deepEqual(await undated.json(), {
+      id: 2, title: 'B', done: false, dueDate: null, overdue: false,
+    });
+  }, fixedStore()));
+
+test('overdue query selects only open past-due todos and preserves order', () =>
+  withServer(async (base) => {
+    for (const [title, dueDate] of [
+      ['yesterday', '2026-10-22'], ['undated', null], ['today', '2026-10-23'],
+      ['tomorrow', '2026-10-24'], ['done yesterday', '2026-10-22'],
+    ]) {
+      await fetch(`${base}/todos`, json('POST', { title, dueDate }));
+    }
+    await fetch(`${base}/todos/5`, json('PATCH', { done: true }));
+    const filtered = await fetch(`${base}/todos?overdue=true`);
+    assert.equal(filtered.status, 200);
+    assert.deepEqual(await filtered.json(), [
+      { id: 1, title: 'yesterday', done: false, dueDate: '2026-10-22', overdue: true },
+    ]);
+    for (const query of ['', '?overdue=false']) {
+      const all = await fetch(`${base}/todos${query}`);
+      assert.equal(all.status, 200);
+      assert.deepEqual((await all.json()).map(todo => todo.id), [1, 2, 3, 4, 5]);
+    }
+    await fetch(`${base}/todos/1`, json('PATCH', { done: true }));
+    assert.deepEqual(await (await fetch(`${base}/todos?overdue=true`)).json(), []);
+  }, fixedStore()));
+
+test('overdue filter rejects values other than exact true or false', () =>
+  withServer(async (base) => {
+    for (const value of ['', '1', 'TRUE', 'null', ' true', 'false ']) {
+      const response = await fetch(`${base}/todos?overdue=${encodeURIComponent(value)}`);
+      assert.equal(response.status, 400, JSON.stringify(value));
+      assert.equal(typeof (await response.json()).error, 'string');
+    }
+  }));
+
+test('invalid date requests return 400 without creating or partially updating todos', () =>
+  withServer(async (base) => {
+    for (const dueDate of ['2026-02-30', '2026-2-03', '1900-02-29', '', '2026-10-23T00:00:00Z', 12, false, {}, []]) {
+      const res = await fetch(`${base}/todos`, json('POST', { title: 'bad', dueDate }));
+      assert.equal(res.status, 400, JSON.stringify(dueDate));
+    }
+    assert.deepEqual(await (await fetch(`${base}/todos`)).json(), []);
+    const created = await fetch(`${base}/todos`, json('POST', { title: 'A', dueDate: '2028-02-29' }));
+    assert.equal(created.status, 201);
+    const before = await created.json();
+    for (const patch of [
+      { title: 'changed', done: true, dueDate: '2026-02-30' },
+      { title: 'changed', done: 'yes', dueDate: null },
+    ]) {
+      const res = await fetch(`${base}/todos/1`, json('PATCH', patch));
+      assert.equal(res.status, 400);
+      assert.deepEqual(await (await fetch(`${base}/todos/1`)).json(), before);
+    }
+  }, fixedStore()));
+
+test('due-date changes preserve missing-id and deletion behavior', () =>
+  withServer(async (base) => {
+    for (const method of ['GET', 'PATCH', 'DELETE']) {
+      const response = await fetch(`${base}/todos/999`, method === 'PATCH'
+        ? json('PATCH', { dueDate: '2026-10-22' }) : { method });
+      assert.equal(response.status, 404);
+    }
+    await fetch(`${base}/todos`, json('POST', { title: 'A', dueDate: '2026-10-22' }));
+    assert.equal((await fetch(`${base}/todos/1`, { method: 'DELETE' })).status, 204);
+    assert.deepEqual(await (await fetch(`${base}/todos?overdue=true`)).json(), []);
+  }, fixedStore()));
diff --git a/test/store.test.mjs b/test/store.test.mjs
new file mode 100644
index 0000000..964a268
--- /dev/null
+++ b/test/store.test.mjs
@@ -0,0 +1,126 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createStore, ValidationError } from '../src/store.mjs';
+
+const fixedStore = () => createStore({ now: () => new Date('2026-10-23T00:30:00Z') });
+
+test('undated todos have explicit null dates and are never overdue', () => {
+  const store = fixedStore();
+  assert.deepEqual(store.add({ title: ' A ' }), {
+    id: 1, title: 'A', done: false, dueDate: null, overdue: false,
+  });
+  assert.equal(store.add({ title: 'B', dueDate: null }).overdue, false);
+});
+
+test('overdue means strictly before today UTC and not done', () => {
+  const store = fixedStore();
+  for (const [dueDate, expected] of [
+    ['2026-10-22', true], ['2026-10-23', false], ['2026-10-24', false], [null, false],
+  ]) {
+    const todo = store.add({ title: 'A', dueDate });
+    assert.equal(todo.overdue, expected, String(dueDate));
+    assert.equal(store.update(todo.id, { done: true }).overdue, false);
+    assert.equal(store.update(todo.id, { done: false }).overdue, expected);
+  }
+});
+
+test('overdue is recalculated across UTC midnight without updating todos', () => {
+  let instant = '2026-10-23T23:59:59.999Z';
+  const store = createStore({ now: () => new Date(instant) });
+  store.add({ title: 'A' });
+  assert.equal(store.add({ title: 'today', dueDate: '2026-10-23' }).overdue, false);
+  instant = '2026-10-24T00:00:00.000Z';
+  assert.equal(store.get(2).overdue, true);
+  assert.equal(store.list()[1].overdue, true);
+  assert.equal(store.update(2, { done: true }).overdue, false);
+  assert.equal(store.update(2, { dueDate: null }).dueDate, null);
+});
+
+test('one list uses one UTC date even when the clock crosses midnight', () => {
+  let reads = 0;
+  const store = createStore({ now: () => new Date(
+    reads++ === 0 ? '2026-10-23T23:59:59.999Z' : '2026-10-24T00:00:00Z',
+  ) });
+  store.add({ title: 'A', dueDate: '2026-10-23' });
+  store.add({ title: 'B', dueDate: '2026-10-23' });
+  reads = 0;
+  assert.deepEqual(store.list().map(todo => todo.overdue), [false, false]);
+  assert.equal(reads, 1);
+});
+
+test('patch can set, change, preserve and remove the date', () => {
+  const store = fixedStore();
+  store.add({ title: 'A' });
+  assert.equal(store.update(1, { dueDate: '2026-10-22' }).overdue, true);
+  assert.equal(store.update(1, { title: 'B' }).dueDate, '2026-10-22');
+  assert.equal(store.update(1, { dueDate: '2026-10-24' }).overdue, false);
+  assert.equal(store.update(1, { dueDate: null }).dueDate, null);
+  assert.equal(store.get(1).overdue, false);
+});
+
+test('only overdue todos are filtered, in existing insertion order', () => {
+  const store = fixedStore();
+  for (const dueDate of ['2026-10-22', null, '2026-10-23', '2026-10-24', '2026-10-21', '2026-10-20']) {
+    store.add({ title: 'A', dueDate });
+  }
+  store.update(5, { done: true });
+  assert.deepEqual(store.list({ overdue: true }).map(todo => todo.id), [1, 6]);
+  assert.equal(store.list({ overdue: false }).length, 6);
+  assert.equal(store.list().length, 6);
+  store.update(1, { done: true });
+  store.update(6, { dueDate: null });
+  assert.deepEqual(store.list({ overdue: true }), []);
+});
+
+test('accepts real dates including Gregorian leap years and early years', () => {
+  const store = fixedStore();
+  for (const dueDate of ['2000-02-29', '2028-02-29', '0001-01-01', '0099-12-31', '9999-12-31']) {
+    assert.equal(store.add({ title: 'A', dueDate }).dueDate, dueDate);
+    assert.equal(store.update(1, { dueDate }).dueDate, dueDate);
+  }
+});
+
+const invalidDates = [
+  '', ' ', '2026-2-03', '26-02-03', '2026-02-03 ', '2026-02-03\n',
+  '2026-02-03T00:00:00Z', '2026-02-30', '2026-04-31', '1900-02-29',
+  '2026-00-10', '2026-13-01', '2026-01-00', '2026-01-32', 0, true, [], {},
+];
+
+for (const dueDate of invalidDates) {
+  test(`rejects invalid date ${JSON.stringify(dueDate)} on add and update`, () => {
+    const store = fixedStore();
+    assert.throws(() => store.add({ title: 'A', dueDate }), ValidationError);
+    assert.deepEqual(store.list(), []);
+    store.add({ title: 'A', dueDate: '2026-10-22' });
+    const before = store.get(1);
+    assert.throws(() => store.update(1, { title: 'changed', done: true, dueDate }), ValidationError);
+    assert.deepEqual(store.get(1), before);
+  });
+}
+
+test('failed multi-field updates preserve all stored fields', () => {
+  const store = fixedStore();
+  const before = store.add({ title: 'A', dueDate: '2026-10-22' });
+  for (const patch of [
+    { title: 'changed', done: 'yes', dueDate: '2026-10-24' },
+    { title: '', done: true, dueDate: null },
+    { title: 'changed', done: true, dueDate: '2026-02-30' },
+  ]) {
+    assert.throws(() => store.update(1, patch), ValidationError);
+    assert.deepEqual(store.get(1), before);
+  }
+});
+
+test('client overdue values and response mutations cannot change stored data', () => {
+  const store = fixedStore();
+  const expected = { id: 1, title: 'A', done: false, dueDate: '2026-10-22', overdue: true };
+  const added = store.add({ title: 'A', dueDate: '2026-10-22', overdue: false });
+  assert.deepEqual(added, expected);
+  for (const response of [added, store.get(1), store.list()[0], store.update(1, { overdue: false })]) {
+    assert.deepEqual(response, expected);
+    response.title = 'changed';
+    response.dueDate = null;
+    response.done = true;
+    assert.deepEqual(store.get(1), expected);
+  }
+});
diff --git a/test/ui.test.mjs b/test/ui.test.mjs
new file mode 100644
index 0000000..746026d
--- /dev/null
+++ b/test/ui.test.mjs
@@ -0,0 +1,160 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { runInNewContext } from 'node:vm';
+
+const html = await readFile(new URL('../public/index.html', import.meta.url), 'utf8');
+const script = html.match(/<script type="module">([\s\S]*?)<\/script>/)[1];
+
+// Only the DOM boundary is doubled; the page's actual script handles every load/change.
+class Element {
+  children = [];
+  dataset = {};
+  textContent = '';
+  checked = false;
+  hidden = true;
+  handlers = new Map();
+  append(...children) { this.children.push(...children); }
+  replaceChildren(...children) { this.children = [...children]; }
+  addEventListener(name, handler) { this.handlers.set(name, handler); }
+}
+
+async function loadPage(fetch) {
+  const list = new Element();
+  const filter = new Element();
+  const error = new Element();
+  const elements = { 'todo-list': list, 'overdue-filter': filter, 'todo-error': error };
+  const document = {
+    createElement: () => new Element(),
+    querySelector: selector => elements[selector.match(/data-testid=["']([^"']+)["']/)[1]],
+  };
+  await runInNewContext(`(async () => { ${script}\n })()`, { document, fetch });
+  return {
+    list, filter, error,
+    toggle(checked) {
+      filter.checked = checked;
+      assert.equal(typeof filter.handlers.get('change'), 'function', 'filter must handle changes');
+      return filter.handlers.get('change')();
+    },
+  };
+}
+
+const todos = [
+  { id: 1, title: '<b>past</b>', done: false, dueDate: '2026-10-22', overdue: true },
+  { id: 2, title: 'today', done: false, dueDate: '2026-10-23', overdue: false },
+  { id: 3, title: 'done', done: true, dueDate: '2026-10-22', overdue: false },
+  { id: 4, title: 'undated', done: false, dueDate: null, overdue: false },
+];
+const response = data => ({ ok: true, json: async () => data });
+const text = (item, testid) => item.children.find(child => child.dataset.testid === testid)?.textContent;
+const titles = ui => ui.list.children.map(item => text(item, 'todo-title'));
+
+test('list renders safe titles, dates and overdue indicators from API fields', async () => {
+  const urls = [];
+  const ui = await loadPage(async url => { urls.push(url); return response(todos); });
+  assert.deepEqual(urls, ['/todos']);
+  assert.deepEqual(titles(ui), ['<b>past</b>', 'today', 'done ✓', 'undated']);
+  assert.equal(text(ui.list.children[0], 'todo-due-date'), ' Fällig: 2026-10-22');
+  assert.equal(text(ui.list.children[0], 'todo-overdue'), ' Überfällig');
+  assert.equal(text(ui.list.children[1], 'todo-due-date'), ' Fällig: 2026-10-23');
+  assert.equal(text(ui.list.children[1], 'todo-overdue'), undefined);
+  assert.equal(text(ui.list.children[2], 'todo-overdue'), undefined);
+  assert.equal(text(ui.list.children[3], 'todo-due-date'), undefined);
+  assert.equal(text(ui.list.children[3], 'todo-overdue'), undefined);
+});
+
+test('toggling fetches the API filter and replaces rather than duplicates list items', async () => {
+  const urls = [];
+  const ui = await loadPage(async url => {
+    urls.push(url);
+    return response(url === '/todos?overdue=true' ? [todos[0]] : todos);
+  });
+  assert.equal(ui.filter.checked, false);
+  await ui.toggle(true);
+  assert.deepEqual(titles(ui), ['<b>past</b>']);
+  await ui.toggle(false);
+  assert.deepEqual(titles(ui), ['<b>past</b>', 'today', 'done ✓', 'undated']);
+  assert.deepEqual(urls, ['/todos', '/todos?overdue=true', '/todos']);
+});
+
+test('empty filtered results clear the previously displayed list', async () => {
+  const ui = await loadPage(async url => response(url === '/todos' ? todos : []));
+  await ui.toggle(true);
+  assert.deepEqual(titles(ui), []);
+});
+
+test('a stale filter response cannot overwrite the latest checkbox selection', async () => {
+  let first = true;
+  const pending = [];
+  const ui = await loadPage(() => {
+    if (first) { first = false; return response(todos); }
+    return new Promise(resolve => pending.push(resolve));
+  });
+  const older = ui.toggle(true);
+  const newer = ui.toggle(false);
+  pending[1](response(todos));
+  await newer;
+  pending[0](response([todos[0]]));
+  await older;
+  assert.equal(ui.filter.checked, false);
+  assert.deepEqual(titles(ui), ['<b>past</b>', 'today', 'done ✓', 'undated']);
+});
+
+test('filter checkbox has the agreed visible label', () => {
+  assert.match(html, /<label>\s*<input\b[^>]*type="checkbox"[^>]*data-testid="overdue-filter"[^>]*>\s*nur überfällige\s*<\/label>/);
+});
+
+for (const [name, fail] of [
+  ['network failure', () => { throw new Error('offline'); }],
+  ['HTTP failure', () => ({ ok: false, json: async () => todos })],
+  ['invalid JSON', () => ({ ok: true, json: async () => { throw new SyntaxError('invalid JSON'); } })],
+]) {
+  test(`${name} clears misleading filter results, shows an error and allows recovery`, async () => {
+    let requests = 0;
+    const ui = await loadPage(() => ++requests === 2 ? fail() : response(todos));
+    await assert.doesNotReject(async () => ui.toggle(true));
+    assert.deepEqual(titles(ui), []);
+    assert.equal(ui.error.hidden, false);
+    assert.match(ui.error.textContent, /konnte nicht geladen werden/);
+    await ui.toggle(false);
+    assert.deepEqual(titles(ui), ['<b>past</b>', 'today', 'done ✓', 'undated']);
+    assert.equal(ui.error.hidden, true);
+  });
+}
+
+test('initial load failure shows an error instead of an unhandled rejection', async () => {
+  const ui = await loadPage(() => { throw new Error('offline'); });
+  assert.deepEqual(titles(ui), []);
+  assert.equal(ui.error.hidden, false);
+});
+
+test('latest request failure cannot be overwritten by an older successful result', async () => {
+  let requests = 0;
+  let finishOlder;
+  const ui = await loadPage(() => {
+    if (++requests === 1) return response(todos);
+    if (requests === 2) return new Promise(resolve => { finishOlder = resolve; });
+    throw new Error('offline');
+  });
+  const older = ui.toggle(true);
+  await assert.doesNotReject(async () => ui.toggle(false));
+  finishOlder(response([todos[0]]));
+  await older;
+  assert.deepEqual(titles(ui), []);
+  assert.equal(ui.error.hidden, false);
+});
+
+test('older failed request cannot clear the latest successful results', async () => {
+  let requests = 0;
+  let failOlder;
+  const ui = await loadPage(() => {
+    if (++requests === 2) return new Promise((resolve, reject) => { failOlder = reject; });
+    return response(todos);
+  });
+  const older = ui.toggle(true);
+  await ui.toggle(false);
+  failOlder(new Error('offline'));
+  await assert.doesNotReject(async () => older);
+  assert.deepEqual(titles(ui), ['<b>past</b>', 'today', 'done ✓', 'undated']);
+  assert.equal(ui.error.hidden, true);
+});
