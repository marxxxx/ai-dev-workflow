+          }
+          if (todo.overdue) {
+            const overdue = document.createElement('span');
+            overdue.dataset.testid = 'todo-overdue';
+            overdue.textContent = ' Überfällig';
+            li.append(overdue);
+          }
+          return li;
+        });
+        list.replaceChildren(...items);
+        error.hidden = true;
+      } catch {
+        if (request !== latestRequest) return;
+        list.replaceChildren();
+        error.textContent = 'Liste konnte nicht geladen werden. Bitte neu laden oder den Filter erneut umschalten.';
+        error.hidden = false;
+      }
     }
+
+    filter.addEventListener('change', loadTodos);
+    await loadTodos();
   </script>
