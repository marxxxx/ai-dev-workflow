+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createStore, ValidationError } from '../src/store.mjs';
+
+test('defaults new todos to no due date', () => {
+  const store = createStore();
+  assert.equal(store.add({ title: 'A' }).dueDate, null);
+  assert.equal(store.add({ title: 'B', dueDate: null }).dueDate, null);
+});
+
+test('stores valid calendar dates including leap centuries and early years', () => {
+  const store = createStore();
+  for (const dueDate of ['2000-02-29', '2024-02-29', '2026-10-23', '0001-01-01', '0099-12-31', '9999-12-31']) {
+    const todo = store.add({ title: 'A', dueDate });
+    assert.equal(todo.dueDate, dueDate);
+    assert.equal(store.get(todo.id).dueDate, dueDate);
+    assert.equal(store.list().at(-1).dueDate, dueDate);
+  }
+});
+
+const invalidDates = [
+  '0000-01-01', '10000-01-01', '1900-02-29', '2026-02-29', '2026-04-31',
+  '2026-00-01', '2026-13-01', '2026-01-00', '2026-01-32',
+  '', '2026-1-01', '2026-01-1', ' 2026-01-01', '2026-01-01 ',
+  '2026-01-01\n', '2026-01-01T00:00:00Z', 20260101, false, {}, [],
+];
+
+test('rejects invalid due dates without adding a todo or consuming its id', () => {
+  const store = createStore();
+  for (const dueDate of invalidDates) {
+    assert.throws(() => store.add({ title: 'A', dueDate }), ValidationError, JSON.stringify(dueDate));
+    assert.deepEqual(store.list(), []);
+  }
+  assert.equal(store.add({ title: 'A' }).id, 1);
+});
+
+test('sets, replaces, preserves, and removes the due date on updates', () => {
+  const store = createStore();
+  store.add({ title: 'A' });
+  assert.equal(store.update(1, { dueDate: '2026-10-23' }).dueDate, '2026-10-23');
+  assert.equal(store.update(1, { title: 'B', done: true }).dueDate, '2026-10-23');
+  assert.equal(store.update(1, { dueDate: '2026-11-01' }).dueDate, '2026-11-01');
+  assert.equal(store.update(1, { dueDate: null }).dueDate, null);
+  assert.equal(store.update(999, { dueDate: '2026-11-01' }), undefined);
+});
+
+test('rejects invalid date updates without changing any field', () => {
+  const store = createStore();
+  store.add({ title: 'A', dueDate: '2026-10-23' });
+  const before = structuredClone(store.get(1));
+  for (const dueDate of invalidDates) {
+    assert.throws(() => store.update(1, { title: 'B', done: true, dueDate }), ValidationError);
+    assert.deepEqual(store.get(1), before);
+  }
+});
+
+test('rejects mixed patches atomically when another field is invalid', () => {
+  const store = createStore();
+  store.add({ title: 'A', dueDate: '2026-10-23' });
+  const before = structuredClone(store.get(1));
+  for (const patch of [
+    { title: 'B', done: 'yes', dueDate: '2026-10-24' },
+    { title: '', dueDate: '2026-10-24' },
+    { done: 1, dueDate: null },
+  ]) {
+    assert.throws(() => store.update(1, patch), ValidationError);
+    assert.deepEqual(store.get(1), before);
+  }
+});
