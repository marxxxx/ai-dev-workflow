+    todo = await patch({ title: 'Still dated' });
+    assert.equal(todo.dueDate, '2026-10-22');
+    assert.equal(todo.overdue, true);
+    todo = await patch({ dueDate: '2026-10-24' });
+    assert.equal(todo.dueDate, '2026-10-24');
+    assert.equal(todo.overdue, false);
+    todo = await patch({ dueDate: null });
+    assert.equal(todo.dueDate, null);
+    assert.equal(todo.overdue, false);
+    assert.deepEqual((await (await fetch(`${base}/todos?overdue=true`)).json()).map(item => item.id), [1, 6]);
+  }, createApp(datedStore(), fixedNow)));
+
+test('invalid dates return HTTP 400 on POST and PATCH without changing data', () =>
+  withServer(async (base) => {
+    const before = await (await fetch(`${base}/todos/1`)).json();
+    for (const dueDate of ['2026-02-29', '1900-02-29', '2026-04-31', '0000-01-01', '', '2026-1-01', '2026-10-23T00:00:00Z', 123, false, {}, []]) {
+      const created = await fetch(`${base}/todos`, json('POST', { title: 'Invalid', dueDate }));
+      assert.equal(created.status, 400, JSON.stringify(dueDate));
+      assert.match((await created.json()).error, /dueDate/);
+      const updated = await fetch(`${base}/todos/1`, json('PATCH', { title: 'Changed', done: true, dueDate }));
+      assert.equal(updated.status, 400, JSON.stringify(dueDate));
+      assert.match((await updated.json()).error, /dueDate/);
+      assert.deepEqual(await (await fetch(`${base}/todos/1`)).json(), before);
+    }
+    assert.equal((await (await fetch(`${base}/todos`)).json()).length, 6);
+  }, createApp(datedStore(), fixedNow)));
+
+test('UTC midnight updates status and filtering without modifying the todo', () => {
+  const store = createStore();
+  store.add({ title: 'At midnight', dueDate: '2026-10-22' });
+  let current = new Date('2026-10-23T01:59:59.999+02:00');
+  return withServer(async (base) => {
+    assert.equal((await (await fetch(`${base}/todos/1`)).json()).overdue, false);
+    assert.deepEqual(await (await fetch(`${base}/todos?overdue=true`)).json(), []);
+    current = new Date('2026-10-22T17:00:00.000-07:00');
+    assert.equal((await (await fetch(`${base}/todos/1`)).json()).overdue, true);
+    assert.deepEqual((await (await fetch(`${base}/todos?overdue=true`)).json()).map(todo => todo.id), [1]);
+  }, createApp(store, () => current));
+});
