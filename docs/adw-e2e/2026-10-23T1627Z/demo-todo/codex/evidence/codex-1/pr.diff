 <head><meta charset="utf-8"><title>demo-todo</title></head>
 <body>
   <h1>Todos</h1>
+  <label><input type="checkbox" data-testid="overdue-filter"> nur überfällige</label>
   <ul data-testid="todo-list"></ul>
   <script type="module">
     const list = document.querySelector('[data-testid="todo-list"]');
-    const todos = await (await fetch('/todos')).json();
-    for (const todo of todos) {
-      const li = document.createElement('li');
-      li.dataset.testid = 'todo-item';
-      const title = document.createElement('span');
-      title.dataset.testid = 'todo-title';
-      title.textContent = todo.title + (todo.done ? ' ✓' : '');
-      li.append(title);
-      list.append(li);
+    const filter = document.querySelector('[data-testid="overdue-filter"]');
+    let latestRequest = 0;
+
+    async function reload() {
+      const request = ++latestRequest;
+      const todos = await (await fetch(filter.checked ? '/todos?overdue=true' : '/todos')).json();
+      if (request !== latestRequest) return;
+      const items = document.createDocumentFragment();
+      for (const todo of todos) {
+        const li = document.createElement('li');
+        li.dataset.testid = 'todo-item';
+        const title = document.createElement('span');
+        title.dataset.testid = 'todo-title';
+        title.textContent = todo.title + (todo.done ? ' ✓' : '');
+        li.append(title);
+        if (todo.dueDate !== null) {
+          const date = document.createElement('time');
+          date.dataset.testid = 'todo-due-date';
+          date.dateTime = todo.dueDate;
+          date.textContent = todo.dueDate;
+          li.append(' ', date);
+        }
+        if (todo.overdue) {
+          const status = document.createElement('span');
+          status.dataset.testid = 'todo-overdue';
+          status.textContent = 'überfällig';
+          li.append(' ', status);
+        }
+        items.append(li);
+      }
+      list.replaceChildren(items);
     }
+
+    filter.addEventListener('change', reload);
+    await reload();
   </script>
 </body>
 </html>
