 <head><meta charset="utf-8"><title>demo-todo</title></head>
 <body>
   <h1>Todos</h1>
+  <label><input type="checkbox" data-testid="overdue-filter"> nur überfällige</label>
+  <p data-testid="todo-error" role="alert" hidden>Todos konnten nicht geladen werden. Bitte erneut versuchen.</p>
   <ul data-testid="todo-list"></ul>
   <script type="module">
     const list = document.querySelector('[data-testid="todo-list"]');
-    const todos = await (await fetch('/todos')).json();
-    for (const todo of todos) {
-      const li = document.createElement('li');
-      li.dataset.testid = 'todo-item';
-      const title = document.createElement('span');
-      title.dataset.testid = 'todo-title';
-      title.textContent = todo.title + (todo.done ? ' ✓' : '');
-      li.append(title);
-      list.append(li);
+    const filter = document.querySelector('[data-testid="overdue-filter"]');
+    const error = document.querySelector('[data-testid="todo-error"]');
+    let latestRequest = 0;
+    let displayedFilter = false;
+
+    async function loadTodos() {
+      const request = ++latestRequest;
+      const onlyOverdue = filter.checked;
+      error.hidden = true;
+      try {
+        const response = await fetch(onlyOverdue ? '/todos?overdue=true' : '/todos');
+        if (!response.ok) throw new Error('Could not load todos');
+        const todos = await response.json();
+        if (request !== latestRequest) return;
+        const items = todos.map((todo) => {
+          const li = document.createElement('li');
+          li.dataset.testid = 'todo-item';
+          const title = document.createElement('span');
+          title.dataset.testid = 'todo-title';
+          title.textContent = todo.title + (todo.done ? ' ✓' : '');
+          li.append(title);
+          if (todo.dueDate) {
+            const date = document.createElement('time');
+            date.dataset.testid = 'todo-due-date';
+            date.dateTime = todo.dueDate;
+            date.textContent = `Fällig: ${todo.dueDate}`;
+            li.append(' – ', date);
+          }
+          if (todo.overdue) {
+            const marker = document.createElement('span');
+            marker.dataset.testid = 'todo-overdue';
+            marker.textContent = 'überfällig';
+            li.append(' – ', marker);
+          }
+          return li;
+        });
+        list.replaceChildren(...items);
+        displayedFilter = onlyOverdue;
+      } catch {
+        if (request !== latestRequest) return;
+        filter.checked = displayedFilter;
+        error.hidden = false;
+      }
     }
+
+    filter.addEventListener('change', loadTodos);
+    await loadTodos();
   </script>
 </body>
 </html>
