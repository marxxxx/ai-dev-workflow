+    assert.equal((await patch({ dueDate: '2026-10-24' })).overdue, false);
+    assert.equal((await patch({ dueDate: '2026-10-22', done: true })).overdue, false);
+    assert.equal((await patch({ done: false })).overdue, true);
+    assert.equal((await patch({ dueDate: null })).dueDate, null);
+    assert.equal((await (await fetch(`${base}/todos/1`)).json()).overdue, false);
+    const undated = await fetch(`${base}/todos`, json('POST', { title: 'C', dueDate: null }));
+    assert.equal((await undated.json()).dueDate, null);
+  }, createStore(() => new Date('2026-10-23T12:00:00Z'))));
+
+test('invalid dates return HTTP 400 for POST and PATCH without changing todos', () =>
+  withServer(async (base) => {
+    const created = await (await fetch(`${base}/todos`, json('POST', { title: 'A' }))).json();
+    for (const dueDate of ['', '2026-2-03', '2026-02-30', '1900-02-29', '0000-01-01', '2026-10-23T00:00:00Z', 123, false, {}, []]) {
+      for (const [path, method] of [['/todos', 'POST'], ['/todos/1', 'PATCH']]) {
+        const response = await fetch(`${base}${path}`, json(method, { title: 'B', done: true, dueDate }));
+        assert.equal(response.status, 400, `${method} ${JSON.stringify(dueDate)}`);
+        assert.match((await response.json()).error, /dueDate/);
+        assert.deepEqual(await (await fetch(`${base}/todos`)).json(), [created]);
+      }
+    }
+  }));
+
+test('overdue filter only returns open past-due todos and does not change the full list', () =>
+  withServer(async (base) => {
+    for (const [title, dueDate] of [
+      ['Past', '2026-10-22'], ['Today', '2026-10-23'], ['Future', '2026-10-24'],
+      ['Undated', null], ['Done', '2026-10-22'],
+    ]) {
+      assert.equal((await fetch(`${base}/todos`, json('POST', { title, dueDate }))).status, 201);
+    }
+    await fetch(`${base}/todos/5`, json('PATCH', { done: true }));
+    const filtered = await fetch(`${base}/todos?overdue=true`);
+    assert.equal(filtered.status, 200);
+    assert.deepEqual(await filtered.json(), [
+      { id: 1, title: 'Past', done: false, dueDate: '2026-10-22', overdue: true },
+    ]);
+    assert.equal((await (await fetch(`${base}/todos`)).json()).length, 5);
+    await fetch(`${base}/todos/1`, json('PATCH', { done: true }));
+    assert.deepEqual(await (await fetch(`${base}/todos?overdue=true`)).json(), []);
+  }, createStore(() => new Date('2026-10-23T12:00:00Z'))));
+
+test('overdue filter follows the UTC date when the day changes', () => {
+  let instant = '2026-10-23T23:59:59.999Z';
+  return withServer(async (base) => {
+    await fetch(`${base}/todos`, json('POST', { title: 'A', dueDate: '2026-10-23' }));
+    assert.deepEqual(await (await fetch(`${base}/todos?overdue=true`)).json(), []);
+    instant = '2026-10-24T00:00:00.000Z';
+    const list = await (await fetch(`${base}/todos?overdue=true`)).json();
+    assert.equal(list.length, 1);
+    assert.equal(list[0].overdue, true);
+  }, createStore(() => new Date(instant)));
+});
diff --git a/test/page.test.mjs b/test/page.test.mjs
new file mode 100644
index 0000000..2b16727
--- /dev/null
+++ b/test/page.test.mjs
@@ -0,0 +1,168 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { runInNewContext } from 'node:vm';
+
+const html = await readFile(new URL('../public/index.html', import.meta.url), 'utf8');
+const script = html.match(/<script type="module">([\s\S]*?)<\/script>/)[1];
+
+// A small adapter for the DOM operations used by the real page script.
+class Element {
+  constructor(tag) {
+    this.tagName = tag;
+    this.dataset = {};
+    this.children = [];
+    this.textContent = '';
+    this.checked = false;
+    this.listeners = {};
+  }
+  append(...children) { this.children.push(...children); }
+  replaceChildren(...children) { this.children = children; }
+  addEventListener(event, listener) { this.listeners[event] = listener; }
+}
+
+function pageHarness() {
+  const list = new Element('ul');
+  const filter = new Element('input');
+  const error = new Element('p');
+  error.hidden = true;
+  const requests = [];
+  const document = {
+    querySelector(selector) {
+      return {
+        '[data-testid="todo-list"]': list,
+        '[data-testid="overdue-filter"]': filter,
+        '[data-testid="todo-error"]': error,
+      }[selector];
+    },
+    createElement: (tag) => new Element(tag),
+  };
+  const initial = runInNewContext(`(async () => { ${script} })()`, {
+    document,
+    fetch(url) {
+      const { promise, resolve, reject } = Promise.withResolvers();
+      requests.push({
+        url,
+        respond: (todos, ok = true) => resolve({ ok, json: async () => todos }),
+        fail: () => reject(new Error('Network unavailable')),
+      });
+      return promise;
+    },
+  });
+  return {
+    list, requests, initial, filter, error,
+    change(checked) {
+      filter.checked = checked;
+      assert.equal(typeof filter.listeners.change, 'function', 'filter must respond to changes');
+      return filter.listeners.change();
+    },
+  };
+}
+
+const past = { id: 1, title: '<b>Past</b>', done: false, dueDate: '2026-10-22', overdue: true };
+const today = { id: 2, title: 'Today', done: false, dueDate: '2026-10-23', overdue: false };
+const future = { id: 3, title: 'Future', done: false, dueDate: '2026-10-24', overdue: false };
+const undated = { id: 4, title: 'Undated', done: false, dueDate: null, overdue: false };
+const done = { id: 5, title: 'Done', done: true, dueDate: '2026-10-22', overdue: false };
+const child = (row, testid) => row.children.find((el) => el?.dataset?.testid === testid);
+const titles = (page) => Array.from(page.list.children, (row) => child(row, 'todo-title').textContent);
+
+test('page renders optional dates, exact lowercase markers and done status', async () => {
+  const page = pageHarness();
+  assert.equal(page.requests[0].url, '/todos');
+  page.requests[0].respond([past, today, future, undated, done]);
+  await page.initial;
+  assert.deepEqual(titles(page), ['<b>Past</b>', 'Today', 'Future', 'Undated', 'Done ✓']);
+  assert.ok(page.list.children.every((row) => row.dataset.testid === 'todo-item'));
+  for (const [index, todo] of [past, today, future, undated, done].entries()) {
+    const row = page.list.children[index];
+    const date = child(row, 'todo-due-date');
+    if (todo.dueDate) {
+      assert.equal(date?.textContent, `Fällig: ${todo.dueDate}`);
+      assert.equal(date?.tagName, 'time');
+      assert.equal(date?.dateTime, todo.dueDate);
+    } else {
+      assert.equal(date, undefined);
+    }
+    assert.equal(child(row, 'todo-overdue')?.textContent, todo.overdue ? 'überfällig' : undefined);
+  }
+});
+
+test('checkbox filters and restores the list, including no matches', async () => {
+  const page = pageHarness();
+  page.requests[0].respond([past, undated]);
+  await page.initial;
+  const filtered = page.change(true);
+  assert.equal(page.requests[1].url, '/todos?overdue=true');
+  page.requests[1].respond([past]);
+  await filtered;
+  assert.deepEqual(titles(page), ['<b>Past</b>']);
+  const empty = page.change(true);
+  page.requests[2].respond([]);
+  await empty;
+  assert.deepEqual(titles(page), []);
+  const restored = page.change(false);
+  assert.equal(page.requests[3].url, '/todos');
+  page.requests[3].respond([past, undated]);
+  await restored;
+  assert.deepEqual(titles(page), ['<b>Past</b>', 'Undated']);
+});
+
+test('rapid filter changes ignore responses belonging to an older selection', async () => {
+  const page = pageHarness();
+  page.requests[0].respond([past, undated]);
+  await page.initial;
+  const older = page.change(true);
+  const newer = page.change(false);
+  page.requests[2].respond([past, undated]);
+  await newer;
+  page.requests[1].respond([past]);
+  await older;
+  assert.deepEqual(titles(page), ['<b>Past</b>', 'Undated']);
+});
+
+test('a late initial response cannot overwrite the chosen filter', async () => {
+  const page = pageHarness();
+  const filtered = page.change(true);
+  page.requests[1].respond([past]);
+  await filtered;
+  page.requests[0].respond([past, undated]);
+  await page.initial;
+  assert.deepEqual(titles(page), ['<b>Past</b>']);
+});
+
+for (const failure of ['network', 'HTTP']) {
+  test(`failed ${failure} filter reload restores the displayed selection and allows retry`, async () => {
+    const page = pageHarness();
+    page.requests[0].respond([past, future]);
+    await page.initial;
+    const failed = page.change(true);
+    if (failure === 'network') page.requests[1].fail();
+    else page.requests[1].respond({ error: 'internal error' }, false);
+    await failed;
+    assert.equal(page.filter.checked, false);
+    assert.equal(page.error.hidden, false);
+    assert.deepEqual(titles(page), ['<b>Past</b>', 'Future']);
+    const retried = page.change(true);
+    page.requests[2].respond([past]);
+    await retried;
+    assert.equal(page.filter.checked, true);
+    assert.equal(page.error.hidden, true);
+    assert.deepEqual(titles(page), ['<b>Past</b>']);
+  });
+}
+
+test('an older failed request cannot alter a newer successful selection', async () => {
+  const page = pageHarness();
+  page.requests[0].respond([past, future]);
+  await page.initial;
+  const older = page.change(false);
+  const newer = page.change(true);
+  page.requests[2].respond([past]);
+  await newer;
+  page.requests[1].fail();
+  await older;
+  assert.equal(page.filter.checked, true);
+  assert.equal(page.error.hidden, true);
+  assert.deepEqual(titles(page), ['<b>Past</b>']);
+});
diff --git a/test/store.test.mjs b/test/store.test.mjs
new file mode 100644
index 0000000..5264c35
--- /dev/null
+++ b/test/store.test.mjs
@@ -0,0 +1,93 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createStore, ValidationError } from '../src/store.mjs';
+
+const fixedStore = () => createStore(() => new Date('2026-10-23T00:00:00.000Z'));
+
+test('due date is optional and overdue compares calendar days in UTC', () => {
+  const store = fixedStore();
+  assert.deepEqual(store.add({ title: ' A ' }), {
+    id: 1, title: 'A', done: false, dueDate: null, overdue: false,
+  });
+  assert.equal(store.add({ title: 'B', dueDate: null }).overdue, false);
+  assert.equal(store.add({ title: 'C', dueDate: '2026-10-22' }).overdue, true);
+  assert.equal(store.add({ title: 'D', dueDate: '2026-10-23' }).overdue, false);
+  assert.equal(store.add({ title: 'E', dueDate: '2026-10-24' }).overdue, false);
+});
+
+test('sets, preserves and removes dates, and recomputes status when done changes', () => {
+  const store = fixedStore();
+  const { id } = store.add({ title: 'A' });
+  assert.equal(store.update(id, { dueDate: '2026-10-22' }).overdue, true);
+  assert.equal(store.update(id, { title: 'B' }).dueDate, '2026-10-22');
+  assert.equal(store.update(id, { done: true }).overdue, false);
+  assert.equal(store.get(id).dueDate, '2026-10-22');
+  assert.equal(store.update(id, { done: false }).overdue, true);
+  assert.equal(store.update(id, { dueDate: null }).dueDate, null);
+  assert.equal(store.get(id).overdue, false);
+});
+
+const invalidDates = [
+  '', '2026-2-03', '2026-02-3', '2026-10-23T00:00:00Z', ' 2026-10-23',
+  '2026-10-23\n', 20261023, false, {}, [], '0000-01-01', '10000-01-01',
+  '2026-02-30', '2026-02-29', '1900-02-29', '2026-04-31', '2026-00-01',
+  '2026-13-01', '2026-01-00', '2026-01-32',
+];
+
+for (const dueDate of invalidDates) {
+  test(`rejects invalid date ${JSON.stringify(dueDate)} without changing data`, () => {
+    const store = fixedStore();
+    assert.throws(() => store.add({ title: 'A', dueDate }), ValidationError);
+    assert.deepEqual(store.list(), []);
+    const todo = store.add({ title: 'Original', dueDate: '2026-10-22' });
+    assert.equal(todo.id, 1);
+    assert.throws(() => store.update(todo.id, {
+      title: 'Changed', done: true, dueDate,
+    }), ValidationError);
+    assert.deepEqual(store.get(todo.id), todo);
+  });
+}
+
+test('validates every patch field before changing any field', () => {
+  const store = fixedStore();
+  const todo = store.add({ title: 'A', dueDate: '2026-10-22' });
+  assert.throws(() => store.update(todo.id, {
+    title: 'B', dueDate: '2026-10-24', done: 'yes',
+  }), ValidationError);
+  assert.deepEqual(store.get(todo.id), todo);
+  assert.throws(() => store.update(todo.id, { title: '', dueDate: null }), ValidationError);
+  assert.deepEqual(store.get(todo.id), todo);
+});
+
+test('accepts real leap days and years below 0100', () => {
+  const store = fixedStore();
+  for (const dueDate of ['2000-02-29', '2024-02-29', '0004-02-29', '0001-01-01', '0099-12-31', '9999-12-31']) {
+    assert.equal(store.add({ title: 'A', dueDate }).dueDate, dueDate);
+  }
+});
+
+test('get and list recompute overdue across UTC midnight without a write', () => {
+  let instant = '2026-10-23T23:59:59.999Z';
+  const store = createStore(() => new Date(instant));
+  const { id } = store.add({ title: 'A', dueDate: '2026-10-23' });
+  assert.equal(store.get(id).overdue, false);
+  assert.equal(store.list()[0].overdue, false);
+  instant = '2026-10-24T00:00:00.000Z';
+  assert.equal(store.get(id).overdue, true);
+  assert.equal(store.list()[0].overdue, true);
+});
+
+test('UTC today does not depend on the clock offset', () => {
+  const store = createStore(() => new Date('2026-10-23T20:30:00-04:00'));
+  assert.equal(store.add({ title: 'A', dueDate: '2026-10-23' }).overdue, true);
+});
+
+test('unknown todos and deletion retain their behavior', () => {
+  const store = fixedStore();
+  assert.equal(store.get(99), undefined);
+  assert.equal(store.update(99, { dueDate: null }), undefined);
+  assert.equal(store.remove(99), false);
+  const { id } = store.add({ title: 'A' });
+  assert.equal(store.remove(id), true);
+  assert.deepEqual(store.list(), []);
+});
