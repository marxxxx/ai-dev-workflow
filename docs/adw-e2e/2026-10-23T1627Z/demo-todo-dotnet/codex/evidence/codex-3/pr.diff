 using System.ComponentModel.DataAnnotations;
+using System.Text.Json.Serialization;
 
 namespace DemoTodo;
 
-public record Todo(int Id, string Title, bool Done);
+public record Todo(int Id, string Title, bool Done, DateOnly? DueDate = null)
+{
+    public bool IsOverdue => IsOverdueAt(DateTimeOffset.UtcNow);
+
+    public bool IsOverdueAt(DateTimeOffset instant) =>
+        !Done && DueDate is { } dueDate && dueDate < DateOnly.FromDateTime(instant.UtcDateTime);
+}
 
-public record NewTodo(string? Title);
+public record NewTodo(string? Title, DateOnly? DueDate = null);
 
-public record TodoPatch(string? Title, bool? Done);
+public record TodoPatch(string? Title, bool? Done)
+{
+    private DateOnly? _dueDate;
+
+    public DateOnly? DueDate
+    {
+        get => _dueDate;
+        init
+        {
+            _dueDate = value;
+            HasDueDate = true;
+        }
+    }
+
+    [JsonIgnore]
+    public bool HasDueDate { get; private init; }
+}
 
 // In-memory todo store, registered as a singleton: the API and the list page share it.
 public class TodoStore
@@ -15,9 +38,10 @@ public class TodoStore
     private readonly SortedDictionary<int, Todo> _todos = [];
     private int _nextId = 1;
 
-    public IReadOnlyList<Todo> List()
+    public IReadOnlyList<Todo> List(bool overdueOnly = false)
     {
-        lock (_lock) return [.. _todos.Values];
+        var now = DateTimeOffset.UtcNow;
+        lock (_lock) return [.. _todos.Values.Where(todo => !overdueOnly || todo.IsOverdueAt(now))];
     }
 
     public Todo? Get(int id)
@@ -31,7 +55,7 @@ public class TodoStore
         if (string.IsNullOrEmpty(title)) throw new ValidationException("title is required");
         lock (_lock)
         {
-            var todo = new Todo(_nextId++, title, false);
+            var todo = new Todo(_nextId++, title, false, input.DueDate);
             _todos[todo.Id] = todo;
             return todo;
         }
@@ -44,7 +68,12 @@ public class TodoStore
         lock (_lock)
         {
             if (!_todos.TryGetValue(id, out var todo)) return null;
-            todo = todo with { Title = title ?? todo.Title, Done = patch.Done ?? todo.Done };
+            todo = todo with
+            {
+                Title = title ?? todo.Title,
+                Done = patch.Done ?? todo.Done,
+                DueDate = patch.HasDueDate ? patch.DueDate : todo.DueDate
+            };
             _todos[id] = todo;
             return todo;
         }
