+
+    [Fact]
+    public void StoresOptionalDueDates()
+    {
+        var store = new TodoStore();
+        var dated = store.Add(new NewTodo("Dated", new DateOnly(2028, 2, 29)));
+        Assert.Equal(new DateOnly(2028, 2, 29), store.Get(dated.Id)!.DueDate);
+        Assert.Null(store.Add(new NewTodo("Undated")).DueDate);
+        Assert.Null(store.Add(new NewTodo("Explicit null", null)).DueDate);
+    }
+
+    [Fact]
+    public void UpdatesPreservesAndClearsDueDates()
+    {
+        var store = new TodoStore();
+        var todo = store.Add(new NewTodo("A", new DateOnly(2026, 10, 22)));
+        Assert.Equal(todo.DueDate, store.Update(todo.Id, new TodoPatch("B", null))!.DueDate);
+        Assert.Equal(todo.DueDate, store.Update(todo.Id, new TodoPatch(null, true))!.DueDate);
+        var changed = store.Update(todo.Id, new TodoPatch(null, null) { DueDate = new DateOnly(2026, 11, 1) });
+        Assert.Equal(new DateOnly(2026, 11, 1), changed!.DueDate);
+        var cleared = store.Update(todo.Id, new TodoPatch(null, null) { DueDate = null });
+        Assert.Null(cleared!.DueDate);
+        Assert.Equal("B", cleared.Title);
+        Assert.True(cleared.Done);
+    }
+
+    [Theory]
+    [InlineData("2026-10-21", false, true)]
+    [InlineData("2026-10-22", false, true)]
+    [InlineData("2026-10-23", false, false)]
+    [InlineData("2026-10-24", false, false)]
+    [InlineData("2026-10-22", true, false)]
+    [InlineData(null, false, false)]
+    [InlineData(null, true, false)]
+    public void CalculatesOverdueUsingUtcCalendarDays(string? dueDate, bool done, bool expected)
+    {
+        var todo = new Todo(1, "A", done, dueDate is null ? null : DateOnly.Parse(dueDate));
+        var midnight = new DateTimeOffset(2026, 10, 23, 0, 0, 0, TimeSpan.Zero);
+        Assert.Equal(expected, todo.IsOverdueAt(midnight));
+        Assert.Equal(expected, todo.IsOverdueAt(midnight.ToOffset(TimeSpan.FromHours(-7))));
+        Assert.Equal(expected, todo.IsOverdueAt(midnight.ToOffset(TimeSpan.FromHours(14))));
+    }
+
+    [Fact]
+    public void BecomesOverdueAtUtcMidnight()
+    {
+        var todo = new Todo(1, "A", false, new DateOnly(2026, 10, 22));
+        var midnight = new DateTimeOffset(2026, 10, 23, 0, 0, 0, TimeSpan.Zero);
+        Assert.False(todo.IsOverdueAt(midnight.AddTicks(-1)));
+        Assert.True(todo.IsOverdueAt(midnight));
+    }
+
+    [Fact]
+    public void FiltersOnlyUnfinishedPastDueTodosInIdOrder()
+    {
+        var store = new TodoStore();
+        var past = new DateOnly(2000, 1, 1);
+        var first = store.Add(new NewTodo("First", past));
+        store.Add(new NewTodo("No date"));
+        store.Add(new NewTodo("Future", DateOnly.MaxValue));
+        var completed = store.Add(new NewTodo("Done", past));
+        store.Update(completed.Id, new TodoPatch(null, true));
+        var last = store.Add(new NewTodo("Last", past));
+        Assert.Equal([first, last], store.List(overdueOnly: true));
+        Assert.Equal(5, store.List().Count);
+        Assert.Equal(store.List(), store.List(overdueOnly: false));
+        Assert.True(first.IsOverdue);
+        Assert.False(store.Get(completed.Id)!.IsOverdue);
+        Assert.Empty(new TodoStore().List(overdueOnly: true));
+    }
 }
