@@ -0,0 +1,76 @@
+using System.Net;
+using System.Net.Http.Json;
+using System.Text.RegularExpressions;
+using Microsoft.AspNetCore.Mvc.Testing;
+
+namespace DemoTodo.Tests;
+
+public class TodoPageTests : IDisposable
+{
+    private readonly WebApplicationFactory<Program> _factory = new();
+    private readonly HttpClient _client;
+
+    public TodoPageTests() => _client = _factory.CreateClient();
+
+    public void Dispose() => _factory.Dispose();
+
+    [Fact]
+    public async Task RendersDueDatesAndOnlyMarksUnfinishedPastDatesOverdue()
+    {
+        var today = DateOnly.FromDateTime(DateTime.UtcNow).ToString("yyyy-MM-dd");
+        await Add("Past", "2000-01-01");
+        await Add("Today", today);
+        await Add("Future", "9999-12-31");
+        await Add("Undated", null);
+        await Add("Completed", "2000-01-01");
+        var done = await _client.PatchAsJsonAsync("/todos/5", new { done = true });
+        done.EnsureSuccessStatusCode();
+
+        var html = WebUtility.HtmlDecode(await _client.GetStringAsync("/"));
+        var items = TodoItems(html);
+        Assert.Equal(5, items.Count);
+        Assert.Contains("Past", items[0].Value);
+        Assert.Contains("datetime=\"2000-01-01\"", items[0].Value);
+        Assert.Contains("data-testid=\"todo-due-date\"", items[0].Value);
+        Assert.Contains("data-testid=\"todo-overdue\"", items[0].Value);
+        Assert.Contains("überfällig", items[0].Value);
+        Assert.Contains($"datetime=\"{today}\"", items[1].Value);
+        Assert.Contains("datetime=\"9999-12-31\"", items[2].Value);
+        Assert.DoesNotContain("data-testid=\"todo-due-date\"", items[3].Value);
+        Assert.Contains("datetime=\"2000-01-01\"", items[4].Value);
+        Assert.Contains("Completed ✓", items[4].Value);
+        Assert.All(items.Cast<Match>().Skip(1), item =>
+            Assert.DoesNotContain("data-testid=\"todo-overdue\"", item.Value));
+    }
+
+    [Fact]
+    public async Task RendersUncheckedOverdueFilter()
+    {
+        await Add("Visible without date", null);
+        var html = WebUtility.HtmlDecode(await _client.GetStringAsync("/"));
+        var input = Regex.Match(html, "<input[^>]*data-testid=\"overdue-only\"[^>]*>");
+        Assert.True(input.Success, "The overdue checkbox must be rendered.");
+        Assert.Contains("type=\"checkbox\"", input.Value);
+        Assert.DoesNotMatch(@"\bchecked\b", input.Value);
+        Assert.Contains("nur überfällige", html);
+        Assert.Contains("Visible without date", html);
+    }
+
+    [Fact]
+    public async Task RendersEmptyListWithUsableFilter()
+    {
+        var html = await _client.GetStringAsync("/");
+        Assert.Contains("data-testid=\"todo-list\"", html);
+        Assert.Contains("data-testid=\"overdue-only\"", html);
+        Assert.Empty(TodoItems(html));
+    }
+
+    private async Task Add(string title, string? dueDate)
+    {
+        var response = await _client.PostAsJsonAsync("/todos", new { title, dueDate });
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    private static MatchCollection TodoItems(string html) =>
+        Regex.Matches(html, "<li[^>]*data-testid=\"todo-item\"[^>]*>.*?</li>", RegexOptions.Singleline);
+}
