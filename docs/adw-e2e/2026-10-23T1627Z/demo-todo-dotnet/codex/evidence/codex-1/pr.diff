         Assert.Equal(todo with { Done = true }, store.Update(todo.Id, new TodoPatch(null, true)));
         Assert.Null(store.Update(42, new TodoPatch("B", null)));
     }
+
+    [Theory]
+    [InlineData(null, false)]
+    [InlineData("2026-10-22", true)]
+    [InlineData("2026-10-23", false)]
+    [InlineData("2026-10-24", false)]
+    public void DerivesOverdueStatusFromTheUtcDate(string? date, bool expected)
+    {
+        var store = new TodoStore(new TestTimeProvider());
+        DateOnly? dueDate = date is null ? null : DateOnly.Parse(date);
+        var todo = store.Add(new NewTodo("A", dueDate));
+
+        Assert.Equal(dueDate, todo.DueDate);
+        Assert.Equal(expected, todo.IsOverdue);
+        Assert.Equal(todo, store.Get(todo.Id));
+        Assert.Equal(todo, Assert.Single(store.List()));
+        Assert.False(store.Update(todo.Id, new TodoPatch(null, true))!.IsOverdue);
+        Assert.Equal(expected, store.Update(todo.Id, new TodoPatch(null, false))!.IsOverdue);
+    }
+
+    [Fact]
+    public void AnOmittedDateOnCreationMeansNoDueDate()
+    {
+        var todo = new TodoStore(new TestTimeProvider()).Add(new NewTodo("A"));
+        Assert.Null(todo.DueDate);
+        Assert.False(todo.IsOverdue);
+    }
+
+    [Fact]
+    public void SetsReplacesAndClearsDatesWhileOmittedDatesArePreserved()
+    {
+        var store = new TodoStore(new TestTimeProvider());
+        var todo = store.Add(new NewTodo("A"));
+        var yesterday = new DateOnly(2026, 10, 22);
+        var tomorrow = yesterday.AddDays(2);
+
+        Assert.Equal(yesterday, store.Update(todo.Id, new TodoPatch(null, null) { DueDate = yesterday })!.DueDate);
+        var renamed = store.Update(todo.Id, new TodoPatch("B", null))!;
+        Assert.Equal("B", renamed.Title);
+        Assert.Equal(yesterday, renamed.DueDate);
+        Assert.Equal(yesterday, store.Update(todo.Id, new TodoPatch(null, true))!.DueDate);
+        var replaced = store.Update(todo.Id, new TodoPatch(null, false) { DueDate = tomorrow })!;
+        Assert.Equal(tomorrow, replaced.DueDate);
+        Assert.False(replaced.IsOverdue);
+        var cleared = store.Update(todo.Id, new TodoPatch(null, null) { DueDate = null })!;
+        Assert.Null(cleared.DueDate);
+        Assert.False(cleared.IsOverdue);
+    }
+
+    [Fact]
+    public void FiltersOnlyOverdueTodosInExistingOrderWithoutRemovingOtherTodos()
+    {
+        var store = new TodoStore(new TestTimeProvider());
+        var first = store.Add(new NewTodo("First", new DateOnly(2026, 10, 22)));
+        store.Add(new NewTodo("Undated"));
+        store.Add(new NewTodo("Today", new DateOnly(2026, 10, 23)));
+        store.Add(new NewTodo("Tomorrow", new DateOnly(2026, 10, 24)));
+        var done = store.Add(new NewTodo("Done", first.DueDate));
+        store.Update(done.Id, new TodoPatch(null, true));
+        var last = store.Add(new NewTodo("Last", new DateOnly(2026, 10, 21)));
+
+        Assert.Equal([first, last], store.List(true));
+        Assert.Equal(6, store.List(false).Count);
+        store.Update(first.Id, new TodoPatch(null, true));
+        store.Update(last.Id, new TodoPatch(null, true));
+        Assert.Empty(store.List(true));
+        Assert.Equal(6, store.List().Count);
+        Assert.Equal(done with { IsOverdue = true }, store.Update(done.Id, new TodoPatch(null, false)));
+        Assert.Equal(done.Id, Assert.Single(store.List(true)).Id);
+    }
+
+    [Fact]
+    public void RefreshesExistingTodosAcrossUtcMidnightWithoutAWritingOperation()
+    {
+        var clock = new TestTimeProvider();
+        // Local date is already the 24th, but the UTC date is still the 23rd.
+        clock.SetUtcNow(new DateTimeOffset(2026, 10, 24, 1, 59, 59, TimeSpan.FromHours(2)));
+        var store = new TodoStore(clock);
+        var todo = store.Add(new NewTodo("Boundary", new DateOnly(2026, 10, 23)));
+        Assert.False(todo.IsOverdue);
+        Assert.Empty(store.List(true));
+
+        clock.SetUtcNow(new DateTimeOffset(2026, 10, 24, 0, 0, 0, TimeSpan.Zero));
+        Assert.True(store.Get(todo.Id)!.IsOverdue);
+        Assert.True(Assert.Single(store.List()).IsOverdue);
+        Assert.Equal(todo.Id, Assert.Single(store.List(true)).Id);
+        Assert.False(todo.IsOverdue); // Returned snapshots do not change retroactively.
+    }
 }
