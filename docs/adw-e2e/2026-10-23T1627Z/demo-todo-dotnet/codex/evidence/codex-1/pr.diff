+using System.Net;
+using System.Text.RegularExpressions;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Microsoft.Extensions.DependencyInjection;
+
+namespace DemoTodo.Tests;
+
+public class TodoPageTests : IDisposable
+{
+    private readonly TestTimeProvider _clock = new();
+    private readonly WebApplicationFactory<Program> _factory;
+    private readonly HttpClient _client;
+    private readonly TodoStore _store;
+
+    public TodoPageTests()
+    {
+        _factory = new WebApplicationFactory<Program>().WithWebHostBuilder(builder =>
+            builder.ConfigureServices(services => services.AddSingleton<TimeProvider>(_clock)));
+        _client = _factory.CreateClient();
+        _store = _factory.Services.GetRequiredService<TodoStore>();
+    }
+
+    public void Dispose() => _factory.Dispose();
+
+    [Fact]
+    public async Task ShowsDatesAndExactOverdueTextOnlyForOpenPastDatedTodos()
+    {
+        _store.Add(new NewTodo("Yesterday", new DateOnly(2026, 10, 22)));
+        _store.Add(new NewTodo("Today", new DateOnly(2026, 10, 23)));
+        _store.Add(new NewTodo("Tomorrow", new DateOnly(2026, 10, 24)));
+        var done = _store.Add(new NewTodo("Done", new DateOnly(2026, 10, 21)));
+        _store.Update(done.Id, new TodoPatch(null, true));
+        _store.Add(new NewTodo("Undated"));
+
+        var html = WebUtility.HtmlDecode(await _client.GetStringAsync("/"));
+        var items = Regex.Matches(html, "<li data-testid=\"todo-item\">(.*?)</li>", RegexOptions.Singleline)
+            .Select(match => match.Groups[1].Value).ToArray();
+        Assert.Equal(5, items.Length);
+        var titles = new[] { "Yesterday", "Today", "Tomorrow", "Done", "Undated" };
+        for (var i = 0; i < titles.Length; i++) Assert.Contains(titles[i], items[i]);
+        Assert.Contains("data-testid=\"todo-due-date\" datetime=\"2026-10-22\">2026-10-22</time>", items[0]);
+        Assert.Contains("data-testid=\"todo-due-date\" datetime=\"2026-10-23\">2026-10-23</time>", items[1]);
+        Assert.Contains("data-testid=\"todo-due-date\" datetime=\"2026-10-24\">2026-10-24</time>", items[2]);
+        Assert.Contains("data-testid=\"todo-due-date\" datetime=\"2026-10-21\">2026-10-21</time>", items[3]);
+        Assert.Contains("data-testid=\"todo-overdue\">überfällig</span>", items[0]);
+        Assert.All(items.Skip(1), item => Assert.DoesNotContain("data-testid=\"todo-overdue\"", item));
+        Assert.DoesNotContain("data-testid=\"todo-due-date\"", items[4]);
+    }
+
+    [Fact]
+    public async Task ProvidesAnInitiallyUncheckedFilterWithTheExactLabel()
+    {
+        var html = WebUtility.HtmlDecode(await _client.GetStringAsync("/"));
+        var checkbox = Regex.Match(html, "<input[^>]*data-testid=\"todo-overdue-filter\"[^>]*>").Value;
+        Assert.NotEmpty(checkbox);
+        Assert.Contains("type=\"checkbox\"", checkbox);
+        Assert.Contains("id=\"only-overdue\"", checkbox);
+        Assert.DoesNotContain("checked", checkbox);
+        Assert.Contains("for=\"only-overdue\">nur überfällige</label>", html);
+    }
+
+    [Fact]
+    public async Task RefreshesTheOverdueDisplayWhenThePageIsLoadedAfterUtcMidnight()
+    {
+        _store.Add(new NewTodo("Boundary", new DateOnly(2026, 10, 23)));
+        Assert.DoesNotContain("data-testid=\"todo-overdue\"", await _client.GetStringAsync("/"));
+        _clock.SetUtcNow(new DateTimeOffset(2026, 10, 24, 0, 0, 0, TimeSpan.Zero));
+        Assert.Contains("data-testid=\"todo-overdue\"", await _client.GetStringAsync("/"));
+    }
+}
