+        var response = await _client.PostAsJsonAsync("/todos", new { title = "A", dueDate = date });
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        var created = (await response.Content.ReadFromJsonAsync<Todo>())!;
+        Assert.Equal(date is null ? (DateOnly?)null : DateOnly.Parse(date), created.DueDate);
+        Assert.Equal(overdue, created.IsOverdue);
+        Assert.Equal(created, await _client.GetFromJsonAsync<Todo>("/todos/1"));
+        Assert.Equal(created, Assert.Single((await _client.GetFromJsonAsync<Todo[]>("/todos"))!));
+    }
+
+    [Fact]
+    public async Task PatchesSetReplacePreserveAndRemoveTheDueDate()
+    {
+        await _client.PostAsJsonAsync("/todos", new { title = "A" });
+        var set = await Patch(new { dueDate = "2026-10-22" });
+        Assert.Equal(new DateOnly(2026, 10, 22), set.DueDate);
+        Assert.True(set.IsOverdue);
+        var renamed = await Patch(new { title = "Renamed" });
+        Assert.Equal("Renamed", renamed.Title);
+        Assert.Equal(set.DueDate, renamed.DueDate);
+        var done = await Patch(new { done = true });
+        Assert.Equal(set.DueDate, done.DueDate);
+        Assert.False(done.IsOverdue);
+        Assert.True((await Patch(new { done = false })).IsOverdue);
+        var replaced = await Patch(new { dueDate = "2026-10-24" });
+        Assert.Equal(new DateOnly(2026, 10, 24), replaced.DueDate);
+        Assert.False(replaced.IsOverdue);
+        var removed = await Patch(new { dueDate = (string?)null });
+        Assert.Null(removed.DueDate);
+        Assert.False(removed.IsOverdue);
+        Assert.Equal(removed, await _client.GetFromJsonAsync<Todo>("/todos/1"));
+    }
+
+    [Fact]
+    public async Task FiltersOnlyOverdueTodosWithoutChangingTheOriginalOrder()
+    {
+        foreach (var date in new[] { "2026-10-22", null, "2026-10-23", "2026-10-24", "2026-10-21", "2026-10-20" })
+            await _client.PostAsJsonAsync("/todos", new { title = "A", dueDate = date });
+        await _client.PatchAsJsonAsync("/todos/5", new { done = true });
+
+        Assert.Equal([1, 6], (await _client.GetFromJsonAsync<Todo[]>("/todos?overdue=true"))!.Select(todo => todo.Id));
+        Assert.Equal(Enumerable.Range(1, 6), (await _client.GetFromJsonAsync<Todo[]>("/todos?overdue=false"))!.Select(todo => todo.Id));
+        Assert.Equal(6, (await _client.GetFromJsonAsync<Todo[]>("/todos"))!.Length);
+        await _client.PatchAsJsonAsync("/todos/1", new { done = true });
+        await _client.PatchAsJsonAsync("/todos/6", new { dueDate = (string?)null });
+        Assert.Equal("[]", await _client.GetStringAsync("/todos?overdue=true"));
+        await _client.PatchAsJsonAsync("/todos/5", new { done = false });
+        Assert.Equal(5, Assert.Single((await _client.GetFromJsonAsync<Todo[]>("/todos?overdue=true"))!).Id);
+    }
+
+    [Theory]
+    [InlineData("\"2026-02-30\"")]
+    [InlineData("\"2026-10-22T12:00:00Z\"")]
+    [InlineData("42")]
+    [InlineData("\"\"")]
+    public async Task RejectsInvalidDatesWithoutMutatingTodos(string dateJson)
+    {
+        var invalidCreate = await _client.PostAsync("/todos",
+            new StringContent($$"""{"title":"Invalid","dueDate":{{dateJson}}}""", null, "application/json"));
+        await AssertJsonError(invalidCreate);
+        Assert.Equal("[]", await _client.GetStringAsync("/todos"));
+
+        var created = await _client.PostAsJsonAsync("/todos", new { title = "A", dueDate = "2026-10-22" });
+        var original = await created.Content.ReadFromJsonAsync<Todo>();
+        var invalidPatch = await _client.PatchAsync("/todos/1",
+            new StringContent($$"""{"title":"Changed","dueDate":{{dateJson}}}""", null, "application/json"));
+        await AssertJsonError(invalidPatch);
+        Assert.Equal(original, await _client.GetFromJsonAsync<Todo>("/todos/1"));
+    }
+
+    [Fact]
+    public async Task RejectsAnInvalidFilterWithAJsonError()
+    {
+        await AssertJsonError(await _client.GetAsync("/todos?overdue=invalid"));
+    }
+
+    [Fact]
+    public async Task StatusAndFilterRefreshAtUtcMidnightWithoutPatching()
+    {
+        _clock.SetUtcNow(new DateTimeOffset(2026, 10, 23, 23, 59, 59, TimeSpan.Zero));
+        await _client.PostAsJsonAsync("/todos", new { title = "Today", dueDate = "2026-10-23" });
+        Assert.Equal("[]", await _client.GetStringAsync("/todos?overdue=true"));
+        _clock.SetUtcNow(new DateTimeOffset(2026, 10, 24, 0, 0, 0, TimeSpan.Zero));
+        Assert.True((await _client.GetFromJsonAsync<Todo>("/todos/1"))!.IsOverdue);
+        Assert.True(Assert.Single((await _client.GetFromJsonAsync<Todo[]>("/todos?overdue=true"))!).IsOverdue);
+    }
+
+    [Fact]
+    public async Task ClientSuppliedStatusCannotOverrideTheComputedValue()
+    {
+        var created = await _client.PostAsJsonAsync("/todos", new { title = "A", isOverdue = true });
+        Assert.False((await created.Content.ReadFromJsonAsync<Todo>())!.IsOverdue);
+        var patched = await Patch(new { dueDate = "2026-10-22", isOverdue = false, hasDueDate = false });
+        Assert.True(patched.IsOverdue);
+        Assert.Equal(new DateOnly(2026, 10, 22), patched.DueDate);
+    }
+
+    private async Task<Todo> Patch(object body)
+    {
+        var response = await _client.PatchAsJsonAsync("/todos/1", body);
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        return (await response.Content.ReadFromJsonAsync<Todo>())!;
+    }
+
+    private static async Task AssertJsonError(HttpResponseMessage response)
+    {
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        var json = await response.Content.ReadFromJsonAsync<JsonElement>();
+        Assert.False(string.IsNullOrWhiteSpace(json.GetProperty("error").GetString()));
+    }
 }
