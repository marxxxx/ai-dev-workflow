+        foreach (var path in new[] { "/todos", "/todos?overdue=false" })
+        {
+            var all = await _client.GetFromJsonAsync<JsonElement[]>(path);
+            Assert.Equal([1, 2, 3, 4, 5, 6], all!.Select(todo => todo.GetProperty("id").GetInt32()));
+        }
+
+        var filtered = await _client.GetFromJsonAsync<JsonElement[]>("/todos?overdue=true");
+        Assert.NotNull(filtered);
+        Assert.Equal([1, 6], filtered.Select(todo => todo.GetProperty("id").GetInt32()));
+        Assert.All(filtered, todo => Assert.True(todo.GetProperty("isOverdue").GetBoolean()));
+
+        await _client.PatchAsJsonAsync("/todos/1", new { done = true });
+        await _client.PatchAsJsonAsync("/todos/6", new { dueDate = (string?)null });
+        Assert.Equal("[]", await _client.GetStringAsync("/todos?overdue=true"));
+        Assert.Equal(6, (await _client.GetFromJsonAsync<JsonElement[]>("/todos"))!.Length);
+    }
+
+    [Fact]
+    public async Task ReturnsEmptyOverdueListWhenNothingMatches()
+    {
+        Assert.Equal("[]", await _client.GetStringAsync("/todos?overdue=true"));
+        await _client.PostAsJsonAsync("/todos", new { title = "Undated" });
+        Assert.Equal("[]", await _client.GetStringAsync("/todos?overdue=true"));
+    }
+
+    [Fact]
+    public async Task RejectsInvalidOverdueFilter()
+    {
+        var response = await _client.GetAsync("/todos?overdue=invalid");
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.False(string.IsNullOrWhiteSpace((await response.Content.ReadFromJsonAsync<JsonElement>()).GetProperty("error").GetString()));
+    }
+
+    [Fact]
+    public async Task DisplaysDueDatesOverdueMarkersAndAnInitiallyUncheckedFilter()
+    {
+        await SeedMixedTodos();
+        var html = WebUtility.HtmlDecode(await _client.GetStringAsync("/"));
+        Assert.Equal(6, Regex.Matches(html, "data-testid=\"todo-item\"").Count);
+        Assert.Equal(5, Regex.Matches(html, "data-testid=\"todo-due-date\"").Count);
+        Assert.Equal(2, Regex.Matches(html, "data-testid=\"todo-overdue\"").Count);
+        foreach (var title in new[] { "Overdue first", "Today", "Future", "Done", "Undated", "Overdue last" })
+            Assert.Contains(title, html);
+
+        var first = Assert.Single(Regex.Matches(html, "<li data-testid=\"todo-item\">.*?</li>", RegexOptions.Singleline)
+            .Select(match => match.Value), item => item.Contains("Overdue first"));
+        var yesterday = DateOnly.FromDateTime(DateTime.UtcNow).AddDays(-1);
+        Assert.Contains("datetime=\"" + yesterday.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) + "\"", first);
+        Assert.Contains(yesterday.ToString("dd.MM.yyyy", CultureInfo.InvariantCulture), first);
+        Assert.Contains("Überfällig", first);
+        var visibleText = Regex.Replace(Regex.Replace(first, "<[^>]+>", ""), "\\s+", " ").Trim();
+        Assert.Contains("Overdue first – " + yesterday.ToString("dd.MM.yyyy", CultureInfo.InvariantCulture) + " – Überfällig", visibleText);
+
+        var checkbox = Regex.Match(html, "<input[^>]*data-testid=\"overdue-filter\"[^>]*>").Value;
+        Assert.NotEmpty(checkbox);
+        Assert.Contains("type=\"checkbox\"", checkbox);
+        Assert.DoesNotContain("checked", checkbox);
+        Assert.Matches("(?s)<label[^>]*>\\s*<input[^>]*data-testid=\"overdue-filter\"[^>]*>\\s*nur überfällige\\s*</label>", html);
+    }
+
+    private async Task SeedMixedTodos()
+    {
+        var today = DateOnly.FromDateTime(DateTime.UtcNow);
+        foreach (var (title, date) in new (string, DateOnly?)[]
+        {
+            ("Overdue first", today.AddDays(-1)),
+            ("Today", today),
+            ("Future", today.AddDays(1)),
+            ("Done", today.AddDays(-1)),
+            ("Undated", null),
+            ("Overdue last", today.AddDays(-2))
+        })
+        {
+            var response = await _client.PostAsJsonAsync("/todos", new { title, dueDate = date });
+            Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        }
+        var done = await _client.PatchAsJsonAsync("/todos/4", new { done = true });
+        Assert.Equal(HttpStatusCode.OK, done.StatusCode);
+    }
 }
