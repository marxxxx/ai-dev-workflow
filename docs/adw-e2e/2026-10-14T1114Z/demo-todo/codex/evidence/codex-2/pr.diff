+  assert.equal(page.list.children.length, 0);
+  await page.changeFilter(true);
+  assert.equal(page.error.hidden, true);
+  assert.equal(page.list.children.length, 1);
+});
+
+test('shows network errors without unhandled rejections and recovers', async () => {
+  let calls = 0;
+  const page = pageHarness(async () => {
+    if (calls++ === 0) throw new Error('connection failed');
+    return response(fixtures);
+  });
+  await assert.doesNotReject(page.ready);
+  assert.equal(page.error.hidden, false);
+  assert.equal(page.error.textContent, 'Todos konnten nicht geladen werden.');
+  assert.equal(page.list.children.length, 0);
+  await page.changeFilter(false);
+  assert.equal(page.error.hidden, true);
+  assert.equal(page.list.children.length, 5);
+});
+
+test('renders titles as literal text', async () => {
+  const title = '<img src=x onerror=alert(1)>';
+  const page = pageHarness(async () => response([{ ...fixtures[0], title }]));
+  await page.ready;
+  const node = byTestId(page.list, 'todo-title')[0];
+  assert.equal(node.textContent, title);
+  assert.equal(node.children.length, 0);
+  assert.equal(walk(page.list).some((element) => element.tagName === 'IMG'), false);
+});
diff --git a/test/store.test.mjs b/test/store.test.mjs
new file mode 100644
index 0000000..9592f16
--- /dev/null
+++ b/test/store.test.mjs
@@ -0,0 +1,129 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createStore, ValidationError } from '../src/store.mjs';
+
+const fixedStore = () => createStore({ now: () => new Date('2026-10-14T12:00:00Z') });
+
+test('stores optional dates and returns computed overdue', () => {
+  const store = fixedStore();
+  assert.deepEqual(store.add({ title: ' Ohne ' }), {
+    id: 1, title: 'Ohne', done: false, dueDate: null, overdue: false,
+  });
+  assert.equal(store.add({ title: 'Null', dueDate: null }).overdue, false);
+  assert.equal(store.add({ title: 'Alt', dueDate: '2026-10-13' }).overdue, true);
+  assert.equal(store.add({ title: 'Heute', dueDate: '2026-10-14' }).overdue, false);
+  assert.equal(store.add({ title: 'Später', dueDate: '2026-10-15' }).overdue, false);
+});
+
+test('updates, preserves and clears dates atomically', () => {
+  const store = fixedStore();
+  store.add({ title: 'A' });
+  assert.equal(store.update(1, { dueDate: '2026-10-13' }).overdue, true);
+  assert.equal(store.update(1, { title: ' B ' }).dueDate, '2026-10-13');
+  assert.equal(store.get(1).title, 'B');
+  assert.equal(store.update(1, { done: true }).overdue, false);
+  assert.equal(store.update(1, { done: false }).overdue, true);
+  assert.equal(store.update(1, { dueDate: null }).dueDate, null);
+  assert.equal(store.get(1).overdue, false);
+});
+
+test('validates real calendar dates including century and early-year leap rules', () => {
+  const store = fixedStore();
+  for (const dueDate of ['2000-02-29', '0004-02-29', '0099-12-31', '9999-12-31']) {
+    const todo = store.add({ title: 'A', dueDate });
+    assert.equal(todo.dueDate, dueDate);
+    assert.equal(store.update(todo.id, { dueDate }).dueDate, dueDate);
+  }
+});
+
+test('rejects invalid dates on both creation and update', () => {
+  const store = fixedStore();
+  store.add({ title: 'A', dueDate: '2026-10-13' });
+  for (const dueDate of [
+    '1900-02-29', '2026-02-30', '2026-04-31', '0000-01-01', '10000-01-01',
+    '2026-00-01', '2026-13-01', '2026-01-00', '2026-01-32', '2026-1-01',
+    '14.10.2026', '2026-10-14T00:00:00Z', '', ' 2026-10-14 ', '2026-10-14\n',
+    42, false, [], {},
+  ]) {
+    assert.throws(() => store.add({ title: 'A', dueDate }), ValidationError, String(dueDate));
+    assert.throws(() => store.update(1, { dueDate }), ValidationError, String(dueDate));
+    assert.equal(store.get(1).dueDate, '2026-10-13');
+  }
+  assert.equal(store.add({ title: 'B' }).id, 2);
+});
+
+test('rejected updates leave all fields unchanged', () => {
+  const store = fixedStore();
+  store.add({ title: 'A', dueDate: '2026-10-13' });
+  const before = { ...store.get(1) };
+  for (const patch of [
+    { title: 'B', done: true, dueDate: '2026-02-30' },
+    { title: 'B', done: 'true', dueDate: '2026-10-15' },
+    { title: ' ', done: true, dueDate: null },
+  ]) {
+    assert.throws(() => store.update(1, patch), ValidationError);
+    assert.deepEqual(store.get(1), before);
+  }
+});
+
+test('recomputes at UTC midnight and uses UTC for offset timestamps', () => {
+  let instant = '2026-10-14T23:59:59Z';
+  const store = createStore({ now: () => new Date(instant) });
+  assert.equal(store.add({ title: 'A', dueDate: '2026-10-14' }).overdue, false);
+  instant = '2026-10-15T00:00:00Z';
+  assert.equal(store.get(1).overdue, true);
+  assert.equal(store.list()[0].overdue, true);
+  instant = '2026-10-15T00:30:00+02:00';
+  assert.equal(store.get(1).overdue, false);
+});
+
+test('filters only overdue todos in insertion order and handles no matches', () => {
+  const store = fixedStore();
+  assert.deepEqual(store.list({ overdue: true }), []);
+  store.add({ title: 'Alt', dueDate: '2026-10-13' });
+  store.add({ title: 'Heute', dueDate: '2026-10-14' });
+  store.add({ title: 'Später', dueDate: '2026-10-15' });
+  store.add({ title: 'Ohne' });
+  store.add({ title: 'Erledigt', dueDate: '2026-10-12' });
+  store.update(5, { done: true });
+  store.add({ title: 'Auch alt', dueDate: '2026-10-01' });
+  assert.deepEqual(store.list({ overdue: true }).map((todo) => todo.id), [1, 6]);
+  assert.deepEqual(store.list().map((todo) => todo.id), [1, 2, 3, 4, 5, 6]);
+  store.update(1, { done: true });
+  store.update(6, { dueDate: null });
+  assert.deepEqual(store.list({ overdue: true }), []);
+});
+
+test('returns independent response objects', () => {
+  const store = fixedStore();
+  const created = store.add({ title: 'A', dueDate: '2026-10-13' });
+  const expected = { ...created };
+  for (const response of [created, store.get(1), store.update(1, {}), store.list()[0]]) {
+    response.title = 'Changed';
+    response.done = true;
+    response.dueDate = null;
+    response.overdue = false;
+    assert.deepEqual(store.get(1), expected);
+  }
+});
+
+test('ignores caller-provided overdue and other unknown fields', () => {
+  const store = fixedStore();
+  assert.equal(store.add({ title: 'A', overdue: true }).overdue, false);
+  assert.deepEqual(store.update(1, { overdue: true, unknown: 1 }), {
+    id: 1, title: 'A', done: false, dueDate: null, overdue: false,
+  });
+});
+
+test('reads the clock once for a consistent list projection', () => {
+  let calls = 0;
+  const store = createStore({ now: () => {
+    calls++;
+    return new Date(calls % 2 ? '2026-10-14T23:59:59Z' : '2026-10-15T00:00:00Z');
+  } });
+  store.add({ title: 'A', dueDate: '2026-10-14' });
+  store.add({ title: 'B', dueDate: '2026-10-14' });
+  calls = 0;
+  assert.deepEqual(store.list().map((todo) => todo.overdue), [false, false]);
+  assert.equal(calls, 1);
+});
