+  await oldRequest;
+  assert.equal(page.list.children.length, 1);
+  assert.equal(byTestId(page.list, 'todo-title')[0].textContent, 'Alt');
+});
+
+test('ignores stale errors after a newer successful filter response', async () => {
+  const older = deferred();
+  let calls = 0;
+  const page = pageHarness(() => [Promise.resolve(response(fixtures)), older.promise, Promise.resolve(response([fixtures[0]]))][calls++]);
+  await page.ready;
