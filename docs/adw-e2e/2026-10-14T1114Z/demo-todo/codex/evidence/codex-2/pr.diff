+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { runInNewContext } from 'node:vm';
+
+const html = await readFile(new URL('../public/index.html', import.meta.url), 'utf8');
+const script = html.match(/<script type="module">([\s\S]*?)<\/script>/)[1];
+
+// Only the browser boundary is doubled; the actual page script is executed.
+class Element {
+  constructor(tagName) {
+    this.tagName = tagName.toUpperCase();
+    this.dataset = {};
+    this.children = [];
+    this.text = '';
+    this.checked = false;
+    this.hidden = false;
+    this.listeners = new Map();
+  }
+  set textContent(value) { this.text = String(value); this.children = []; }
+  get textContent() { return this.text + this.children.map((child) => child.textContent).join(''); }
+  append(...children) {
+    this.children.push(...children.map((child) => {
+      if (typeof child !== 'string') return child;
+      const text = new Element('#text');
+      text.textContent = child;
+      return text;
+    }));
+  }
+  replaceChildren(...children) { this.children = []; this.text = ''; this.append(...children); }
+  addEventListener(type, listener) { this.listeners.set(type, listener); }
+}
+
+function pageHarness(fetch) {
+  const list = new Element('ul');
+  const filter = new Element('input');
+  const error = new Element('p');
+  error.hidden = true;
+  const elements = { 'todo-list': list, 'overdue-filter': filter, 'todo-error': error };
+  const document = {
+    querySelector: (selector) => elements[selector.match(/data-testid="([^"]+)"/)[1]],
+    createElement: (tagName) => new Element(tagName),
+  };
+  const ready = runInNewContext(`(async () => {${script}\n})()`, { document, fetch });
+  return { list, filter, error, ready, changeFilter(checked) {
+    filter.checked = checked;
+    return Promise.resolve(filter.listeners.get('change')?.({ target: filter }));
+  } };
+}
+
+const response = (todos) => ({ ok: true, json: async () => structuredClone(todos) });
+const deferred = () => Promise.withResolvers();
+const walk = (element) => [element, ...element.children.flatMap(walk)];
+const byTestId = (element, id) => walk(element).filter((node) => node.dataset.testid === id);
+const fixtures = [
+  { id: 1, title: 'Alt', done: false, dueDate: '2026-10-13', overdue: true },
+  { id: 2, title: 'Heute', done: false, dueDate: '2026-10-14', overdue: false },
+  { id: 3, title: 'Später', done: false, dueDate: '2026-10-15', overdue: false },
+  { id: 4, title: 'Erledigt', done: true, dueDate: '2026-10-13', overdue: false },
+  { id: 5, title: 'Ohne', done: false, dueDate: null, overdue: false },
+];
+
+test('renders due dates and overdue markers from the API', async () => {
+  const page = pageHarness(async () => response(fixtures));
+  await page.ready;
+  assert.equal(page.list.children.length, 5);
+  assert.deepEqual(byTestId(page.list, 'todo-due-date').map((node) => node.textContent), [
+    'Fällig: 2026-10-13', 'Fällig: 2026-10-14', 'Fällig: 2026-10-15', 'Fällig: 2026-10-13',
+  ]);
+  assert.deepEqual(byTestId(page.list, 'todo-due-date').map((node) => node.dateTime), [
+    '2026-10-13', '2026-10-14', '2026-10-15', '2026-10-13',
+  ]);
+  assert.deepEqual(byTestId(page.list, 'todo-overdue').map((node) => node.textContent), ['überfällig']);
+  assert.equal(byTestId(page.list.children[4], 'todo-due-date').length, 0);
+  assert.equal(byTestId(page.list.children[3], 'todo-title')[0].textContent, 'Erledigt ✓');
+  assert.equal(page.error.hidden, true);
+});
+
+test('filters and restores the list including empty matches', async () => {
+  const urls = [];
+  let filtered = [fixtures[0]];
+  const page = pageHarness(async (url) => {
+    urls.push(url);
+    assert.ok(url === '/todos' || url === '/todos?overdue=true');
+    return response(url === '/todos?overdue=true' ? filtered : fixtures);
+  });
+  await page.ready;
+  assert.equal(page.filter.checked, false);
+  await page.changeFilter(true);
+  assert.equal(page.list.children.length, 1);
+  assert.equal(byTestId(page.list, 'todo-title')[0].textContent, 'Alt');
