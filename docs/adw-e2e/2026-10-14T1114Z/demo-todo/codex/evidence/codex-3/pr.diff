+import { createStore, ValidationError } from '../src/store.mjs';
+
+const fixedStore = () => createStore({ now: () => new Date('2026-10-14T12:00:00.000Z') });
+
+test('supports optional due dates and clearing them', () => {
+  const store = fixedStore();
+  assert.deepEqual(store.add({ title: ' A ' }), {
+    id: 1, title: 'A', done: false, dueDate: null, overdue: false,
+  });
+  assert.equal(store.add({ title: 'B', dueDate: null }).dueDate, null);
+  assert.equal(store.add({ title: 'C', dueDate: '2026-10-15' }).dueDate, '2026-10-15');
+  assert.equal(store.update(3, { title: 'C geändert' }).dueDate, '2026-10-15');
+  assert.equal(store.update(3, { dueDate: '2026-10-13' }).overdue, true);
+  assert.deepEqual(store.update(3, { dueDate: null }), {
+    id: 3, title: 'C geändert', done: false, dueDate: null, overdue: false,
+  });
+});
+
+test('validates real Gregorian calendar dates', () => {
+  const store = fixedStore();
+  const existing = store.add({ title: 'Existing', dueDate: '2026-10-14' });
+  for (const dueDate of ['2024-02-29', '2000-02-29', '0099-01-01', '0001-01-01', '9999-12-31']) {
+    assert.equal(store.add({ title: 'A', dueDate }).dueDate, dueDate);
+    assert.equal(store.update(existing.id, { dueDate }).dueDate, dueDate);
+  }
+  for (const dueDate of ['', '2026-2-03', '2026-02-29', '1900-02-29', '2026-04-31',
+    '2026-13-01', '2026-01-00', '0000-01-01', '10000-01-01',
+    '2026-10-14T00:00:00Z', ' 2026-10-14', '2026-10-14\n', 42, true, {}, []]) {
+    assert.throws(() => store.add({ title: 'A', dueDate }), ValidationError);
+    assert.throws(() => store.update(existing.id, { dueDate }), ValidationError);
+  }
+});
+
+test('computes overdue only for open todos strictly before today', () => {
+  const store = fixedStore();
+  assert.equal(store.add({ title: 'gestern', dueDate: '2026-10-13' }).overdue, true);
+  assert.equal(store.add({ title: 'heute', dueDate: '2026-10-14' }).overdue, false);
+  assert.equal(store.add({ title: 'morgen', dueDate: '2026-10-15' }).overdue, false);
+  assert.equal(store.add({ title: 'ohne Termin' }).overdue, false);
+  assert.equal(store.update(1, { done: true }).overdue, false);
+  assert.equal(store.update(1, { done: false }).overdue, true);
+  assert.deepEqual(store.list().map(todo => todo.overdue), [true, false, false, false]);
+});
+
+test('refreshes overdue at UTC midnight on get and list', () => {
+  let instant = new Date('2026-10-14T23:59:59.999Z');
+  const store = createStore({ now: () => instant });
+  store.add({ title: 'A', dueDate: '2026-10-14' });
+  assert.equal(store.get(1).overdue, false);
+  instant = new Date('2026-10-15T00:00:00.000Z');
+  assert.equal(store.get(1).overdue, true);
+  assert.equal(store.list()[0].overdue, true);
+});
+
+test('uses the UTC calendar day for offset instants', () => {
+  const store = createStore({ now: () => new Date('2026-10-15T00:30:00+02:00') });
+  assert.equal(store.add({ title: 'A', dueDate: '2026-10-14' }).overdue, false);
+});
+
+test('keeps failed updates atomic and does not consume ids for rejected creates', () => {
+  const store = fixedStore();
+  const existing = store.add({ title: 'Original', dueDate: '2026-10-13' });
+  const before = { ...existing };
+  assert.throws(() => store.update(existing.id, { title: 'Neu', done: true, dueDate: 'falsch' }), ValidationError);
+  assert.deepEqual(store.get(existing.id), before);
+  assert.throws(() => store.update(existing.id, { title: 'Neu', done: 'ja' }), ValidationError);
+  assert.deepEqual(store.get(existing.id), before);
+  assert.throws(() => store.update(existing.id, { title: ' ', dueDate: null }), ValidationError);
+  assert.deepEqual(store.get(existing.id), before);
+  assert.throws(() => store.add({ title: 'Rejected', dueDate: 'falsch' }), ValidationError);
+  assert.equal(store.add({ title: 'Next' }).id, 2);
+});
+
+test('uses one UTC calendar day for a list', () => {
+  let calls = 0;
+  const store = createStore({ now: () => new Date(calls++ === 0
+    ? '2026-10-14T23:59:59.999Z' : '2026-10-15T00:00:00.000Z') });
+  store.add({ title: 'A', dueDate: '2026-10-14' });
+  store.add({ title: 'B', dueDate: '2026-10-14' });
+  calls = 0;
+  assert.deepEqual(store.list().map(todo => todo.overdue), [false, false]);
+});
+
+test('preserves missing ids and deletion behavior', () => {
+  const store = fixedStore();
+  assert.equal(store.get(42), undefined);
+  assert.equal(store.update(42, { dueDate: '2026-10-14' }), undefined);
+  store.add({ title: 'A' });
+  assert.equal(store.remove(1), true);
+  assert.equal(store.remove(1), false);
+  assert.deepEqual(store.list(), []);
+});
