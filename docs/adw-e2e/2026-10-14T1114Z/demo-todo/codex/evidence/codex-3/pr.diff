@@ -0,0 +1,126 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { runInNewContext } from 'node:vm';
+
+const html = await readFile(new URL('../public/index.html', import.meta.url), 'utf8');
+const script = html.match(/<script type="module">([\s\S]*?)<\/script>/)[1];
+const settle = () => new Promise(resolve => setImmediate(resolve));
+const todo = (title, fields = {}) => ({ id: 1, title, done: false, dueDate: null, overdue: false, ...fields });
+
+// Only the browser boundaries are doubled; execute the actual page script.
+function element(tagName) {
+  return {
+    tagName, dataset: {}, children: [], textContent: '', hidden: true, checked: false,
+    listeners: {},
+    append(...nodes) { this.children.push(...nodes.filter(node => typeof node !== 'string')); },
+    replaceChildren(...nodes) { this.children = nodes; },
+    addEventListener(name, handler) { this.listeners[name] = handler; },
+  };
+}
+
+function startPage() {
+  const list = element('ul');
+  const filter = element('input');
+  const error = element('p');
+  const nodes = { 'todo-list': list, 'overdue-filter': filter, 'todo-error': error };
+  const requests = [];
+  const failures = [];
+  const document = {
+    querySelector: selector => nodes[selector.match(/data-testid="([^"]+)"/)[1]],
+    createElement: element,
+  };
+  const fetch = url => new Promise((resolve, reject) => {
+    requests.push({ url, reject, respond: (body, ok = true) => resolve({ ok, json: async () => body }) });
+  });
+  runInNewContext(`(async () => {${script}\n})()`, { document, fetch }).catch(err => failures.push(err));
+  return {
+    list, filter, error, requests, failures,
+    change(checked) {
+      filter.checked = checked;
+      assert.equal(typeof filter.listeners.change, 'function', 'filter must react to user changes');
+      filter.listeners.change();
+    },
+  };
+}
+
+test('renders dates, exact overdue text and literal titles', async () => {
+  const page = startPage();
+  page.requests[0].respond([
+    todo('<img src=x onerror=alert(1)>', { dueDate: '2026-10-13', overdue: true }),
+    todo('Ohne Termin'),
+    todo('Erledigt', { done: true, dueDate: '2026-10-13' }),
+  ]);
+  await settle();
+  const [dated, undated, completed] = page.list.children;
+  assert.equal(dated.children[0].textContent, '<img src=x onerror=alert(1)>');
+  const date = dated.children.find(el => el.dataset.testid === 'todo-due-date');
+  assert.ok(date, 'dated todos must display a calendar date');
+  assert.equal(date.tagName, 'time');
+  assert.equal(date.textContent, '13.10.2026');
+  assert.equal(date.dateTime, '2026-10-13');
+  assert.equal(dated.children.find(el => el.dataset.testid === 'todo-overdue').textContent, 'überfällig');
+  assert.equal(undated.children.length, 1);
+  assert.equal(completed.children[0].textContent, 'Erledigt ✓');
+  assert.equal(completed.children.some(el => el.dataset.testid === 'todo-overdue'), false);
+  assert.equal(page.failures.length, 0);
+});
+
+test('loads the appropriate API on filter changes and supports empty results', async () => {
+  const page = startPage();
+  page.requests[0].respond([todo('Alle')]);
+  await settle();
+  page.change(true);
+  page.requests[1].respond([]);
+  await settle();
+  assert.equal(page.list.children.length, 0);
+  page.change(false);
+  page.requests[2].respond([todo('Alle')]);
+  await settle();
+  assert.deepEqual(page.requests.map(request => request.url), ['/todos', '/todos?overdue=true', '/todos']);
+  assert.equal(page.list.children[0].children[0].textContent, 'Alle');
+});
+
+test('ignores stale responses after rapid filter changes', async () => {
+  const page = startPage();
+  page.requests[0].respond([]);
+  await settle();
+  page.change(true);
+  page.change(false);
+  page.requests[2].respond([todo('Neueste Auswahl')]);
+  await settle();
+  page.requests[1].respond([todo('Veraltete Auswahl')]);
+  await settle();
+  assert.equal(page.list.children[0].children[0].textContent, 'Neueste Auswahl');
+});
+
+test('ignores stale errors after a successful newer response', async () => {
+  const page = startPage();
+  page.requests[0].respond([]);
+  await settle();
+  page.change(true);
+  page.change(false);
+  page.requests[2].respond([todo('Neueste Auswahl')]);
+  await settle();
+  page.requests[1].reject(new Error('Old failure'));
+  await settle();
+  assert.equal(page.error.hidden, true);
+  assert.equal(page.list.children[0].children[0].textContent, 'Neueste Auswahl');
+});
+
+for (const failure of ['network', 'HTTP 500']) {
+  test(`shows ${failure} errors and recovers on a later change`, async () => {
+    const page = startPage();
+    if (failure === 'network') page.requests[0].reject(new Error('Network failure'));
+    else page.requests[0].respond({ error: 'internal error' }, false);
+    await settle();
+    assert.equal(page.error.hidden, false);
+    assert.match(page.error.textContent, /nicht geladen/);
+    page.change(true);
+    page.requests[1].respond([todo('Wieder geladen')]);
+    await settle();
+    assert.equal(page.error.hidden, true);
+    assert.equal(page.list.children[0].children[0].textContent, 'Wieder geladen');
+    assert.equal(page.failures.length, 0);
+  });
+}
