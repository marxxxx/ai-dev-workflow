+assert.equal(store.add({ title: 'B', dueDate: null }).dueDate, null);
+assert.equal(store.add({ title: 'C', dueDate: '2026-10-15' }).dueDate, '2026-10-15');
+assert.equal(store.update(3, { title: 'C geändert' }).dueDate, '2026-10-15');
+assert.equal(store.update(3, { dueDate: '2026-10-13' }).overdue, true);
+assert.equal(store.update(3, { dueDate: null }).dueDate, null);
+
+// 'validates real Gregorian calendar dates'
+for (const dueDate of ['2024-02-29', '2000-02-29', '0099-01-01', '0001-01-01', '9999-12-31']) {
+  assert.equal(store.add({ title: 'A', dueDate }).dueDate, dueDate);
+}
+for (const dueDate of ['', '2026-2-03', '2026-02-29', '1900-02-29', '2026-04-31',
+  '2026-13-01', '2026-01-00', '0000-01-01', '10000-01-01',
+  '2026-10-14T00:00:00Z', ' 2026-10-14', 42, true, {}, []]) {
+  assert.throws(() => store.add({ title: 'A', dueDate }), ValidationError);
+  assert.throws(() => store.update(existing.id, { dueDate }), ValidationError);
+}
+
+// 'computes overdue only for open todos strictly before today'
+assert.equal(store.add({ title: 'gestern', dueDate: '2026-10-13' }).overdue, true);
+assert.equal(store.add({ title: 'heute', dueDate: '2026-10-14' }).overdue, false);
+assert.equal(store.add({ title: 'morgen', dueDate: '2026-10-15' }).overdue, false);
+assert.equal(store.update(1, { done: true }).overdue, false);
+assert.equal(store.update(1, { done: false }).overdue, true);
+
+// 'refreshes overdue at UTC midnight on get and list'
+let instant = new Date('2026-10-14T23:59:59.999Z');
+const changingStore = createStore({ now: () => instant });
+changingStore.add({ title: 'A', dueDate: '2026-10-14' });
+assert.equal(changingStore.get(1).overdue, false);
+instant = new Date('2026-10-15T00:00:00.000Z');
+assert.equal(changingStore.get(1).overdue, true);
+assert.equal(changingStore.list()[0].overdue, true);
+
+// 'uses the UTC calendar day for offset instants'
+const offsetStore = createStore({ now: () => new Date('2026-10-15T00:30:00+02:00') });
+assert.equal(offsetStore.add({ title: 'A', dueDate: '2026-10-14' }).overdue, false);
+
+// 'keeps failed updates atomic and does not consume ids for rejected creates'
+assert.throws(() => store.update(existing.id, { title: 'Neu', done: true, dueDate: 'falsch' }), ValidationError);
+assert.deepEqual(store.get(existing.id), before);
+assert.throws(() => store.update(existing.id, { title: 'Neu', done: 'ja' }), ValidationError);
+assert.deepEqual(store.get(existing.id), before);
+```
+
+Bei der letzten Assertion zusätzlich nach einem abgelehnten `add` prüfen, dass die nächste gültige Anlage die erwartete fortlaufende ID erhält. Ohne Termin bleibt `overdue` immer `false`. Fehlende IDs und Löschen ebenfalls weiter prüfen.
