+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createStore, ValidationError } from '../src/store.mjs';
+
+const fixedStore = () => createStore({ now: () => new Date('2026-10-14T12:00:00Z') });
+const invalidDates = [
+  '2026-02-30', '2025-02-29', '1900-02-29', '2026-04-31',
+  '2026-00-01', '2026-13-01', '2026-01-00', '2026-01-32', '0000-01-01',
+  '2026-2-03', '14.10.2026', '2026-10-14T00:00:00Z',
+  ' 2026-10-14', '2026-10-14 ', '', ' ', true, 20261014, [], {},
+];
+
+test('sets, changes, preserves and removes optional due dates', () => {
+  const store = fixedStore();
+  assert.deepEqual(store.add({ title: ' A ' }), {
+    id: 1, title: 'A', done: false, dueDate: null, overdue: false,
+  });
+  assert.equal(store.add({ title: 'No date', dueDate: null }).dueDate, null);
+  const dated = store.add({ title: 'B', dueDate: '2026-10-13' });
+  assert.equal(dated.dueDate, '2026-10-13');
+  assert.equal(dated.overdue, true);
+  assert.equal(store.update(dated.id, { dueDate: '2026-10-14' }).overdue, false);
+  assert.equal(store.update(dated.id, { title: 'C' }).dueDate, '2026-10-14');
+  assert.equal(store.update(dated.id, {}).dueDate, '2026-10-14');
+  assert.equal(store.update(dated.id, { dueDate: null }).dueDate, null);
+  assert.equal(store.get(dated.id).overdue, false);
+});
+
+test('validates real Gregorian dates including century leap years and year bounds', () => {
+  const store = fixedStore();
+  for (const dueDate of ['2024-02-29', '2000-02-29', '0001-01-01', '9999-12-31']) {
+    const todo = store.add({ title: dueDate, dueDate });
+    assert.equal(todo.dueDate, dueDate);
+    assert.equal(store.update(todo.id, { dueDate }).dueDate, dueDate);
+  }
+  for (const dueDate of invalidDates) {
+    const before = store.list();
+    assert.throws(() => store.add({ title: 'Invalid', dueDate }), ValidationError,
+      `POST date ${JSON.stringify(dueDate)}`);
+    assert.deepEqual(store.list(), before);
+  }
+});
+
+test('rejects updates atomically for every invalid patch field', () => {
+  const store = fixedStore();
+  const todo = store.add({ title: 'Original', dueDate: '2026-10-13' });
+  for (const dueDate of invalidDates) {
+    assert.throws(() => store.update(todo.id, { title: 'Changed', done: true, dueDate }),
+      ValidationError, `PATCH date ${JSON.stringify(dueDate)}`);
+    assert.deepEqual(store.get(todo.id), todo);
+  }
+  for (const patch of [
+    { title: 'Changed', dueDate: '2026-10-15', done: 'yes' },
+    { title: ' ', dueDate: '2026-10-15', done: true },
+  ]) {
+    assert.throws(() => store.update(todo.id, patch), ValidationError);
+    assert.deepEqual(store.get(todo.id), todo);
+  }
+});
+
+test('only open todos with dates before today are overdue', () => {
+  const store = fixedStore();
+  const yesterday = store.add({ title: 'Yesterday', dueDate: '2026-10-13' });
+  store.add({ title: 'Today', dueDate: '2026-10-14' });
+  store.add({ title: 'Tomorrow', dueDate: '2026-10-15' });
+  store.add({ title: 'Undated' });
+  assert.deepEqual(store.list().map(todo => todo.overdue), [true, false, false, false]);
+  assert.equal(store.update(yesterday.id, { done: true }).overdue, false);
+  assert.equal(store.update(yesterday.id, { done: false }).overdue, true);
+});
+
+test('derives overdue at UTC midnight and handles clocks with offsets', () => {
+  let instant = '2026-10-14T23:59:59.999Z';
+  const store = createStore({ now: () => new Date(instant) });
+  const before = store.add({ title: 'Midnight', dueDate: '2026-10-14' });
+  assert.equal(before.overdue, false);
+  instant = '2026-10-15T00:00:00Z';
+  assert.equal(store.get(before.id).overdue, true);
+  assert.equal(store.list()[0].overdue, true);
+  assert.equal(before.overdue, false);
+  instant = '2026-10-15T00:30:00+02:00';
+  assert.equal(store.get(before.id).overdue, false);
+});
+
+test('projects fresh responses without exposing mutable stored objects', () => {
+  const store = fixedStore();
+  const added = store.add({ title: 'Original', dueDate: '2026-10-13' });
+  const expected = { ...added };
+  const updated = store.update(added.id, { title: 'Updated' });
+  assert.equal(added.title, 'Original');
+  expected.title = 'Updated';
+  for (const response of [added, updated, store.get(added.id), store.list()[0]]) {
+    response.title = 'Tampered';
+    response.done = true;
+    response.dueDate = null;
+    response.overdue = false;
+    assert.deepEqual(store.get(expected.id), expected);
+  }
+});
+
+test('uses one clock reading per list even when the UTC date changes during iteration', () => {
+  let reads = 0;
+  const store = createStore({ now: () => new Date(
+    reads++ === 0 ? '2026-10-14T23:59:59.999Z' : '2026-10-15T00:00:00Z',
+  ) });
+  store.add({ title: 'A', dueDate: '2026-10-14' });
+  store.add({ title: 'B', dueDate: '2026-10-14' });
+  reads = 0;
+  assert.deepEqual(store.list().map(todo => todo.overdue), [false, false]);
+  assert.equal(reads, 1);
+});
+
+test('preserves missing-todo and removal behavior', () => {
+  const store = fixedStore();
+  assert.equal(store.get(99), undefined);
+  assert.equal(store.update(99, { dueDate: 'invalid' }), undefined);
+  assert.equal(store.remove(99), false);
+  const todo = store.add({ title: 'Remove', dueDate: '2026-10-13' });
+  assert.equal(store.remove(todo.id), true);
+  assert.equal(store.get(todo.id), undefined);
+  assert.deepEqual(store.list(), []);
+});
