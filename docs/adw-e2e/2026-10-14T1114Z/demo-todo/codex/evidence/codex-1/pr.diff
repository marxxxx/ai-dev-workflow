-      li.append(title);
-      list.append(li);
+    const filter = document.querySelector('[data-testid="filter-overdue"]');
+    let latestRequest = 0;
+
+    async function loadTodos() {
+      const request = ++latestRequest;
+      const todos = await (await fetch(filter.checked ? '/todos?overdue=true' : '/todos')).json();
