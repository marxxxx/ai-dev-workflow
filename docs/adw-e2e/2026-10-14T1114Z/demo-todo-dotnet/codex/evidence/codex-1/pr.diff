+using System.Net;
+using System.Text.RegularExpressions;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Microsoft.Extensions.DependencyInjection;
+
+namespace DemoTodo.Tests;
+
+public class TodoPageTests : IDisposable
+{
+    private readonly WebApplicationFactory<Program> _factory;
+    private readonly HttpClient _client;
+    private readonly TodoStore _store;
+
+    public TodoPageTests()
+    {
+        var clock = new ManualTimeProvider(new DateTimeOffset(2026, 10, 14, 12, 0, 0, TimeSpan.Zero));
+        _factory = new WebApplicationFactory<Program>().WithWebHostBuilder(builder =>
+            builder.ConfigureServices(services => services.AddSingleton<TimeProvider>(clock)));
+        _client = _factory.CreateClient();
+        _store = _factory.Services.GetRequiredService<TodoStore>();
+    }
+
+    public void Dispose() => _factory.Dispose();
+
+    [Fact]
+    public async Task DisplaysDatesAndOverdueMarkers()
+    {
+        _store.Add(new NewTodo("Undatiert"));
+        _store.Add(new NewTodo("Gestern", "2026-10-13"));
+        _store.Add(new NewTodo("Heute", "2026-10-14"));
+        _store.Add(new NewTodo("Morgen", "2026-10-15"));
+        var completed = _store.Add(new NewTodo("Erledigt", "2026-10-13"));
+        _store.Update(completed.Id, new TodoPatch(null, true));
+
+        var html = WebUtility.HtmlDecode(await _client.GetStringAsync("/"));
+        var rows = Regex.Matches(html, "<li data-testid=\"todo-item\">(.*?)</li>", RegexOptions.Singleline)
+            .Select(match => match.Value).ToArray();
+        Assert.Equal(5, rows.Length);
+        Assert.DoesNotContain("todo-due-date", rows[0]);
+        Assert.Contains("13.10.2026", rows[1]);
+        Assert.Contains("data-testid=\"todo-overdue\"", rows[1]);
+        Assert.Contains("überfällig", rows[1]);
+        Assert.Contains("14.10.2026", rows[2]);
+        Assert.Contains("15.10.2026", rows[3]);
+        Assert.Contains("13.10.2026", rows[4]);
+        Assert.Contains("✓", rows[4]);
+        foreach (var index in new[] { 0, 2, 3, 4 })
+            Assert.DoesNotContain("todo-overdue", rows[index]);
+        Assert.Equal(4, Regex.Matches(html, "data-testid=\"todo-due-date\"").Count);
+    }
+
+    [Fact]
+    public async Task RendersUncheckedOverdueFilter()
+    {
+        var html = await _client.GetStringAsync("/");
+        var input = Regex.Match(html, "<input[^>]*data-testid=\"overdue-only-filter\"[^>]*>").Value;
+        Assert.NotEmpty(input);
+        Assert.Contains("type=\"checkbox\"", input);
+        Assert.DoesNotContain("checked", input);
+        Assert.Contains("nur überfällige", WebUtility.HtmlDecode(html));
+    }
+
+    [Fact]
+    public async Task SeparatesTitleDateAndOverdueMarker()
+    {
+        _store.Add(new NewTodo("Gestern", "2026-10-13"));
+        var html = await _client.GetStringAsync("/");
+        var row = Regex.Match(html, "<li data-testid=\"todo-item\">(.*?)</li>", RegexOptions.Singleline).Value;
+        var text = WebUtility.HtmlDecode(Regex.Replace(row, "<[^>]*>", ""));
+        Assert.Equal("Gestern 13.10.2026 überfällig", Regex.Replace(text, @"\s+", " ").Trim());
+    }
+
+    [Fact]
+    public async Task EscapesTitlesAndSupportsEmptyList()
+    {
+        var empty = await _client.GetStringAsync("/");
+        Assert.Contains("data-testid=\"todo-list\"", empty);
+        Assert.Contains("data-testid=\"overdue-only-filter\"", empty);
+        Assert.DoesNotContain("data-testid=\"todo-item\"", empty);
+
+        _store.Add(new NewTodo("<script>alert(1)</script>"));
+        var html = await _client.GetStringAsync("/");
+        Assert.Contains("&lt;script&gt;alert(1)&lt;/script&gt;", html);
+        Assert.DoesNotContain("<script>alert(1)</script>", html);
+    }
+}
