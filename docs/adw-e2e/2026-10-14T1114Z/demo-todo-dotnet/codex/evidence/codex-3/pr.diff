+    [Fact]
+    public void ReopeningRestoresOverdueStatus()
+    {
+        var store = new TodoStore(Clock());
+        var todo = store.Add(new NewTodo("A", new DateOnly(2026, 10, 13)));
+        Assert.True(todo.IsOverdue);
+        Assert.False(store.Update(todo.Id, new TodoPatch(null, true))!.IsOverdue);
+        Assert.Empty(store.List(overdue: true));
+        Assert.True(store.Update(todo.Id, new TodoPatch(null, false))!.IsOverdue);
+        Assert.Equal(todo.Id, Assert.Single(store.List(overdue: true)).Id);
+    }
