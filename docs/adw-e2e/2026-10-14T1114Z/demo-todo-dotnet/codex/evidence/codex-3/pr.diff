+using System.Net;
+using System.Net.Http.Json;
+using System.Text.RegularExpressions;
+
+namespace DemoTodo.Tests;
+
+public class TodoPageTests : IDisposable
+{
+    private readonly TodoTestApp _factory = new();
+    private readonly HttpClient _client;
+
+    public TodoPageTests() => _client = _factory.CreateClient();
+
+    public void Dispose()
+    {
+        _client.Dispose();
+        _factory.Dispose();
+    }
+
+    [Fact]
+    public async Task DisplaysDateAndLowercaseOverdueMarker()
+    {
+        await Seed("Milch kaufen", "2026-10-13");
+        var html = await _client.GetStringAsync("/");
+        var item = Item(html);
+
+        Assert.Contains("data-testid=\"todo-title\"", item);
+        var date = Regex.Match(item, "<time\\b[^>]*data-testid=\"todo-due-date\"[^>]*>(.*?)</time>", RegexOptions.Singleline);
+        Assert.True(date.Success);
+        Assert.Contains("datetime=\"2026-10-13\"", date.Value);
+        Assert.Equal("2026-10-13", WebUtility.HtmlDecode(date.Groups[1].Value).Trim());
+        Assert.True(item.IndexOf("data-testid=\"todo-title\"", StringComparison.Ordinal)
+            < item.IndexOf("data-testid=\"todo-due-date\"", StringComparison.Ordinal));
+        var marker = Regex.Match(item, "<span\\b[^>]*data-testid=\"todo-overdue\"[^>]*>(.*?)</span>", RegexOptions.Singleline);
+        Assert.True(marker.Success);
+        Assert.Equal("überfällig", WebUtility.HtmlDecode(marker.Groups[1].Value).Trim());
+        Assert.DoesNotContain("<form", html);
+    }
+
+    [Theory]
+    [InlineData("2026-10-14", false)]
+    [InlineData("2026-10-15", false)]
+    [InlineData("2026-10-13", true)]
+    [InlineData(null, false)]
+    public async Task NonOverdueTodosHaveNoMarker(string? dueDate, bool done)
+    {
+        await Seed("A", dueDate, done);
+        var item = Item(await _client.GetStringAsync("/"));
+        Assert.DoesNotContain("data-testid=\"todo-overdue\"", item);
+        if (dueDate is null)
+            Assert.DoesNotContain("<time", item);
+        else
+        {
+            Assert.Contains("data-testid=\"todo-due-date\"", item);
+            Assert.Contains($"datetime=\"{dueDate}\"", item);
+        }
+        if (done) Assert.Contains("✓", WebUtility.HtmlDecode(item));
+    }
+
+    [Fact]
+    public async Task DisplaysUncheckedOverdueFilter()
+    {
+        await Seed("Title one", "2026-10-13");
+        await Seed("Title two");
+        var html = await _client.GetStringAsync("/");
+        var checkbox = Regex.Match(html, "<input\\b[^>]*data-testid=\"todo-overdue-filter\"[^>]*>");
+        Assert.True(checkbox.Success);
+        Assert.Contains("type=\"checkbox\"", checkbox.Value);
+        Assert.DoesNotContain("checked", checkbox.Value);
+        var id = Regex.Match(checkbox.Value, "\\bid=\"([^\"]+)\"");
+        Assert.True(id.Success);
+        var label = Regex.Match(html, $"<label\\b[^>]*for=\"{Regex.Escape(id.Groups[1].Value)}\"[^>]*>(.*?)</label>", RegexOptions.Singleline);
+        Assert.True(label.Success);
+        Assert.Equal("nur überfällige", WebUtility.HtmlDecode(label.Groups[1].Value).Trim());
+        Assert.Equal(2, Regex.Matches(html, "data-testid=\"todo-item\"").Count);
+        Assert.True(html.IndexOf("Title one", StringComparison.Ordinal) < html.IndexOf("Title two", StringComparison.Ordinal));
+        Assert.DoesNotContain("<form", html);
+    }
+
+    [Fact]
+    public async Task EscapesTodoTitles()
+    {
+        const string title = "<script>alert(1)</script>";
+        await Seed(title, "2026-10-13");
+        var item = Item(await _client.GetStringAsync("/"));
+        Assert.Contains(title, WebUtility.HtmlDecode(item));
+        Assert.DoesNotContain(title, item);
+    }
+
+    [Fact]
+    public async Task SeparatesTitleDateAndMarker()
+    {
+        await Seed("Milch kaufen", "2026-10-13");
+        var item = Item(await _client.GetStringAsync("/"));
+        var text = WebUtility.HtmlDecode(Regex.Replace(item, "<[^>]+>", ""));
+        Assert.Equal("Milch kaufen 2026-10-13 überfällig", Regex.Replace(text, "\\s+", " ").Trim());
+    }
+
+    private async Task Seed(string title, string? dueDate = null, bool done = false)
+    {
+        var response = await _client.PostAsJsonAsync("/todos", new { title, dueDate });
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        if (done)
+        {
+            var todo = (await response.Content.ReadFromJsonAsync<Todo>())!;
+            var changed = await _client.PatchAsJsonAsync($"/todos/{todo.Id}", new { done = true });
+            Assert.Equal(HttpStatusCode.OK, changed.StatusCode);
+        }
+    }
+
+    private static string Item(string html) => Assert.Single(
+        Regex.Matches(html, "<li\\b[^>]*data-testid=\"todo-item\"[^>]*>(.*?)</li>", RegexOptions.Singleline)
+            .Cast<Match>()).Groups[1].Value;
+}
