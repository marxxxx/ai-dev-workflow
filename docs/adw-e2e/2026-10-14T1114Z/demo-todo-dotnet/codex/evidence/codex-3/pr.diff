+    [Fact]
+    public void AddsOptionalDueDates()
+    {
+        var store = new TodoStore(Clock());
+        var undated = store.Add(new NewTodo("A"));
+        var dated = store.Add(new NewTodo("B", new DateOnly(2026, 10, 13)));
+
+        Assert.Null(undated.DueDate);
+        Assert.False(undated.IsOverdue);
+        Assert.Equal(new DateOnly(2026, 10, 13), dated.DueDate);
+        Assert.True(dated.IsOverdue);
+        Assert.Equal(dated, store.Get(dated.Id));
+        Assert.Equal([undated, dated], store.List());
+    }
+
+    [Fact]
+    public void PatchesPreserveReplaceAndClearDates()
+    {
+        var store = new TodoStore(Clock());
+        var todo = store.Add(new NewTodo("A"));
+        var dated = store.Update(todo.Id, new TodoPatch(null, null) { DueDate = new DateOnly(2026, 10, 13) })!;
+        Assert.Equal(new DateOnly(2026, 10, 13), dated.DueDate);
+        Assert.True(dated.IsOverdue);
+        Assert.Equal("A", dated.Title);
+
+        var renamed = store.Update(todo.Id, new TodoPatch("B", null))!;
+        Assert.Equal(new DateOnly(2026, 10, 13), renamed.DueDate);
+        Assert.Equal("B", renamed.Title);
+        var completed = store.Update(todo.Id, new TodoPatch(null, true))!;
+        Assert.Equal(new DateOnly(2026, 10, 13), completed.DueDate);
+        Assert.False(completed.IsOverdue);
+
+        var replaced = store.Update(todo.Id, new TodoPatch(null, false) { DueDate = new DateOnly(2026, 10, 20) })!;
+        Assert.Equal(new DateOnly(2026, 10, 20), replaced.DueDate);
+        Assert.False(replaced.IsOverdue);
+        var cleared = store.Update(todo.Id, new TodoPatch(null, null) { DueDate = null })!;
+        Assert.Null(cleared.DueDate);
+        Assert.False(cleared.IsOverdue);
+        Assert.Equal("B", cleared.Title);
+        Assert.False(cleared.Done);
+        Assert.Equal(cleared, store.Get(todo.Id));
+    }
+
+    [Fact]
+    public void EmptyPatchPreservesWholeTodo()
+    {
+        var store = new TodoStore(Clock());
+        var todo = store.Add(new NewTodo("A", new DateOnly(2026, 10, 13)));
+        Assert.Equal(todo, store.Update(todo.Id, new TodoPatch(null, null)));
+    }
