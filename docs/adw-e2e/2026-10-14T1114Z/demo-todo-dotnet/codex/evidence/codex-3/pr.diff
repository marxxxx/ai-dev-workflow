+    [Fact]
+    public void UsesUtcRatherThanClockOffsetDate()
+    {
+        var clock = new MutableTimeProvider(new DateTimeOffset(2026, 10, 15, 0, 30, 0, TimeSpan.FromHours(2)));
+        var store = new TodoStore(clock);
+        var todo = store.Add(new NewTodo("A", new DateOnly(2026, 10, 14)));
+        Assert.False(todo.IsOverdue);
+        Assert.Empty(store.List(overdue: true));
+    }
+
+    [Fact]
+    public void RecalculatesAcrossUtcMidnightWithoutWrites()
+    {
+        var clock = new MutableTimeProvider(new DateTimeOffset(2026, 10, 14, 23, 59, 59, TimeSpan.Zero));
+        var store = new TodoStore(clock);
+        var todo = store.Add(new NewTodo("A", new DateOnly(2026, 10, 14)));
+        Assert.False(todo.IsOverdue);
+        Assert.Empty(store.List(overdue: true));
+
+        clock.UtcNow = new DateTimeOffset(2026, 10, 15, 0, 0, 0, TimeSpan.Zero);
+        Assert.True(store.Get(todo.Id)!.IsOverdue);
+        Assert.True(Assert.Single(store.List()).IsOverdue);
+        Assert.Equal(todo.Id, Assert.Single(store.List(overdue: true)).Id);
+
+        clock.UtcNow = new DateTimeOffset(2026, 10, 14, 12, 0, 0, TimeSpan.Zero);
+        Assert.False(store.Get(todo.Id)!.IsOverdue);
+        Assert.Empty(store.List(overdue: true));
+    }
+
+    [Fact]
+    public void ListUsesOneUtcSnapshot()
+    {
+        var clock = Clock();
+        var store = new TodoStore(clock);
+        var first = store.Add(new NewTodo("A", new DateOnly(2026, 10, 13)));
+        store.Add(new NewTodo("B", new DateOnly(2026, 10, 14)));
+        var third = store.Add(new NewTodo("C", new DateOnly(2026, 10, 12)));
+        var readsBefore = clock.ReadCount;
+
+        var overdue = store.List(overdue: true);
+
+        Assert.Equal([first.Id, third.Id], overdue.Select(todo => todo.Id));
+        Assert.All(overdue, todo => Assert.True(todo.IsOverdue));
+        Assert.Equal(1, clock.ReadCount - readsBefore);
+        Assert.Equal(3, store.List(overdue: false).Count);
+    }
