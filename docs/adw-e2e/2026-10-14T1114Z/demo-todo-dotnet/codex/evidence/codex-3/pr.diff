+    public void OverdueUsesUtcDate(int? dayOffset, bool done, bool expectedOverdue)
+    {
+        var store = new TodoStore(Clock());
+        DateOnly? date = dayOffset is { } days ? new DateOnly(2026, 10, 14).AddDays(days) : null;
+        var todo = store.Add(new NewTodo("A", date));
