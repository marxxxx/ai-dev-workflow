+using System.Net;
+using System.Text.RegularExpressions;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Microsoft.AspNetCore.TestHost;
+using Microsoft.Extensions.DependencyInjection;
+
+namespace DemoTodo.Tests;
+
+public class TodoPageTests : IDisposable
+{
+    private readonly WebApplicationFactory<Program> _factory;
+    private readonly HttpClient _client;
+
+    public TodoPageTests()
+    {
+        var clock = new TestTimeProvider(DateTimeOffset.Parse("2026-10-14T12:00:00Z"));
+        _factory = new WebApplicationFactory<Program>().WithWebHostBuilder(builder =>
+            builder.ConfigureTestServices(services => services.AddSingleton<TimeProvider>(clock)));
+        _client = _factory.CreateClient();
+    }
+
+    public void Dispose() => _factory.Dispose();
+
+    [Fact]
+    public async Task ShowsDueDatesAndExactOverdueMarker()
+    {
+        var store = _factory.Services.GetRequiredService<TodoStore>();
+        store.Add(new NewTodo("Yesterday", "2026-10-13"));
+        store.Add(new NewTodo("Today", "2026-10-14"));
+        store.Add(new NewTodo("Tomorrow", "2026-10-15"));
+        store.Add(new NewTodo("Undated"));
+        var done = store.Add(new NewTodo("Done", "2026-10-13"));
+        store.Update(done.Id, new TodoPatch(null, true));
+
+        var html = WebUtility.HtmlDecode(await _client.GetStringAsync("/"));
+        var items = Regex.Matches(html, """<li\b[^>]*data-testid="todo-item"[^>]*>.*?</li>""",
+            RegexOptions.Singleline).Select(match => match.Value).ToArray();
+        Assert.Equal(5, items.Length);
+        AssertDate(items[0], "Yesterday", "2026-10-13");
+        AssertDate(items[1], "Today", "2026-10-14");
+        AssertDate(items[2], "Tomorrow", "2026-10-15");
+        Assert.Contains("Undated", items[3]);
+        Assert.DoesNotContain("todo-due-date", items[3]);
+        AssertDate(items[4], "Done", "2026-10-13");
+        Assert.Equal("überfällig", ElementText(items[0], "todo-overdue"));
+        foreach (var item in items.Skip(1)) Assert.DoesNotContain("todo-overdue", item);
+    }
+
+    [Theory]
+    [InlineData(false)]
+    [InlineData(true)]
+    public async Task ShowsAccessibleUncheckedOverdueFilter(bool withTodos)
+    {
+        if (withTodos) _factory.Services.GetRequiredService<TodoStore>().Add(new NewTodo("A"));
+        var html = WebUtility.HtmlDecode(await _client.GetStringAsync("/"));
+        var input = Assert.Single(Regex.Matches(html,
+            """<input\b[^>]*data-testid="overdue-filter"[^>]*>""").Cast<Match>()).Value;
+        Assert.Contains("type=\"checkbox\"", input);
+        Assert.DoesNotMatch(@"\bchecked(?:\s|=|>|/)", input);
+        Assert.DoesNotMatch(@"\bdisabled(?:\s|=|>|/)", input);
+        var id = Regex.Match(input, "\\bid=\"([^\"]+)\"").Groups[1].Value;
+        Assert.NotEmpty(id);
+        var label = Regex.Match(html, "<label\\b[^>]*for=\"" + Regex.Escape(id) + "\"[^>]*>(.*?)</label>",
+            RegexOptions.Singleline);
+        Assert.True(label.Success);
+        Assert.Equal("nur überfällige", label.Groups[1].Value.Trim());
+    }
+
+    private static void AssertDate(string item, string title, string date)
+    {
+        Assert.Contains(title, item);
+        Assert.Equal(date, ElementText(item, "todo-due-date"));
+        Assert.True(item.IndexOf("todo-title", StringComparison.Ordinal) <
+            item.IndexOf("todo-due-date", StringComparison.Ordinal));
+    }
+
+    private static string ElementText(string html, string testId) =>
+        Regex.Match(html, "data-testid=\"" + Regex.Escape(testId) + "\"[^>]*>([^<]*)<")
+            .Groups[1].Value.Trim();
+}
