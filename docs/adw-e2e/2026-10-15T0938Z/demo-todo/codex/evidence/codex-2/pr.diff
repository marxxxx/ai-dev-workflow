 <head><meta charset="utf-8"><title>demo-todo</title></head>
 <body>
   <h1>Todos</h1>
+  <label><input type="checkbox" data-testid="overdue-filter"> nur überfällige</label>
+  <p role="alert" data-testid="todo-error" hidden>Todos konnten nicht geladen werden. Bitte erneut versuchen.</p>
   <ul data-testid="todo-list"></ul>
   <script type="module">
     const list = document.querySelector('[data-testid="todo-list"]');
-    const todos = await (await fetch('/todos')).json();
-    for (const todo of todos) {
-      const li = document.createElement('li');
-      li.dataset.testid = 'todo-item';
-      const title = document.createElement('span');
-      title.dataset.testid = 'todo-title';
-      title.textContent = todo.title + (todo.done ? ' ✓' : '');
-      li.append(title);
-      list.append(li);
+    const filter = document.querySelector('[data-testid="overdue-filter"]');
+    const error = document.querySelector('[data-testid="todo-error"]');
+    let requestId = 0;
+
+    async function loadTodos() {
+      const currentRequest = ++requestId;
+      error.hidden = true;
+      try {
+        const response = await fetch(filter.checked ? '/todos?overdue=true' : '/todos');
+        if (!response.ok) throw new Error('Could not load todos');
+        const todos = await response.json();
+        if (currentRequest !== requestId) return;
+        const items = document.createDocumentFragment();
+        for (const todo of todos) {
+          const li = document.createElement('li');
+          li.dataset.testid = 'todo-item';
+          const title = document.createElement('span');
+          title.dataset.testid = 'todo-title';
+          title.textContent = todo.title + (todo.done ? ' ✓' : '');
+          li.append(title);
+          if (todo.dueDate) {
+            const dueDate = document.createElement('time');
+            dueDate.dataset.testid = 'todo-due-date';
+            dueDate.dateTime = todo.dueDate;
+            dueDate.textContent = todo.dueDate;
+            li.append(' — Fällig: ', dueDate);
+          }
+          if (todo.overdue) {
+            const overdue = document.createElement('strong');
+            overdue.dataset.testid = 'todo-overdue';
+            overdue.textContent = 'überfällig';
+            li.append(' — ', overdue);
+          }
+          items.append(li);
+        }
+        list.replaceChildren(items);
+      } catch {
+        if (currentRequest !== requestId) return;
+        list.replaceChildren();
+        error.hidden = false;
+      }
     }
+
+    filter.addEventListener('change', loadTodos);
+    await loadTodos();
   </script>
 </body>
 </html>
