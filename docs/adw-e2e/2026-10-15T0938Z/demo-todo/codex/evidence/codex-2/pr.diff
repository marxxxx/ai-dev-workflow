diff --git a/test/store.test.mjs b/test/store.test.mjs
new file mode 100644
index 0000000..0ab098c
--- /dev/null
+++ b/test/store.test.mjs
@@ -0,0 +1,56 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createStore, ValidationError } from '../src/store.mjs';
+
+test('stores a date, preserves it on unrelated updates, and allows replacing/removing it', () => {
+  const store = createStore();
+  const todo = store.add({ title: 'A', dueDate: '2028-02-29' });
+  assert.equal(todo.dueDate, '2028-02-29');
+  assert.equal(store.update(todo.id, { title: 'B' }).dueDate, '2028-02-29');
+  assert.equal(store.update(todo.id, { dueDate: '2028-03-01' }).dueDate, '2028-03-01');
+  assert.equal(store.update(todo.id, { dueDate: null }).dueDate, null);
+  assert.equal(store.get(todo.id).dueDate, null);
+  assert.equal(store.add({ title: 'Undated' }).dueDate, null);
+  assert.equal(store.add({ title: 'Explicit null', dueDate: null }).dueDate, null);
+});
+
+for (const dueDate of ['', '2026-2-01', '26-02-01', '2026-02-30', '2025-02-29',
+  '1900-02-29', '2026-04-31', '2026-00-01', '2026-13-01', '2026-01-00',
+  '2026-01-32', '2026-10-15T00:00:00Z', ' 2026-10-15', '2026-10-15\n',
+  20261015, false, {}, []]) {
+  test(`rejects invalid due date ${JSON.stringify(dueDate)} without modifying existing data`, () => {
+    const store = createStore();
+    assert.throws(() => store.add({ title: 'Invalid', dueDate }), ValidationError);
+    assert.deepEqual(store.list(), []);
+    const todo = store.add({ title: 'A', dueDate: '2026-01-01' });
+    assert.throws(() => store.update(todo.id, { title: 'Changed', done: true, dueDate }), ValidationError);
+    const saved = store.get(todo.id);
+    assert.equal(saved.title, 'A');
+    assert.equal(saved.done, false);
+    assert.equal(saved.dueDate, '2026-01-01');
+  });
+}
+
+test('does not change the date or title when another patch field is invalid', () => {
+  const store = createStore();
+  const todo = store.add({ title: 'A', dueDate: '2026-01-01' });
+  assert.throws(() => store.update(todo.id, { title: 'B', done: 'yes', dueDate: null }), ValidationError);
+  assert.equal(store.get(todo.id).title, 'A');
+  assert.equal(store.get(todo.id).dueDate, '2026-01-01');
+});
+
+test('derives overdue strictly from the current UTC day and completion state', (t) => {
+  t.mock.timers.enable({ apis: ['Date'], now: new Date('2026-10-15T23:59:59Z') });
+  const store = createStore();
+  const yesterday = store.add({ title: 'Yesterday', dueDate: '2026-10-14' });
+  const today = store.add({ title: 'Today', dueDate: '2026-10-15' });
+  store.add({ title: 'Future', dueDate: '2026-10-16' });
+  store.add({ title: 'Undated' });
+  assert.deepEqual(store.list().map((todo) => todo.overdue), [true, false, false, false]);
+  assert.equal(store.update(yesterday.id, { done: true }).overdue, false);
+  assert.equal(store.update(yesterday.id, { done: false }).overdue, true);
+  t.mock.timers.setTime(new Date('2026-10-16T00:00:00Z').getTime());
+  assert.equal(store.get(today.id).overdue, true);
+  assert.equal(store.list()[1].overdue, true);
+  assert.equal(store.update(today.id, { dueDate: null }).overdue, false);
+});
