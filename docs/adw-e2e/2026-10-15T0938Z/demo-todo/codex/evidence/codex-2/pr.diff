+function validateDueDate(dueDate) {
+  if (dueDate === null) return;
+  if (typeof dueDate === 'string' && dueDate.length === 10 && /^\d{4}-\d{2}-\d{2}$/.test(dueDate)) {
+    const parsed = new Date(`${dueDate}T00:00:00.000Z`);
+    if (!Number.isNaN(parsed.getTime()) && parsed.toISOString().slice(0, 10) === dueDate) return;
+  }
+  throw new ValidationError('dueDate must be a valid YYYY-MM-DD date or null');
+}
+
+function snapshot(todo, today = new Date().toISOString().slice(0, 10)) {
+  if (!todo) return undefined;
+  return { ...todo, overdue: !todo.done && todo.dueDate !== null && todo.dueDate < today };
+}
+
 export class ValidationError extends Error {}
