diff --git a/test/store.test.mjs b/test/store.test.mjs
new file mode 100644
index 0000000..6562057
--- /dev/null
+++ b/test/store.test.mjs
@@ -0,0 +1,68 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createStore, ValidationError } from '../src/store.mjs';
+
+test('todos without a due date default to null and are never overdue', () => {
+  const store = createStore();
+  assert.deepEqual(store.add({ title: 'A' }), {
+    id: 1, title: 'A', done: false, dueDate: null, overdue: false,
+  });
+  assert.equal(store.add({ title: 'B', dueDate: null }).dueDate, null);
+});
+
+test('due dates can be set, preserved, changed and removed', () => {
+  const store = createStore();
+  assert.equal(store.add({ title: 'A', dueDate: '2026-10-15' }).dueDate, '2026-10-15');
+  assert.equal(store.update(1, { title: 'B' }).dueDate, '2026-10-15');
+  assert.equal(store.update(1, { dueDate: '2026-10-16' }).dueDate, '2026-10-16');
+  assert.equal(store.get(1).dueDate, '2026-10-16');
+  assert.equal(store.update(1, { dueDate: null }).dueDate, null);
+  assert.equal(store.list()[0].dueDate, null);
+});
+
+test('only unfinished todos with a date before today UTC are overdue', (t) => {
+  // Still October 15 in negative UTC offsets: the boundary must use UTC.
+  t.mock.timers.enable({ apis: ['Date'], now: new Date('2026-10-16T00:00:00Z') });
+  const store = createStore();
+  store.add({ title: 'Past', dueDate: '2026-10-15' });
+  store.add({ title: 'Today', dueDate: '2026-10-16' });
+  store.add({ title: 'Future', dueDate: '2026-10-17' });
+  store.add({ title: 'No date' });
+  store.add({ title: 'Completed', dueDate: '2026-10-14' });
+  assert.equal(store.update(5, { done: true }).overdue, false);
+  assert.deepEqual(store.list().map((todo) => todo.overdue), [true, false, false, false, false]);
+  assert.equal(store.update(5, { done: false }).overdue, true);
+  assert.equal(store.get(1).overdue, true);
+});
+
+test('overdue is recalculated at UTC midnight without updating the todo', (t) => {
+  t.mock.timers.enable({ apis: ['Date'], now: new Date('2026-10-15T23:59:59Z') });
+  const store = createStore();
+  assert.equal(store.add({ title: 'A', dueDate: '2026-10-15' }).overdue, false);
+  t.mock.timers.tick(1000);
+  assert.equal(store.get(1).overdue, true);
+  assert.equal(store.list()[0].overdue, true);
+});
+
+test('rejects invalid date formats, types and impossible calendar dates without changing a todo', () => {
+  const store = createStore();
+  const original = store.add({ title: 'Original', dueDate: '2026-10-15' });
+  for (const dueDate of [
+    '', '2026-1-01', '2026-01-1', '15.10.2026', ' 2026-10-15 ',
+    '2026-10-15T00:00:00Z', '2026-02-29', '2026-02-30', '1900-02-29',
+    '2026-04-31', '2026-00-10', '2026-13-01', '2026-10-00', '2026-10-32',
+    20261015, false, [], {},
+  ]) {
+    assert.throws(() => store.add({ title: 'Invalid', dueDate }), ValidationError);
+    assert.throws(() => store.update(1, { title: 'Changed', done: true, dueDate }), ValidationError);
+    assert.deepEqual(store.get(1), original);
+    assert.equal(store.list().length, 1);
+  }
+});
+
+test('accepts leap days only in leap years', () => {
+  const store = createStore();
+  for (const dueDate of ['2024-02-29', '2000-02-29', '2026-12-31']) {
+    assert.equal(store.add({ title: 'Valid', dueDate }).dueDate, dueDate);
+  }
+});
diff --git a/test/ui.test.mjs b/test/ui.test.mjs
new file mode 100644
index 0000000..15d322e
--- /dev/null
+++ b/test/ui.test.mjs
@@ -0,0 +1,65 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { runInNewContext } from 'node:vm';
+
+// Run the actual page script with deferred HTTP responses and a minimal DOM.
+async function createPage() {
+  const html = await readFile(new URL('../public/index.html', import.meta.url), 'utf8');
+  const script = html.match(/<script type="module">([\s\S]*?)<\/script>/)[1];
+  const element = () => ({
+    dataset: {}, children: [],
+    append(...children) { this.children.push(...children); },
+    replaceChildren() { this.children = []; },
+  });
+  const list = element();
+  const filter = {
+    checked: false,
+    addEventListener(event, listener) { this[event] = listener; },
+  };
+  const requests = [];
+  const initialRender = runInNewContext(`(async () => { ${script} })()`, {
+    document: {
+      querySelector(selector) {
+        return { '[data-testid="todo-list"]': list, '[data-testid="overdue-filter"]': filter }[selector];
+      },
+      createElement: element,
+    },
+    fetch: (url) => new Promise((resolve) => {
+      requests.push({ url, respond: (todos) => resolve({ json: async () => todos }) });
+    }),
+  });
+  return { list, filter, requests, initialRender };
+}
+
+const past = { title: 'Past', done: false, dueDate: '2026-10-14', overdue: true };
+const future = { title: 'Future', done: false, dueDate: '2026-10-16', overdue: false };
+const titles = (list) => list.children.map((item) => item.children[0].textContent);
+
+test('a delayed initial response cannot overwrite an active overdue filter', async () => {
+  const page = await createPage();
+  page.filter.checked = true;
+  const filteredRender = page.filter.change();
+  assert.equal(page.requests[1].url, '/todos?overdue=true');
+  page.requests[1].respond([past]);
+  await filteredRender;
+  page.requests[0].respond([past, future]);
+  await page.initialRender;
+  assert.deepEqual(titles(page.list), ['Past']);
+});
+
+test('a delayed filtered response cannot overwrite a later unfiltered selection', async () => {
+  const page = await createPage();
+  page.requests[0].respond([past, future]);
+  await page.initialRender;
+  page.filter.checked = true;
+  const filteredRender = page.filter.change();
+  page.filter.checked = false;
+  const unfilteredRender = page.filter.change();
+  assert.equal(page.requests[2].url, '/todos');
+  page.requests[2].respond([past, future]);
+  await unfilteredRender;
+  page.requests[1].respond([past]);
+  await filteredRender;
+  assert.deepEqual(titles(page.list), ['Past', 'Future']);
+});
