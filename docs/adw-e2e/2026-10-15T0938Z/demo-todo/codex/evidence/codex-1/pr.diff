@@ -0,0 +1,83 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createStore, ValidationError } from '../src/store.mjs';
+
+const clock = () => new Date('2026-10-15T12:00:00Z');
+
+test('undated todos default to null and are never overdue', () => {
+  const store = createStore(clock);
+  assert.deepEqual(store.add({ title: ' A ' }), {
+    id: 1, title: 'A', done: false, dueDate: null, overdue: false,
+  });
+});
+
+test('overdue uses the UTC day and excludes today, future, done and undated todos', () => {
+  const store = createStore(clock);
+  for (const dueDate of ['2026-10-14', '2026-10-15', '2026-10-16', null]) {
+    store.add({ title: 'A', dueDate });
+  }
+  store.add({ title: 'Done', dueDate: '2026-10-14' });
+  store.update(5, { done: true });
+  assert.deepEqual(store.list().map((todo) => todo.overdue), [true, false, false, false, false]);
+  assert.equal(store.update(5, { done: false }).overdue, true);
+});
+
+test('status refreshes at UTC midnight without updating the todo', () => {
+  let now = new Date('2026-10-15T23:59:59.999Z');
+  const store = createStore(() => now);
+  store.add({ title: 'A', dueDate: '2026-10-15' });
+  assert.equal(store.get(1).overdue, false);
+  now = new Date('2026-10-16T00:00:00.000Z');
+  assert.equal(store.get(1).overdue, true);
+  assert.equal(store.list()[0].overdue, true);
+});
+
+test('clock offsets are interpreted in UTC', () => {
+  const store = createStore(() => new Date('2026-10-15T23:30:00-02:00'));
+  assert.equal(store.add({ title: 'A', dueDate: '2026-10-15' }).overdue, true);
+});
+
+test('PATCH preserves omitted dates, replaces dates and removes dates with null', () => {
+  const store = createStore(clock);
+  store.add({ title: 'A', dueDate: '2026-10-14' });
+  assert.equal(store.update(1, { title: 'B' }).dueDate, '2026-10-14');
+  assert.equal(store.update(1, { dueDate: '2026-10-16' }).overdue, false);
+  assert.equal(store.get(1).dueDate, '2026-10-16');
+  assert.equal(store.update(1, { dueDate: null }).dueDate, null);
+  assert.equal(store.get(1).overdue, false);
+});
+
+test('real leap dates are accepted including years below 100', () => {
+  const store = createStore(clock);
+  for (const dueDate of ['2028-02-29', '2000-02-29', '0096-02-29']) {
+    assert.equal(store.add({ title: 'A', dueDate }).dueDate, dueDate);
+  }
+});
+
+const invalidDates = [
+  '2026-02-29', '2026-04-31', '1900-02-29', '2026-00-01', '2026-13-01',
+  '2026-01-00', '2026-01-32', '', ' ', '2026-1-01', '2026-01-1',
+  '2026-10-15T00:00:00Z', ' 2026-10-15', '2026-10-15\n', 42, true, [], {},
+];
+
+for (const dueDate of invalidDates) {
+  test(`rejects invalid dueDate ${JSON.stringify(dueDate)} without changing data`, () => {
+    const store = createStore(clock);
+    assert.throws(() => store.add({ title: 'Invalid', dueDate }), ValidationError);
+    assert.deepEqual(store.list(), []);
+    const before = store.add({ title: 'Original', dueDate: '2026-10-14' });
+    assert.throws(() => store.update(before.id, {
+      title: 'Changed', done: true, dueDate,
+    }), ValidationError);
+    assert.deepEqual(store.get(before.id), before);
+  });
+}
+
+test('invalid done leaves title and dueDate unchanged', () => {
