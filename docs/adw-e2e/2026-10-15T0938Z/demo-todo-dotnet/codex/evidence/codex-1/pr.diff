+        Assert.Single(Regex.Matches(html, "data-testid=\"todo-overdue\""));
+        Assert.Matches("<input[^>]*type=\"checkbox\"[^>]*data-testid=\"overdue-filter\"", html);
+        Assert.Contains("nur überfällige", html);
+    }
 }
