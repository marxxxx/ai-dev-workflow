+using System.Net;
+using System.Text.RegularExpressions;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Microsoft.Extensions.DependencyInjection;
+
+namespace DemoTodo.Tests;
+
+public class TodoPageTests : IDisposable
+{
+    private readonly WebApplicationFactory<Program> _factory = new();
+    private readonly HttpClient _client;
+    private TodoStore Store => _factory.Services.GetRequiredService<TodoStore>();
+
+    public TodoPageTests() => _client = _factory.CreateClient();
+
+    public void Dispose() => _factory.Dispose();
+
+    [Fact]
+    public async Task OffersAnInitiallyUncheckedOverdueFilter()
+    {
+        var html = WebUtility.HtmlDecode(await _client.GetStringAsync("/"));
+        Assert.Contains("nur überfällige", html);
+        var input = Regex.Match(html, "<input[^>]*data-testid=\"overdue-filter\"[^>]*>").Value;
+        Assert.NotEmpty(input);
+        Assert.Contains("type=\"checkbox\"", input);
+        Assert.DoesNotContain("checked", input);
+    }
+
+    [Theory]
+    [InlineData("2000-01-01", false, true)]
+    [InlineData("2000-01-01", true, false)]
+    [InlineData("9999-12-31", false, false)]
+    [InlineData(null, false, false)]
+    public async Task DisplaysDatesAndMarksOnlyOpenOverdueTodos(string? dueDate, bool done, bool overdue)
+    {
+        var todo = Store.Add(new NewTodo("Example", dueDate));
+        Store.Update(todo.Id, new TodoPatch(null, done));
+
+        var html = WebUtility.HtmlDecode(await _client.GetStringAsync("/"));
+        var row = Regex.Match(html, "<li[^>]*data-testid=\"todo-item\"[^>]*>(.*?)</li>", RegexOptions.Singleline).Value;
+        Assert.NotEmpty(row);
+        Assert.Contains(done ? "Example ✓" : "Example", row);
+        if (dueDate is not null)
+        {
+            Assert.Contains("data-testid=\"todo-due-date\"", row);
+            Assert.Contains($"datetime=\"{dueDate}\"", row);
+            Assert.Contains($">{dueDate}</time>", row);
+        }
+        else
+        {
+            Assert.DoesNotContain("data-testid=\"todo-due-date\"", row);
+        }
+
+        if (overdue)
+        {
+            Assert.Contains("data-testid=\"todo-overdue\"", row);
+            Assert.Contains(">überfällig</span>", row);
+        }
+        else
+        {
+            Assert.DoesNotContain("überfällig", row);
+        }
+    }
+
+    [Fact]
+    public async Task ATodoDueTodayInUtcIsNotMarkedOverdue()
+    {
+        var today = DateOnly.FromDateTime(DateTime.UtcNow).ToString("yyyy-MM-dd");
+        Store.Add(new NewTodo("Today", today));
+
+        var html = await _client.GetStringAsync("/");
+        Assert.Contains($"datetime=\"{today}\"", html);
+        Assert.DoesNotContain("data-testid=\"todo-overdue\"", html);
+    }
+}
