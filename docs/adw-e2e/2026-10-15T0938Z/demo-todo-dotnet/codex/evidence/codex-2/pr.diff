@@ -0,0 +1,64 @@
+// Run this function through the Playwright MCP browser_run_code tool against
+// the app started as described in AGENTS.md. No extra test packages required.
+async (page) => {
+    const api = (method, path, data) => page.request.fetch(
+        'http://localhost:3000' + path, { method, data });
+    const check = (condition, message) => {
+        if (!condition) throw new Error(message);
+    };
+    const response = await api('POST', '/todos', {
+        title: 'E2E editor synchronization', dueDate: '2099-01-01'
+    });
+    check(response.status() === 201, 'Could not seed editor test');
+    const todo = await response.json();
+    try {
+        await page.goto('http://localhost:3000/');
+        await page.waitForTimeout(1200); // Allow the Blazor circuit to connect.
+        const row = page.getByTestId('todo-item').filter({
+            has: page.getByTestId('todo-title').filter({
+                hasText: 'E2E editor synchronization'
+            })
+        });
+        const editor = row.getByTestId('todo-edit-due-date');
+        const refresh = async () => {
+            await page.getByTestId('only-overdue').check();
+            await row.waitFor({ state: 'detached' });
+            await page.getByTestId('only-overdue').uncheck();
+            await row.waitFor();
+        };
+        const patchDate = async date => {
+            const result = await api('PATCH', '/todos/' + todo.id, { dueDate: date });
+            check(result.status() === 200, 'Could not update date through API');
+        };
+
+        await patchDate('2099-01-02');
+        await refresh();
+        check(await row.getByTestId('todo-due-date').innerText() === '2099-01-02',
+            'Displayed date did not refresh');
+        check(await editor.inputValue() === '2099-01-02',
+            'Untouched editor still contains stale date after API update');
+
+        await editor.fill('2099-01-03');
+        await patchDate('2099-01-04');
+        await refresh();
+        check(await editor.inputValue() === '2099-01-03',
+            'Refresh discarded an intentional unsaved edit');
+        await row.getByTestId('save-due-date').click();
+        await page.waitForFunction(() => [...document.querySelectorAll(
+            '[data-testid="todo-due-date"]')].some(e => e.textContent === '2099-01-03'));
+        check((await (await api('GET', '/todos/' + todo.id)).json()).dueDate === '2099-01-03',
+            'Intentional edit was not saved');
+
+        await patchDate('2099-01-05');
+        await refresh();
+        check(await editor.inputValue() === '2099-01-05',
+            'Saved editor was not reset to follow later API updates');
+        return { result: 'PASS', checks: [
+            'untouched editor follows API updates',
+            'intentional unsaved edits survive refresh',
+            'saved editor follows later API updates'
+        ] };
+    } finally {
+        await api('DELETE', '/todos/' + todo.id);
+    }
+}
