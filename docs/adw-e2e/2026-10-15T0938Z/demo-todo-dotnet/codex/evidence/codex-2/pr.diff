 @page "/"
 @rendermode InteractiveServer
 @inject TodoStore Store
+@using System.ComponentModel.DataAnnotations
+@using System.Globalization
 
 <PageTitle>Todos</PageTitle>
 
 <h1>Todos</h1>
 
+<form @onsubmit="AddTodo" @onsubmit:preventDefault>
+    <label for="new-todo-title">Titel</label>
+    <input id="new-todo-title" data-testid="new-todo-title" @bind="_newTitle" />
+    <label for="new-todo-due-date">Fälligkeitsdatum (optional)</label>
+    <input id="new-todo-due-date" data-testid="new-todo-due-date" type="date" @bind="_newDueDate" />
+    <button type="submit" data-testid="add-todo">Anlegen</button>
+</form>
+
+@if (_error is not null)
+{
+    <p role="alert" data-testid="todo-error">@_error</p>
+}
+
+<label>
+    <input type="checkbox" data-testid="only-overdue" @bind="_onlyOverdue" />
+    nur überfällige
+</label>
+
 <ul data-testid="todo-list">
-    @foreach (var todo in Store.List())
+    @foreach (var todo in Store.List(_onlyOverdue ? true : null))
     {
-        <li data-testid="todo-item">
+        if (!_editedDueDates.Contains(todo.Id))
+            _dueDates[todo.Id] = todo.DueDate;
+        <li data-testid="todo-item" @key="todo.Id">
             <span data-testid="todo-title">@todo.Title@(todo.Done ? " ✓" : "")</span>
+            @if (todo.DueDate is { } date)
+            {
+                <span data-testid="todo-due-date">@date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</span>
+            }
+            @if (Store.IsOverdue(todo))
+            {
+                <span data-testid="todo-overdue">überfällig</span>
+            }
+            <label for="due-date-@todo.Id">Fälligkeitsdatum</label>
+            <input id="due-date-@todo.Id" data-testid="todo-edit-due-date" type="date"
+                   @bind="_dueDates[todo.Id]" @bind:after="() => DateEdited(todo.Id)" />
+            <button type="button" data-testid="save-due-date" @onclick="() => SaveDueDate(todo.Id)">Speichern</button>
         </li>
     }
 </ul>
+
+@code {
+    private string _newTitle = "";
+    private DateOnly? _newDueDate;
+    private string? _error;
+    private bool _onlyOverdue;
+    private readonly Dictionary<int, DateOnly?> _dueDates = [];
+    private readonly HashSet<int> _editedDueDates = [];
+
+    private void AddTodo()
+    {
+        try
+        {
+            Store.Add(new NewTodo(_newTitle, _newDueDate));
+            _newTitle = "";
+            _newDueDate = null;
+            _error = null;
+        }
+        catch (ValidationException ex)
+        {
+            _error = ex.Message;
+        }
+    }
+
+    private void DateEdited(int id) => _editedDueDates.Add(id);
+
+    private void SaveDueDate(int id)
+    {
+        Store.Update(id, new TodoPatch(null, null) { DueDate = _dueDates[id] });
+        _editedDueDates.Remove(id);
+    }
+}
