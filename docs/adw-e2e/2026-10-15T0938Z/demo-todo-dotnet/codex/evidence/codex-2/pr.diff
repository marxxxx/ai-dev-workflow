+using System.Net;
+using System.Text.RegularExpressions;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Microsoft.Extensions.DependencyInjection;
+
+namespace DemoTodo.Tests;
+
+public class TodoPageTests : IDisposable
+{
+    private readonly WebApplicationFactory<Program> _factory = new WebApplicationFactory<Program>()
+        .WithWebHostBuilder(builder => builder.ConfigureServices(services =>
+            services.AddSingleton<TimeProvider>(new FixedTimeProvider())));
+
+    public void Dispose() => _factory.Dispose();
+
+    [Fact]
+    public async Task RendersDatesBesideTitlesAndMarksOnlyOpenPastDueTodos()
+    {
+        using var client = _factory.CreateClient();
+        var store = _factory.Services.GetRequiredService<TodoStore>();
+        store.Add(new NewTodo("Past", new DateOnly(2026, 10, 14)));
+        store.Add(new NewTodo("Today", new DateOnly(2026, 10, 15)));
+        store.Add(new NewTodo("Future", new DateOnly(2026, 10, 16)));
+        store.Add(new NewTodo("Undated"));
+        var done = store.Add(new NewTodo("Done", new DateOnly(2026, 10, 14)));
+        store.Update(done.Id, new TodoPatch(null, true));
+
+        var html = WebUtility.HtmlDecode(await client.GetStringAsync("/"));
+        var rows = Regex.Matches(html, "<li data-testid=\"todo-item\"[^>]*>(.*?)</li>", RegexOptions.Singleline)
+            .Select(match => match.Groups[1].Value).ToArray();
+        Assert.Equal(5, rows.Length);
+        var expected = new (string Title, string? Date, bool Overdue)[]
+        {
+            ("Past", "2026-10-14", true),
+            ("Today", "2026-10-15", false),
+            ("Future", "2026-10-16", false),
+            ("Undated", null, false),
+            ("Done ✓", "2026-10-14", false)
+        };
+        for (var i = 0; i < expected.Length; i++)
+        {
+            Assert.Contains($"data-testid=\"todo-title\">{expected[i].Title}</span>", rows[i]);
+            if (expected[i].Date is { } date)
+                Assert.Contains($"data-testid=\"todo-due-date\">{date}</span>", rows[i]);
+            else
+                Assert.DoesNotContain("data-testid=\"todo-due-date\"", rows[i]);
+            Assert.Equal(expected[i].Overdue, rows[i].Contains("data-testid=\"todo-overdue\""));
+            if (expected[i].Overdue) Assert.Contains("überfällig", rows[i]);
+        }
+    }
+
+    [Fact]
+    public async Task OffersCreationDateEditingAndOverdueFilterControls()
+    {
+        using var client = _factory.CreateClient();
+        _factory.Services.GetRequiredService<TodoStore>().Add(new NewTodo("A"));
+        var html = WebUtility.HtmlDecode(await client.GetStringAsync("/"));
+        foreach (var testId in new[]
+        {
+            "new-todo-title", "new-todo-due-date", "add-todo", "todo-edit-due-date",
+            "save-due-date", "only-overdue"
+        })
+            Assert.Contains($"data-testid=\"{testId}\"", html);
+        Assert.Contains("nur überfällige", html);
+    }
+
+    private sealed class FixedTimeProvider : TimeProvider
+    {
+        public override DateTimeOffset GetUtcNow() =>
+            new(2026, 10, 15, 0, 0, 0, TimeSpan.Zero);
+    }
+}
diff --git a/tests/DemoTodo.Tests/TodoStoreTests.cs b/tests/DemoTodo.Tests/TodoStoreTests.cs
