@@ -28,4 +28,79 @@ public class TodoStoreTests
         Assert.Equal(todo with { Done = true }, store.Update(todo.Id, new TodoPatch(null, true)));
         Assert.Null(store.Update(42, new TodoPatch("B", null)));
     }
+
+    [Fact]
+    public void AddsAnOptionalCalendarDueDate()
+    {
+        var store = new TodoStore();
+        Assert.Null(store.Add(new NewTodo("Undated")).DueDate);
+        var todo = store.Add(new NewTodo("Dated", new DateOnly(2026, 10, 14)));
+        Assert.Equal(new DateOnly(2026, 10, 14), store.Get(todo.Id)!.DueDate);
+    }
+
+    [Fact]
+    public void PatchesPreserveSetReplaceAndRemoveTheDueDate()
+    {
+        var store = new TodoStore();
+        var todo = store.Add(new NewTodo("A", new DateOnly(2026, 10, 14)));
+        Assert.Equal(new DateOnly(2026, 10, 14),
+            store.Update(todo.Id, new TodoPatch("B", true))!.DueDate);
+        var replaced = store.Update(todo.Id, new TodoPatch(null, null)
+        {
+            DueDate = new DateOnly(2026, 10, 16)
+        })!;
+        Assert.Equal(new Todo(todo.Id, "B", true, new DateOnly(2026, 10, 16)), replaced);
+        var cleared = store.Update(todo.Id, new TodoPatch(null, null) { DueDate = null })!;
+        Assert.Equal(new Todo(todo.Id, "B", true), cleared);
+        Assert.Equal(new DateOnly(2026, 10, 15), store.Update(todo.Id,
+            new TodoPatch(null, null) { DueDate = new DateOnly(2026, 10, 15) })!.DueDate);
+    }
+
+    [Fact]
+    public void FiltersOnlyOpenTodosDueBeforeTodayInUtc()
+    {
+        var store = new TodoStore(new MutableTimeProvider(
+            new DateTimeOffset(2026, 10, 15, 0, 0, 0, TimeSpan.Zero)));
+        var past = store.Add(new NewTodo("Past", new DateOnly(2026, 10, 14)));
+        var today = store.Add(new NewTodo("Today", new DateOnly(2026, 10, 15)));
+        var future = store.Add(new NewTodo("Future", new DateOnly(2026, 10, 16)));
+        var undated = store.Add(new NewTodo("Undated"));
+        var done = store.Add(new NewTodo("Done", new DateOnly(2026, 10, 14)));
+        done = store.Update(done.Id, new TodoPatch(null, true))!;
+
+        Assert.Equal([past], store.List(true));
+        Assert.Equal([today, future, undated, done], store.List(false));
+        Assert.Equal([past, today, future, undated, done], store.List());
+        Assert.True(store.IsOverdue(past));
+        Assert.False(store.IsOverdue(today));
+        Assert.False(store.IsOverdue(future));
+        Assert.False(store.IsOverdue(undated));
+        Assert.False(store.IsOverdue(done));
+
+        var reopened = store.Update(done.Id, new TodoPatch(null, false))!;
+        Assert.Equal([past, reopened], store.List(true));
+    }
+
+    [Fact]
+    public void OverdueChangesAtUtcMidnightRegardlessOfLocalDate()
+    {
+        var clock = new MutableTimeProvider(
+            new DateTimeOffset(2026, 10, 14, 23, 59, 59, TimeSpan.Zero));
+        var store = new TodoStore(clock);
+        var todo = store.Add(new NewTodo("A", new DateOnly(2026, 10, 14)));
+        Assert.False(store.IsOverdue(todo));
+        Assert.Empty(store.List(true));
+
+        clock.UtcNow = new DateTimeOffset(2026, 10, 15, 0, 0, 0, TimeSpan.Zero);
+        Assert.True(store.IsOverdue(todo));
+        Assert.Equal([todo], store.List(true));
+    }
+
+    private sealed class MutableTimeProvider(DateTimeOffset utcNow) : TimeProvider
+    {
+        public DateTimeOffset UtcNow { get; set; } = utcNow;
+        public override DateTimeOffset GetUtcNow() => UtcNow;
+        public override TimeZoneInfo LocalTimeZone => TimeZoneInfo.CreateCustomTimeZone(
+            "Test UTC+14", TimeSpan.FromHours(14), "Test UTC+14", "Test UTC+14");
+    }
 }
