+    [InlineData("\"2026-02-30\"")]
+    [InlineData("\"2025-02-29\"")]
+    [InlineData("\"15.10.2026\"")]
+    [InlineData("\"2026-10-15T00:00:00Z\"")]
+    [InlineData("\"\"")]
+    [InlineData("42")]
+    [InlineData("{}")]
+    public async Task RejectsInvalidDatesWithoutChangingTodos(string jsonDate)
+    {
+        await _client.PostAsJsonAsync("/todos", new { title = "Original", dueDate = "2026-10-14" });
+        var original = new Todo(1, "Original", false, new DateOnly(2026, 10, 14));
+        var body = $$"""{"title":"Changed","dueDate":{{jsonDate}}}""";
+        foreach (var method in new[] { HttpMethod.Post, HttpMethod.Patch })
+        {
+            using var request = new HttpRequestMessage(method, method == HttpMethod.Post ? "/todos" : "/todos/1")
+            {
+                Content = JsonBody(body)
+            };
+            var response = await _client.SendAsync(request);
+            Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+            var error = await response.Content.ReadFromJsonAsync<JsonElement>();
+            Assert.False(string.IsNullOrWhiteSpace(error.GetProperty("error").GetString()));
+            Assert.Equal([original], (await _client.GetFromJsonAsync<Todo[]>("/todos"))!);
+        }
+    }
+
+    [Fact]
+    public async Task FiltersOverdueTodosAndPreservesDefaultListOrder()
+    {
+        await _client.PostAsJsonAsync("/todos", new { title = "Past", dueDate = "2026-10-14" });
+        await _client.PostAsJsonAsync("/todos", new { title = "Today", dueDate = "2026-10-15" });
+        await _client.PostAsJsonAsync("/todos", new { title = "Future", dueDate = "2026-10-16" });
+        await _client.PostAsJsonAsync("/todos", new { title = "Undated" });
+        await _client.PostAsJsonAsync("/todos", new { title = "Done", dueDate = "2026-10-14" });
+        await _client.PatchAsJsonAsync("/todos/5", new { done = true });
+
+        Assert.Equal([1], (await _client.GetFromJsonAsync<Todo[]>("/todos?overdue=true"))!.Select(todo => todo.Id));
+        Assert.Equal([2, 3, 4, 5], (await _client.GetFromJsonAsync<Todo[]>("/todos?overdue=false"))!.Select(todo => todo.Id));
+        Assert.Equal([1, 2, 3, 4, 5], (await _client.GetFromJsonAsync<Todo[]>("/todos"))!.Select(todo => todo.Id));
+        await _client.PatchAsJsonAsync("/todos/5", new { done = false });
+        Assert.Equal([1, 5], (await _client.GetFromJsonAsync<Todo[]>("/todos?overdue=true"))!.Select(todo => todo.Id));
+    }
+
+    [Fact]
+    public async Task RejectsAnInvalidOverdueFilter()
+    {
+        var response = await _client.GetAsync("/todos?overdue=maybe");
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        var error = await response.Content.ReadFromJsonAsync<JsonElement>();
+        Assert.False(string.IsNullOrWhiteSpace(error.GetProperty("error").GetString()));
+    }
+
+    private static StringContent JsonBody(string json) => new(json, null, "application/json");
+
+    private sealed class FixedTimeProvider : TimeProvider
+    {
+        public override DateTimeOffset GetUtcNow() =>
+            new(2026, 10, 15, 0, 0, 0, TimeSpan.Zero);
+    }
 }
