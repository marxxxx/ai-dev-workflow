+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createStore, ValidationError } from '../src/store.mjs';
+
+const fixed = (iso) => () => new Date(iso);
+const noon = () => createStore({ now: fixed('2026-11-13T12:00:00Z') });
+
+test('add without dueDate yields null and not overdue', () => {
+  assert.deepEqual(noon().add({ title: 'A' }), {
+    id: 1, title: 'A', done: false, dueDate: null, overdue: false,
+  });
+});
+
+test('add with past dueDate is overdue', () => {
+  assert.equal(noon().add({ title: 'A', dueDate: '2026-11-12' }).overdue, true);
+});
+
+test('dueDate today or later is not overdue', () => {
+  const store = noon();
+  assert.equal(store.add({ title: 'A', dueDate: '2026-11-13' }).overdue, false);
+  assert.equal(store.add({ title: 'B', dueDate: '2026-11-14' }).overdue, false);
+});
+
+test('today is computed in UTC', () => {
+  const store = createStore({ now: fixed('2026-11-13T23:30:00-05:00') });
+  assert.equal(store.add({ title: 'A', dueDate: '2026-11-13' }).overdue, true);
+});
+
+test('done todos are never overdue, recomputed on read', () => {
+  const store = noon();
+  store.add({ title: 'A', dueDate: '2026-11-01' });
+  assert.equal(store.update(1, { done: true }).overdue, false);
+  assert.equal(store.update(1, { done: false }).overdue, true);
+});
+
+test('overdue is recomputed as time passes', () => {
+  let t = new Date('2026-11-13T12:00:00Z');
+  const store = createStore({ now: () => t });
+  store.add({ title: 'A', dueDate: '2026-11-13' });
+  assert.equal(store.get(1).overdue, false);
+  t = new Date('2026-11-14T00:00:00Z');
+  assert.equal(store.get(1).overdue, true);
+});
+
+test('update sets and clears dueDate', () => {
+  const store = noon();
+  store.add({ title: 'A' });
+  assert.equal(store.update(1, { dueDate: '2026-12-01' }).dueDate, '2026-12-01');
+  assert.equal(store.update(1, { dueDate: null }).dueDate, null);
+});
+
+test('rejects invalid dueDate on add and update', () => {
+  const store = noon();
+  store.add({ title: 'A', dueDate: '2026-12-01' });
+  for (const v of ['2026-02-30', '2026-13-01', '2026-1-5', '20.11.2026', 20261120, true, '']) {
+    assert.throws(() => store.add({ title: 'B', dueDate: v }), ValidationError, String(v));
+    assert.throws(() => store.update(1, { dueDate: v }), ValidationError, String(v));
+  }
+  assert.equal(store.get(1).dueDate, '2026-12-01');
+  assert.equal(store.list().length, 1);
+});
+
+test('invalid dueDate does not partially apply an update', () => {
+  const store = noon();
+  store.add({ title: 'A' });
+  assert.throws(() => store.update(1, { title: 'B', dueDate: 'x' }), ValidationError);
+  assert.equal(store.get(1).title, 'A');
+});
+
+test('rejected add does not consume an id', () => {
+  const store = noon();
+  assert.throws(() => store.add({ title: 'A', dueDate: 'x' }), ValidationError);
+  assert.equal(store.add({ title: 'B' }).id, 1);
+});
+
+test('accepts leap day', () => {
+  assert.equal(noon().add({ title: 'A', dueDate: '2028-02-29' }).dueDate, '2028-02-29');
+});
+
+test('ignores overdue in input', () => {
+  const store = noon();
+  assert.equal(store.add({ title: 'A', overdue: true }).overdue, false);
+  assert.equal(store.update(1, { overdue: true }).overdue, false);
+});
+
+test('list filters by overdue', () => {
+  const store = noon();
+  store.add({ title: 'past', dueDate: '2026-11-01' });
+  store.add({ title: 'future', dueDate: '2026-12-01' });
+  store.add({ title: 'none' });
+  store.add({ title: 'done', dueDate: '2026-11-01' });
+  store.update(4, { done: true });
+  const ids = (todos) => todos.map((t) => t.id);
+  assert.deepEqual(ids(store.list({ overdue: true })), [1]);
+  assert.deepEqual(ids(store.list({ overdue: false })), [2, 3, 4]);
+  assert.deepEqual(ids(store.list()), [1, 2, 3, 4]);
+});
+
+test('returned views do not mutate the store', () => {
+  const store = noon();
+  store.add({ title: 'A' });
+  store.get(1).title = 'X';
+  assert.equal(store.get(1).title, 'A');
+});
