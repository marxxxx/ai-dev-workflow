@@ -0,0 +1,54 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createStore, ValidationError } from '../src/store.mjs';
+
+test('add without dueDate stores null', () => {
+  assert.equal(createStore().add({ title: 'A' }).dueDate, null);
+});
+
+test('add with dueDate stores it', () => {
+  assert.equal(createStore().add({ title: 'A', dueDate: '2026-11-20' }).dueDate, '2026-11-20');
+});
+
+test('rejects invalid dueDates', () => {
+  const store = createStore();
+  for (const dueDate of [
+    '2026-02-30',
+    '2027-02-29',
+    '2026-13-01',
+    '2026-11-13T00:00:00Z',
+    ' 2026-11-20',
+    'morgen',
+    20261120,
+    true,
+  ]) {
+    assert.throws(() => store.add({ title: 'A', dueDate }), ValidationError, String(dueDate));
+  }
+  assert.deepEqual(store.list(), []);
+});
+
+test('accepts leap day', () => {
+  assert.equal(createStore().add({ title: 'A', dueDate: '2028-02-29' }).dueDate, '2028-02-29');
+});
+
+test('update changes and removes dueDate', () => {
+  const store = createStore();
+  const { id } = store.add({ title: 'A' });
