 <head><meta charset="utf-8"><title>demo-todo</title></head>
 <body>
   <h1>Todos</h1>
+  <label><input type="checkbox" data-testid="overdue-filter"> nur überfällige</label>
   <ul data-testid="todo-list"></ul>
   <script type="module">
     const list = document.querySelector('[data-testid="todo-list"]');
-    const todos = await (await fetch('/todos')).json();
-    for (const todo of todos) {
-      const li = document.createElement('li');
-      li.dataset.testid = 'todo-item';
-      const title = document.createElement('span');
-      title.dataset.testid = 'todo-title';
-      title.textContent = todo.title + (todo.done ? ' ✓' : '');
-      li.append(title);
-      list.append(li);
+    const filter = document.querySelector('[data-testid="overdue-filter"]');
+    // The server decides what is overdue; the page only shows its verdict.
+    const [all, overdue] = await Promise.all(
+      ['/todos', '/todos?overdue=true'].map(async (url) => (await fetch(url)).json()),
+    );
+    const overdueIds = new Set(overdue.map((todo) => todo.id));
+
+    // "2026-11-20" -> "20.11.2026", from the text so no timezone can shift the day.
+    const formatDate = (iso) => iso.split('-').reverse().join('.');
+
+    const span = (testid, text) => {
+      const el = document.createElement('span');
+      el.dataset.testid = testid;
+      el.textContent = text;
+      return el;
+    };
+
+    function render(todos) {
+      list.replaceChildren();
+      for (const todo of todos) {
+        const li = document.createElement('li');
+        li.dataset.testid = 'todo-item';
+        li.append(span('todo-title', todo.title + (todo.done ? ' ✓' : '')));
+        if (todo.dueDate) li.append(' ', span('todo-due-date', formatDate(todo.dueDate)));
+        if (overdueIds.has(todo.id)) li.append(' ', span('todo-overdue', 'überfällig'));
+        list.append(li);
+      }
     }
+
+    filter.addEventListener('change', () => render(filter.checked ? overdue : all));
+    render(filter.checked ? overdue : all);
   </script>
 </body>
 </html>
