+test('list filters by overdue')                                      // past / today / future / none / done+past:
+                                                                     //   list({overdue:true}) titles == ['past']
+                                                                     //   list({overdue:false}) == die übrigen 4; list() == alle 5
+test('update sets, keeps and removes dueDate')                       // set '2026-12-01'; patch {title:'B'} keeps it; patch {dueDate:null} → null
+test('update ignores overdue in patch')                              // patch {overdue:true} on undated todo → overdue false
+test('rejects invalid dueDate on add')                               // for v of ['2026-02-30','2026-02-29','2026-2-3','2026-11-13T00:00:00Z',20261113,'']:
+                                                                     //   assert.throws(() => add({title:'A', dueDate:v}), ValidationError)
+test('accepts leap day 2028-02-29')
+test('invalid dueDate on update leaves the todo unchanged')          // patch {title:'Neu', dueDate:'2026-02-30'} throws; get(1) title/dueDate unverändert
