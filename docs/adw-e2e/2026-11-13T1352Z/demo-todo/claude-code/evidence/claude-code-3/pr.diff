+      const el = document.createElement('span');
+      el.dataset.testid = testid;
+      el.textContent = text;
+      return el;
+    };
+
+    function render(todos) {
+      list.replaceChildren();
+      for (const todo of todos) {
+        const li = document.createElement('li');
