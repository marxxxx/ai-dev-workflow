+// dueDate is null or a real calendar date written as YYYY-MM-DD.
+function checkDueDate(value) {
+  if (value === null) return;
+  const valid =
+    typeof value === 'string' &&
+    /^\d{4}-\d{2}-\d{2}$/.test(value) &&
+    !Number.isNaN(Date.parse(`${value}T00:00:00Z`)) &&
+    new Date(`${value}T00:00:00Z`).toISOString().slice(0, 10) === value;
+  if (!valid) throw new ValidationError('dueDate must be null or a valid YYYY-MM-DD date');
+}
