+    assert.equal((await patched.json()).dueDate, null);
+  }));
+
+test('rejects an invalid dueDate', () =>
+  withServer(async (base) => {
+    const res = await fetch(`${base}/todos`, json('POST', { title: 'A', dueDate: '2026-02-30' }));
+    assert.equal(res.status, 400);
+  }));
+
+test('filters overdue todos', () =>
+  withServer(async (base) => {
+    await fetch(`${base}/todos`, json('POST', { title: 'past', dueDate: '2026-11-01' }));
+    await fetch(`${base}/todos`, json('POST', { title: 'future', dueDate: '2026-11-20' }));
+    await fetch(`${base}/todos`, json('POST', { title: 'donePast', dueDate: '2026-11-01' }));
+    await fetch(`${base}/todos/3`, json('PATCH', { done: true }));
+    const titles = async (query) =>
+      (await (await fetch(`${base}/todos${query}`)).json()).map((t) => t.title);
+    assert.deepEqual(await titles('?overdue=true'), ['past']);
+    assert.deepEqual(await titles('?overdue=false'), ['future', 'donePast']);
+  }, createStore({ now: () => new Date('2026-11-13T12:00:00Z') })));
+
+test('rejects an invalid overdue filter', () =>
+  withServer(async (base) => {
+    assert.equal((await fetch(`${base}/todos?overdue=ja`)).status, 400);
+    assert.equal((await fetch(`${base}/todos?overdue=`)).status, 400);
   }));
