@@ -0,0 +1,95 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createStore, ValidationError } from '../src/store.mjs';
+
+// Store with a settable clock; starts shortly before midnight UTC on 2026-11-13.
+function setup() {
+  const clock = { now: new Date('2026-11-13T23:30:00Z') };
+  const store = createStore({ now: () => clock.now });
+  return { store, clock };
+}
+
+test('add without dueDate yields dueDate null, overdue false', () => {
+  const { store } = setup();
+  assert.deepEqual(store.add({ title: 'A' }), {
+    id: 1, title: 'A', done: false, dueDate: null, overdue: false,
+  });
+});
+
+test('past dueDate is overdue', () => {
+  const { store } = setup();
+  assert.equal(store.add({ title: 'A', dueDate: '2026-11-12' }).overdue, true);
+});
+
+test('dueDate today (UTC) is not overdue', () => {
+  const { store } = setup();
+  assert.equal(store.add({ title: 'A', dueDate: '2026-11-13' }).overdue, false);
+});
+
+test('future dueDate is not overdue', () => {
+  const { store } = setup();
+  assert.equal(store.add({ title: 'A', dueDate: '2026-11-14' }).overdue, false);
+});
+
+test('done todo with past dueDate is not overdue', () => {
+  const { store } = setup();
+  store.add({ title: 'A', dueDate: '2026-11-01' });
+  assert.equal(store.update(1, { done: true }).overdue, false);
+});
+
+test('overdue is computed on read', () => {
+  const { store, clock } = setup();
+  store.add({ title: 'A', dueDate: '2026-11-14' });
+  assert.equal(store.get(1).overdue, false);
+  clock.now = new Date('2026-11-15T00:00:01Z');
+  assert.equal(store.get(1).overdue, true);
+});
+
+test('list filters by overdue', () => {
+  const { store } = setup();
+  store.add({ title: 'past', dueDate: '2026-11-01' });
+  store.add({ title: 'today', dueDate: '2026-11-13' });
+  store.add({ title: 'future', dueDate: '2026-11-20' });
+  store.add({ title: 'none' });
+  store.add({ title: 'donePast', dueDate: '2026-11-01' });
+  store.update(5, { done: true });
+  const titles = (opts) => store.list(opts).map((t) => t.title);
+  assert.deepEqual(titles({ overdue: true }), ['past']);
+  assert.deepEqual(titles({ overdue: false }), ['today', 'future', 'none', 'donePast']);
+  assert.deepEqual(titles(), ['past', 'today', 'future', 'none', 'donePast']);
+});
+
+test('update sets, keeps and removes dueDate', () => {
+  const { store } = setup();
+  store.add({ title: 'A' });
+  assert.equal(store.update(1, { dueDate: '2026-12-01' }).dueDate, '2026-12-01');
+  assert.equal(store.update(1, { title: 'B' }).dueDate, '2026-12-01');
+  assert.equal(store.update(1, { dueDate: null }).dueDate, null);
+});
+
+test('update ignores overdue in patch', () => {
+  const { store } = setup();
+  store.add({ title: 'A' });
+  assert.equal(store.update(1, { overdue: true }).overdue, false);
+});
+
+test('rejects invalid dueDate on add', () => {
+  const { store } = setup();
+  for (const dueDate of ['2026-02-30', '2026-02-29', '2026-2-3', '2026-11-13T00:00:00Z', 20261113, '']) {
+    assert.throws(() => store.add({ title: 'A', dueDate }), ValidationError, String(dueDate));
+  }
+  assert.deepEqual(store.list(), []);
+});
+
+test('accepts leap day 2028-02-29', () => {
+  const { store } = setup();
+  assert.equal(store.add({ title: 'A', dueDate: '2028-02-29' }).dueDate, '2028-02-29');
+});
+
+test('invalid dueDate on update leaves the todo unchanged', () => {
+  const { store } = setup();
+  store.add({ title: 'Alt', dueDate: '2026-11-20' });
+  assert.throws(() => store.update(1, { title: 'Neu', dueDate: '2026-02-30' }), ValidationError);
+  assert.equal(store.get(1).title, 'Alt');
+  assert.equal(store.get(1).dueDate, '2026-11-20');
+});
