+namespace DemoTodo.Tests;
+
+// A clock that always reports the same instant (the testing package would be a new NuGet dependency).
+public class FixedTimeProvider(DateTimeOffset now) : TimeProvider
+{
+    // 2026-11-13 late in the UTC day, so "today" is 2026-11-13.
+    public static readonly DateTimeOffset Now = new(2026, 11, 13, 23, 30, 0, TimeSpan.Zero);
+
+    public FixedTimeProvider() : this(Now) { }
+
+    public override DateTimeOffset GetUtcNow() => now;
+}
