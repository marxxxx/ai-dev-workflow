+namespace DemoTodo;
+
+// What the API returns for a todo: the stored fields plus the computed overdue flag.
+public record TodoResponse(int Id, string Title, bool Done, DateOnly? DueDate, bool Overdue)
+{
+    public static TodoResponse From(Todo todo, TodoStore store) =>
+        new(todo.Id, todo.Title, todo.Done, todo.DueDate, store.IsOverdue(todo));
+}
