 @page "/"
 @rendermode InteractiveServer
+@using System.Globalization
 @inject TodoStore Store
+@* Keep the whitespace between title, due date and overdue hint; Blazor strips it by default. *@
+@preservewhitespace true
 
 <PageTitle>Todos</PageTitle>
 
 <h1>Todos</h1>
 
+<label>
+    <input type="checkbox" data-testid="filter-overdue" @bind="_overdueOnly" />
+    nur überfällige
+</label>
+
 <ul data-testid="todo-list">
-    @foreach (var todo in Store.List())
+    @foreach (var todo in Store.List(_overdueOnly))
     {
         <li data-testid="todo-item">
             <span data-testid="todo-title">@todo.Title@(todo.Done ? " ✓" : "")</span>
+            @if (todo.DueDate is { } dueDate)
+            {
+                <span data-testid="todo-due-date">fällig @dueDate.ToString("dd.MM.yyyy", CultureInfo.InvariantCulture)</span>
+            }
+            @if (Store.IsOverdue(todo))
+            {
+                <span data-testid="todo-overdue">überfällig</span>
+            }
         </li>
     }
 </ul>
+
+@code {
+    private bool _overdueOnly;
+}
