+- [ ] **Step 3: Implement in `src/DemoTodo/TodoStore.cs`**
+
+Records/ctors/methods as in Interfaces. `TodoPatch` must stay deserializable by System.Text.Json with
+"absent vs. null" detection — the public parameterless ctor is the one STJ uses:
+
+```csharp
+public class TodoPatch
+{
+    public TodoPatch() { }
+    public TodoPatch(string? title, bool? done) { Title = title; Done = done; }
+
+    public string? Title { get; set; }
+    public bool? Done { get; set; }
+
+    private DateOnly? _dueDate;
+    // The setter only runs when "dueDate" is in the JSON, so null means "clear", absent means "keep".
+    public DateOnly? DueDate { get => _dueDate; set { _dueDate = value; DueDateSpecified = true; } }
+
+    [JsonIgnore] public bool DueDateSpecified { get; private set; }
+}
+```
