diff --git a/tests/DemoTodo.Tests/TodoStoreDueDateTests.cs b/tests/DemoTodo.Tests/TodoStoreDueDateTests.cs
new file mode 100644
index 0000000..e27cc06
--- /dev/null
+++ b/tests/DemoTodo.Tests/TodoStoreDueDateTests.cs
@@ -0,0 +1,79 @@
+using System.ComponentModel.DataAnnotations;
+using System.Globalization;
+using System.Text.Json;
+
+namespace DemoTodo.Tests;
+
+public class TodoStoreDueDateTests
+{
+    private static TodoStore Store() => new(new FixedTime("2026-05-10"));
+
+    private static DueDateField Due(string date) => DueDateField.Of(DateOnly.Parse(date, CultureInfo.InvariantCulture));
+
+    [Fact]
+    public void ATodoGetsAnOptionalDueDate()
+    {
+        var store = Store();
+        Assert.Null(store.Add(new NewTodo("A")).DueDate);
+        Assert.Equal(new DateOnly(2026, 5, 20), store.Add(new NewTodo("B", Due("2026-05-20"))).DueDate);
+    }
+
+    [Fact]
+    public void TheDueDateCanBeChangedKeptAndCleared()
+    {
+        var store = Store();
+        var id = store.Add(new NewTodo("A", Due("2026-05-20"))).Id;
+        Assert.Equal(new DateOnly(2026, 6, 1), store.Update(id, new TodoPatch(null, null, Due("2026-06-01")))!.DueDate);
+        Assert.Equal(new DateOnly(2026, 6, 1), store.Update(id, new TodoPatch(null, true))!.DueDate);
+        Assert.Null(store.Update(id, new TodoPatch(null, null, DueDateField.Of(null)))!.DueDate);
+    }
+
+    [Theory]
+    [InlineData("\"2026-02-30\"")]
+    [InlineData("\"10.05.2026\"")]
+    [InlineData("\"2026-5-1\"")]
+    [InlineData("\"2026-05-10T12:00:00Z\"")]
+    [InlineData("20260510")]
+    [InlineData("true")]
+    public void RejectsMalformedAndImpossibleDueDates(string json)
+    {
+        Assert.Throws<ValidationException>(() => JsonSerializer.Deserialize<NewTodo>($$"""{"title":"A","dueDate":{{json}}}""", JsonSerializerOptions.Web));
+    }
+
+    [Fact]
+    public void ReadsAnAbsentANullAndAValidDueDate()
+    {
+        NewTodo Read(string json) => JsonSerializer.Deserialize<NewTodo>(json, JsonSerializerOptions.Web)!;
+        Assert.Equal(default, Read("""{"title":"A"}""").DueDate);
+        Assert.Equal(DueDateField.Of(null), Read("""{"title":"A","dueDate":null}""").DueDate);
+        Assert.Equal(Due("2026-05-20"), Read("""{"title":"A","dueDate":"2026-05-20"}""").DueDate);
+    }
+
+    [Fact]
+    public void OverdueMeansNotDoneAndDueBeforeTodayInUtc()
+    {
+        var store = Store();
+        store.Add(new NewTodo("late", Due("2026-05-09")));
+        var done = store.Add(new NewTodo("late but done", Due("2026-05-01")));
+        store.Update(done.Id, new TodoPatch(null, true));
+        store.Add(new NewTodo("today", Due("2026-05-10")));
+        store.Add(new NewTodo("no date"));
+        Assert.Equal(["late"], store.List(overdueOnly: true).Select(t => t.Title));
+        Assert.Equal([true, false, false, false], store.List().Select(store.IsOverdue));
+    }
+
+    [Fact]
+    public void TodayIsTheUtcDate()
+    {
+        // 01:30 on 10 May in UTC+2 is still 9 May in UTC: a todo due on 9 May is not overdue yet.
+        var store = new TodoStore(new FixedTime(DateTimeOffset.Parse("2026-05-10T01:30:00+02:00", CultureInfo.InvariantCulture)));
+        Assert.False(store.IsOverdue(store.Add(new NewTodo("A", Due("2026-05-09")))));
+    }
+
+    private sealed class FixedTime(DateTimeOffset now) : TimeProvider
+    {
+        public FixedTime(string today) : this(DateTimeOffset.Parse($"{today}T12:00:00Z", CultureInfo.InvariantCulture)) { }
+
+        public override DateTimeOffset GetUtcNow() => now;
+    }
+}
