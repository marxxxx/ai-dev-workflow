-public record TodoPatch(string? Title, bool? Done);
+public record TodoPatch(string? Title, bool? Done, DueDateField DueDate = default);
+
+// A due date in a request body: absent (IsSet is false), null, or a calendar date yyyy-MM-dd.
+// In a PATCH, an absent field keeps the due date and null removes it.
+[JsonConverter(typeof(Converter))]
+public readonly record struct DueDateField(bool IsSet, DateOnly? Value)
+{
+    public static DueDateField Of(DateOnly? value) => new(true, value);
+
+    public sealed class Converter : JsonConverter<DueDateField>
+    {
+        public override DueDateField Read(ref Utf8JsonReader reader, Type typeToConvert, JsonSerializerOptions options) => reader.TokenType switch
+        {
+            JsonTokenType.Null => Of(null),
+            JsonTokenType.String when DateOnly.TryParseExact(reader.GetString(), "yyyy-MM-dd",
+                CultureInfo.InvariantCulture, DateTimeStyles.None, out var date) => Of(date),
+            _ => throw new ValidationException("dueDate must be a valid date in the form yyyy-MM-dd, or null"),
+        };
+
+        public override void Write(Utf8JsonWriter writer, DueDateField value, JsonSerializerOptions options) =>
+            JsonSerializer.Serialize(writer, value.Value, options);
+    }
+}
 
