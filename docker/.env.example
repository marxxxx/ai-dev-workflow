# Absolute path, including when the Compose file is outside the project.
PROJECT_ROOT=/absolute/path/to/project
# Local build, or published: marxx/ai-dev-workflow:node-latest (pin with :node-<YYYY.MM.DD>)
AGENT_IMAGE=ai-dev-workflow-node
HOST_UID=1000
HOST_GID=1000
# Optional tenant selection for az login --use-device-code --allow-no-subscriptions
AZURE_TENANT_ID=
# Optional Context7 account key; leave empty for unauthenticated service limits.
CONTEXT7_API_KEY=
# Corporate TLS inspection (see README "Corporate TLS inspection").
# Absolute host directory with the company root certificates. Read only by the
# compose.ai-dev.certs.yml overlay, which ai-dev.sh/ai-dev.ps1 add whenever this is set.
AGENT_CA_DIR=
# Outbound proxy. NO_PROXY must keep localhost, or E2E traffic to the app under
# test is routed through the corporate proxy.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,::1
http_proxy=
https_proxy=
no_proxy=localhost,127.0.0.1,::1
