# Absolute path, including when the Compose file is outside the project.
PROJECT_ROOT=/absolute/path/to/project
# Local build, or published: marxx/ai-dev-workflow:node-latest (pin with :node-<YYYY.MM.DD>)
AGENT_IMAGE=ai-dev-workflow-node
HOST_UID=1000
HOST_GID=1000
# Optional tenant selection for az login --use-device-code --allow-no-subscriptions
AZURE_TENANT_ID=
# Optional Context7 account key; leave empty for unauthenticated service limits.
CONTEXT7_API_KEY=
