# syntax=docker/dockerfile:1
# Built by docker/build.mjs; or after the base image: docker build -f docker/Dockerfile.node -t ai-dev-workflow-node docker
ARG BASE_IMAGE=ai-dev-workflow
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    IMAGE_VARIANT=node

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends build-essential g++ make python3; \
    rm -rf /var/lib/apt/lists/*; \
    gcc --version; \
    node /usr/local/lib/agent-runtime/verify-versions.mjs node

WORKDIR /workspace
