# syntax=docker/dockerfile:1
# Build after the base image: docker build -f docker/Dockerfile.node -t ai-dev-workflow-node docker
FROM ai-dev-workflow

ENV DEBIAN_FRONTEND=noninteractive \
    IMAGE_VARIANT=node

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends build-essential g++ make python3; \
    rm -rf /var/lib/apt/lists/*; \
    gcc --version; \
    pnpm --version | grep -Fx '12.3.4'; \
    yarn --version | grep -Fx '1.22.22'; \
    tsc --version | grep -F '7.0.2'; \
    typescript-language-server --version | grep -F '6.0.0'

WORKDIR /workspace
